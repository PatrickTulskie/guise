#!/usr/bin/env bash
# guise — provision a dedicated GitHub identity for coding harnesses.
#
# An identity is either a GitHub App installation (a bot) or a separate
# GitHub account holding a PAT.
#
# Subcommands: setup | doctor | uninstall | clone | use | token | update
#              default | rename | basedir | which | list | warm-cache
#
# Self-contained: the helper binaries, git config template, and commit hook
# are embedded below and written out by `setup`. Targets bash 3.2 (macOS).

set -euo pipefail

SCRIPT_PATH="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

VERSION="0.4.0"

CONFIG_DIR="$HOME/.config/guise"
# The embedded helpers have always read GUISE_CONFIG, and `guise which` now
# answers guise-gh's "whose directory is this?" -- so it has to resolve against
# the same config they do, or the two disagree about which identity is current.
CONFIG_FILE="${GUISE_CONFIG:-$CONFIG_DIR/config}"
OWNED_GITCONFIG="$CONFIG_DIR/gitconfig"
RENDER_DIR="$CONFIG_DIR/git"
HOOKS_DIR="$RENDER_DIR/agent-hooks"
KEYS_DIR="$CONFIG_DIR/keys"
SHELL_HOOK="$CONFIG_DIR/hook.sh"
BIN_DIR="$HOME/.local/bin"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/guise"
DEFAULT_BASEDIR="$HOME/agentic-code"
VAULT="Private"
MARK_START='# >>> guise >>>'
MARK_END='# <<< guise <<<'
GITHUB_API="${GUISE_GITHUB_API:-https://api.github.com}"
HELPERS="guise-token guise-credential guise-gh"

say()  { printf '%s\n' "$*"; }
warn() { printf 'guise: %s\n' "$*" >&2; }
die()  { printf 'guise: error: %s\n' "$*" >&2; exit 1; }

cfg_get()   { git config -f "$CONFIG_FILE" --get "$1" 2>/dev/null; }
cfg_set()   { git config -f "$CONFIG_FILE" "$1" "$2"; }
cfg_unset() { git config -f "$CONFIG_FILE" --unset "$1" 2>/dev/null || true; }

# Remove a secret's source file once the secret is stored somewhere durable.
shred_file() {
  if command -v shred >/dev/null; then
    shred -u "$1"
  else
    rm -f "$1"
    warn "shred not available -- $1 removed with rm (contents may persist on disk)"
  fi
}

# GNU first: BSD stat rejects -c with a usage error and no stdout, while GNU
# stat -f prints filesystem info to stdout *before* failing, so a BSD-first
# fallback would concatenate garbage onto the real answer on Linux.
file_mode() { stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null; }

# Resolve a path for comparison: symlinks followed, "." and ".." folded, and a
# tail that does not exist yet carried along. Comparing paths as typed is what
# lets a root sitting inside a tree look like it sits outside one.
#
# Component by component, resolving after each step rather than resolving a
# prefix and appending the rest. That ordering is the point: ".." has to be
# applied to what the path before it actually resolved to, or a symlink (or a
# missing directory) earlier in the path changes what it means. `cd` + `pwd -P`
# is the portable resolver -- macOS has no GNU `readlink -f`, and `realpath -m`
# is not everywhere either.
canonical_path() { # path -> resolved path
  local rest="$1" out comp real
  case "$rest" in
    /*) out="" ;;
    *)  out="$PWD" ;;
  esac
  while [[ -n "$rest" ]]; do
    rest="${rest#/}"
    comp="${rest%%/*}"
    if [[ "$comp" == "$rest" ]]; then rest=""; else rest="/${rest#*/}"; fi
    case "$comp" in
      ""|.) continue ;;
      # Popping an empty $out leaves it empty, which is "/" -- the same place
      # ".." above the root lands.
      ..)   out="${out%/*}" ;;
      *)    out="$out/$comp" ;;
    esac
    if [[ -d "$out" ]]; then
      real=$(CDPATH= cd "$out" 2>/dev/null && pwd -P) || real=""
      [[ -z "$real" ]] || out="$real"
    fi
  done
  [[ -n "$out" ]] || out="/"
  printf '%s' "$out"
}

# ~-form for values written into git config files
display_path() {
  case "$1" in
    "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;;
    *)         printf '%s' "$1" ;;
  esac
}

# An identity is anything with an account handle: .slug for app identities,
# .login for user ones.
list_identities() {
  [[ -f "$CONFIG_FILE" ]] || return 0
  git config -f "$CONFIG_FILE" --name-only --list 2>/dev/null \
    | sed -n -e 's/^identity\.\(.*\)\.slug$/\1/p' -e 's/^identity\.\(.*\)\.login$/\1/p' \
    | sort -u
}

# Where an identity's clones live. Per-identity first, so a work identity can
# sit under ~/work while a personal one sits under ~/src; `core.basedir` is the
# shared fallback. Always succeeds, and always answers without a trailing
# separator, so callers can append one.
basedir() { # [identity]
  local d=""
  [[ -z "${1:-}" ]] || d=$(cfg_get "identity.$1.basedir" || true)
  [[ -n "$d" ]] || d=$(cfg_get core.basedir || true)
  [[ -n "$d" ]] || d="$DEFAULT_BASEDIR"
  while [[ "$d" != "/" && "$d" == */ ]]; do d="${d%/}"; done
  printf '%s' "$d"
}

# The one directory an identity owns. Basedir "/" is the only case where
# appending needs care.
identity_dir() { # name
  local base; base=$(basedir "$1")
  case "$base" in
    /) printf '/%s' "$1" ;;
    *) printf '%s/%s' "$base" "$1" ;;
  esac
}

# Every workspace root in play: the shared one plus any per-identity override.
# Normalized through basedir(), so the shared root appears once however many
# identities fall back to it.
basedirs() {
  local n
  { basedir; for n in $(list_identities); do printf '\n%s' "$(basedir "$n")"; done; } \
    | sort -u
}

# Which identity commands act on when none is named. Set to the first identity
# provisioned; change it with `guise default <name>`. "default" is only the
# fallback for configs written before this was configurable.
default_identity() { cfg_get core.defaultidentity || printf 'default'; }

identity_exists() {
  cfg_get "identity.$1.slug" >/dev/null 2>&1 || cfg_get "identity.$1.login" >/dev/null 2>&1
}

# The configured default, or -- when it names nothing -- the only identity there
# is. Past that there is nothing to guess, so this fails and the caller says how
# to fix it.
resolve_default() {
  local name count
  name=$(default_identity)
  if ! identity_exists "$name"; then
    count=$(list_identities | wc -l | tr -d ' ')
    [[ "$count" == "1" ]] || return 1
    name=$(list_identities)
  fi
  printf '%s' "$name"
}

# Which identity a path belongs to. Longest match wins: per-identity workspaces
# are allowed to nest, so ~/src for one identity and ~/src/agents for another
# both prefix a path under the latter.
identity_owning() { # absolute path -> identity name
  local name dir best="" bestlen=0
  for name in $(list_identities); do
    dir=$(identity_dir "$name")
    case "$1/" in
      "$dir"/*) if [[ ${#dir} -gt $bestlen ]]; then best="$name"; bestlen=${#dir}; fi ;;
    esac
  done
  [[ -n "$best" ]] || return 1
  printf '%s' "$best"
}

# Standing in an agent directory is a clearer statement of intent than whatever
# the configured default happens to be. `guise which` exposes this, and the
# guise-gh helper asks through it rather than keeping a second copy of the rule.
identity_from_cwd() { identity_owning "$PWD"; }

key_source() { cfg_get "identity.$1.keysource" || printf 'op'; }

# "op" and "op-cache" are the same 1Password item; they differ only in what
# answers a read. op asks the vault every time, op-cache remembers the answer
# in memory for the rest of the login session, so a vault that locks later
# doesn't stall the agent.
op_backed() { [[ "$1" == "op" || "$1" == "op-cache" ]]; }
op_reader() { if [[ "$(key_source "$1")" == "op-cache" ]]; then printf 'op-cache'; else printf 'op'; fi; }

op_read() { # name field -> the field's value on stdout
  local acct item reader
  item=$(cfg_get "identity.$1.opitem") || return 1
  acct=$(cfg_get "identity.$1.opaccount") || acct=""
  reader=$(op_reader "$1")
  command -v "$reader" >/dev/null \
    || die "missing dependency: $reader -- identity '$1' reads its secret from 1Password through it"
  if [[ -z "$acct" ]]; then "$reader" read "$item/$2"
  # op-cache hands a command that opens with a flag straight to op, uncached,
  # so the account has to follow the subcommand there.
  elif [[ "$reader" == "op-cache" ]]; then op-cache read --account "$acct" "$item/$2"
  else op --account "$acct" read "$item/$2"; fi
}

# Commit signing is opt-in, and user identities only: a foo[bot] account has no
# settings page, so nothing can register a signing key against it.
signing_enabled() { [[ "$(cfg_get "identity.$1.signing" || true)" == "ssh" ]]; }
signing_key()     { cfg_get "identity.$1.signingkey" || printf '%s/%s.signing' "$KEYS_DIR" "$1"; }
allowed_signers() { printf '%s/%s.allowed_signers' "$RENDER_DIR" "$1"; }

# "type base64" with the trailing comment dropped -- the form GitHub stores,
# and the only part worth comparing.
pubkey_body() { awk '{print $1" "$2}' "$1"; }

# Public and unauthenticated on purpose: a fine-grained PAT scoped to an org can
# never read the account's own key list, so ask GitHub the way anyone else would.
account_signing_keys() { # login -> "type base64", one per line
  local json
  json=$(curl -sf "${GITHUB_API}/users/$1/ssh_signing_keys") || return 1
  printf '%s' "$json" | jq -r '.[] | .key' | awk '{print $1" "$2}'
}

lower() { printf '%s' "$1" | tr 'A-Z' 'a-z'; }

# "app" is a GitHub App installation (bot), "user" a real GitHub account with a
# PAT. Configs written before user identities existed have no kind: they're apps.
identity_kind() { cfg_get "identity.$1.kind" || printf 'app'; }

secret_field() {
  if [[ "$(identity_kind "$1")" == "user" ]]; then printf 'token'; else printf 'private_key'; fi
}

secret_file() {
  if [[ "$(identity_kind "$1")" == "user" ]]; then cfg_get "identity.$1.tokenfile"
  else cfg_get "identity.$1.keyfile"; fi
}

read_identity_secret() { # name -> PEM (app) or PAT (user) on stdout
  local path
  if [[ "$(key_source "$1")" == "file" ]]; then
    path=$(secret_file "$1") && [[ -f "$path" ]] || return 1
    cat "$path"
  else
    op_read "$1" "$(secret_field "$1")"
  fi
}

# Git identity: bots commit as <slug>[bot], user accounts as themselves. Both
# use GitHub's noreply address so commits link to the account without leaking
# a real mailbox.
git_name() { # name
  if [[ "$(identity_kind "$1")" == "user" ]]; then cfg_get "identity.$1.login"
  else printf '%s[bot]' "$(cfg_get "identity.$1.slug")"; fi
}

git_email() { # name
  if [[ "$(identity_kind "$1")" == "user" ]]; then
    printf '%s+%s@users.noreply.github.com' \
      "$(cfg_get "identity.$1.userid")" "$(cfg_get "identity.$1.login")"
  else
    printf '%s+%s[bot]@users.noreply.github.com' \
      "$(cfg_get "identity.$1.botuserid")" "$(cfg_get "identity.$1.slug")"
  fi
}

find_identity_by_appid() { # app_id -> identity name
  local n
  for n in $(list_identities); do
    if [[ "$(cfg_get "identity.$n.appid")" == "$1" ]]; then printf '%s' "$n"; return 0; fi
  done
  return 1
}

find_identity_by_login() { # login -> identity name
  local n
  for n in $(list_identities); do
    if [[ "$(lower "$(cfg_get "identity.$n.login")")" == "$(lower "$1")" ]]; then
      printf '%s' "$n"; return 0
    fi
  done
  return 1
}

ask() { # varname "prompt" [default]
  local _var="$1" _prompt="$2" _def="${3:-}" _val=""
  if [[ -t 0 ]]; then
    if [[ -n "$_def" ]]; then
      read -r -p "$_prompt [$_def]: " _val
      _val="${_val:-$_def}"
    else
      read -r -p "$_prompt: " _val
    fi
  else
    _val="$_def"
  fi
  [[ -n "$_val" ]] || die "missing required value: $_prompt (pass it as a flag; run 'guise help')"
  eval "$_var=\"\$_val\""
}

# Like ask(), but never echoes and never takes a default -- secrets must not
# reach argv (and therefore ps) or shell history.
ask_secret() { # varname "prompt"
  local _var="$1" _val=""
  [[ -t 0 ]] || die "$2: no value available non-interactively (pass it as a file)"
  read -r -s -p "$2: " _val
  printf '\n' >&2
  [[ -n "$_val" ]] || die "missing required value: $2"
  eval "$_var=\"\$_val\""
}

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

# ---------------------------------------------------------------------------
# Embedded artifacts. `setup` writes these out; keep them dependency-light.
# ---------------------------------------------------------------------------

write_helper_token() {
  cat <<'EOF'
#!/usr/bin/env bash
# Print a GitHub credential for a named identity:
#   app identities  -- mint (and cache) an installation access token
#   user identities -- print the stored personal access token
# Usage: guise-token [identity]   (default: $GUISE_IDENTITY or "default")
set -euo pipefail

CONFIG="${GUISE_CONFIG:-$HOME/.config/guise/config}"
IDENTITY="${1:-${GUISE_IDENTITY:-}}"

die() { printf 'guise-token: %s\n' "$*" >&2; exit 1; }

[[ -f "$CONFIG" ]] || die "no config at $CONFIG -- run 'guise setup' first"

# The other helpers pass through whatever they were given (often nothing), so
# resolving the configured default happens here, once.
if [[ -z "$IDENTITY" ]]; then
  IDENTITY=$(git config -f "$CONFIG" --get core.defaultidentity 2>/dev/null || true)
  [[ -n "$IDENTITY" ]] || IDENTITY="default"
fi

cfg() { git config -f "$CONFIG" --get "identity.$IDENTITY.$1" 2>/dev/null; }

KIND=$(cfg kind) || KIND="app"

# Key source is per-identity config: "file" reads a local secret (no 1Password
# involved, suits unattended runs), "op-cache" reads 1Password through op-cache
# (from memory after the first read of the login session), anything else reads
# 1Password through op.
KEY_SOURCE=$(cfg keysource) || KEY_SOURCE="op"
read_secret() { # <1password field> <config key holding the file path>
  local field="$1" path item account reader="op"
  if [[ "$KEY_SOURCE" == "file" ]]; then
    path=$(cfg "$2") && [[ -f "$path" ]] \
      || die "secret file missing for identity '$IDENTITY' -- re-run 'guise setup'"
    cat "$path"
  else
    item=$(cfg opitem) \
      || die "no 1Password item in config for '$IDENTITY' -- re-run 'guise setup'"
    account=$(cfg opaccount) || account=""
    [[ "$KEY_SOURCE" != "op-cache" ]] || reader="op-cache"
    command -v "$reader" >/dev/null \
      || die "$reader not found -- identity '$IDENTITY' reads its secret through it"
    if [[ -z "$account" ]]; then "$reader" read "$item/$field"
    # op-cache passes a command that opens with a flag to op uncached, so the
    # account goes after the subcommand there.
    elif [[ "$reader" == "op-cache" ]]; then op-cache read --account "$account" "$item/$field"
    else op --account "$account" read "$item/$field"; fi
  fi
}

# A PAT is a standing credential: there is nothing to mint, and caching it
# would only put a second copy of it on disk.
if [[ "$KIND" == "user" ]]; then
  read_secret token tokenfile
  exit 0
fi

APP_ID=$(cfg appid) \
  || die "identity '$IDENTITY' not in config -- run 'guise setup --name $IDENTITY'"
INSTALL_ID=$(cfg installationid) \
  || die "identity '$IDENTITY' has no installation id -- re-run 'guise setup'"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/guise"
mkdir -p "$CACHE_DIR"; chmod 700 "$CACHE_DIR"
TOKEN_FILE="$CACHE_DIR/$IDENTITY.token.json"

# Expiry is self-computed at mint time; BSD and GNU date disagree on parsing
# GitHub's ISO-8601 expires_at, so we never parse it.
if [[ -f "$TOKEN_FILE" ]]; then
  cached_exp=$(jq -r '.expires_unix // 0' "$TOKEN_FILE")
  if (( cached_exp - $(date +%s) > 300 )); then
    jq -r '.token' "$TOKEN_FILE"
    exit 0
  fi
fi

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
read_key() { read_secret private_key keyfile; }

# Token acquisition lives in this one function so an alternate source
# (e.g. a remote token service) is a single-body swap.
mint_token() {
  local now header payload signature jwt
  now=$(date +%s)
  header=$(printf '{"typ":"JWT","alg":"RS256"}' | b64url)
  # iat backdated 60s for clock skew; GitHub rejects exp > 10 min out
  payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$((now - 60))" "$((now + 540))" "$APP_ID" | b64url)

  # PEM reaches openssl via process substitution -- never leaves its store.
  signature=$(printf '%s.%s' "$header" "$payload" \
    | openssl dgst -sha256 -sign <(read_key) -binary \
    | b64url)
  jwt="${header}.${payload}.${signature}"

  curl -sf -X POST \
    -H "Authorization: Bearer ${jwt}" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "${GUISE_GITHUB_API:-https://api.github.com}/app/installations/${INSTALL_ID}/access_tokens" \
    || die "failed to mint installation token -- key unreadable (1Password locked / file gone), stale ids, or app uninstalled"
}

mint_unix=$(date +%s)
response=$(mint_token)

# Tokens are valid 1h; treat as 55m to stay clear of the boundary.
printf '%s' "$response" \
  | jq --argjson exp "$((mint_unix + 3300))" '. + {expires_unix: $exp}' \
  > "$TOKEN_FILE"
chmod 600 "$TOKEN_FILE"

jq -r '.token' "$TOKEN_FILE"
EOF
}

write_helper_credential() {
  cat <<'EOF'
#!/usr/bin/env bash
# Git credential helper. Invoked from agent-scoped git config as:
#   guise-credential <identity> <get|store|erase>
# Must drain stdin in all cases or git may block on the write side.
set -euo pipefail

IDENTITY=""
if [[ $# -ge 2 ]]; then IDENTITY="$1"; shift; fi

case "${1:-}" in
  get)
    cat >/dev/null
    echo "username=x-access-token"
    echo "password=$("$(cd "$(dirname "$0")" && pwd)/guise-token" "$IDENTITY")"
    ;;
  *)
    # store/erase: tokens are ephemeral, nothing to persist. Exit clean.
    cat >/dev/null
    exit 0
    ;;
esac
EOF
}

write_helper_gh() {
  cat <<'EOF'
#!/usr/bin/env bash
# Run `gh` as the agent bot. Identity is inferred from the current directory,
# overridable with GUISE_IDENTITY.
# gh prefers GH_TOKEN over its stored credentials, so this is sufficient.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"

# `guise which` owns the directory-to-identity rule. Asking it keeps one copy
# of a rule that has to account for per-identity workspace directories; a
# second copy here is how the two drift apart. Failure means the current
# directory belongs to no identity, which is not an error: empty is fine, and
# guise-token resolves the configured default.
IDENTITY="${GUISE_IDENTITY:-$("$HERE/guise" which 2>/dev/null || true)}"

# A separate assignment, so a guise-token failure stops here. As a prefix on the
# exec its status is discarded, and gh treats an empty GH_TOKEN as unset and
# runs as whoever is logged in.
TOKEN="$("$HERE/guise-token" "$IDENTITY")"
[[ -n "$TOKEN" ]] || { echo "guise-gh: guise-token returned no token -- refusing to run gh as the logged-in user" >&2; exit 1; }

GH_TOKEN="$TOKEN" exec gh "$@"
EOF
}

# Sourced into an interactive zsh/bash by a marked line in the shell rc. Only
# `use` needs it: changing the caller's directory is something no child process
# can do, so `use --emit-shell` prints the cd and this runs it. Everything else
# falls through untouched, which is what keeps a broken hook from taking the
# whole tool down with it.
write_shell_hook() {
  cat <<'EOF'
# guise shell integration -- written by `guise setup`, do not edit.
# Rewritten by `guise update`; edits here are lost.

guise() {
  if [ "${1:-}" = use ]; then
    shift
    local __guise_cd
    __guise_cd=$(command guise use --emit-shell "$@") || return $?
    eval "$__guise_cd"
  else
    command guise "$@"
  fi
}
EOF
}

write_hook() {
  cat <<'EOF'
#!/usr/bin/env bash
# Credit the human as co-author on every commit the agent authors, in place of
# the one a harness stamps for itself.
#
# prepare-commit-msg (not commit-msg) so `git commit -m` is covered.
# The trailer survives rebase merge and is parsed natively by GitHub,
# so the human keeps contribution credit for agent-authored commits.
set -euo pipefail

MSG_FILE="$1"
COMMIT_SOURCE="${2:-}"

# Skip merges and squashes -- trailers there are noise.
[[ "$COMMIT_SOURCE" == "merge" || "$COMMIT_SOURCE" == "squash" ]] && exit 0

# The identity's own address, which is also what a commit it authored carries.
# Unset outside a repo, and git config exits 1 there, so absence is legitimate.
SELF_EMAIL=$(git config --get user.email 2>/dev/null || true)

# A replay is someone else's commit passing through -- cherry-pick, revert, a
# rebase, or an explicit --author. The identity is only the committer, so the
# human co-authored nothing, and the message already carries whatever credit
# the original commit was due.
GIT_DIR_PATH=$(git rev-parse --git-dir 2>/dev/null || true)
if [[ -n "$GIT_DIR_PATH" ]]; then
  for marker in CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
    if [[ -e "$GIT_DIR_PATH/$marker" ]]; then exit 0; fi
  done
fi
# A clean revert never stops the sequencer, so REVERT_HEAD is gone again by the
# time the message is prepared -- the marker above only catches a revert that
# conflicted. What survives either way is the line git generates, which carries
# no translation, so it reads the same in every locale.
if grep -qE '^This reverts commit [0-9a-f]{7,}\.$' "$MSG_FILE"; then exit 0; fi
# Cherry-pick leaves GIT_AUTHOR_EMAIL unset, so this catches --author, not that.
if [[ -n "${GIT_AUTHOR_EMAIL:-}" && -n "$SELF_EMAIL" \
      && "$GIT_AUTHOR_EMAIL" != "$SELF_EMAIL" ]]; then
  exit 0
fi

CONFIG="${GUISE_CONFIG:-$HOME/.config/guise/config}"
CO_AUTHOR="${GUISE_CO_AUTHOR:-}"
if [[ -z "$CO_AUTHOR" && -f "$CONFIG" ]]; then
  CO_AUTHOR=$(git config -f "$CONFIG" --get core.coauthor 2>/dev/null || true)
fi
if [[ -z "$CO_AUTHOR" ]]; then
  # git config exits 1 when a key is unset, and under set -e that would take
  # the whole hook down and abort a commit that was otherwise fine.
  name=$(git config --global user.name || true)
  email=$(git config --global user.email || true)
  [[ -z "$name" || -z "$email" ]] || CO_AUTHOR="$name <$email>"
fi

# No one to credit: leave the message alone rather than failing the commit.
[[ -n "$CO_AUTHOR" ]] || exit 0

# Harnesses stamp a co-author of their own (Claude, Cursor). The commit is
# already authored by the agent identity, so that credit is redundant -- and
# interpret-trailers matches on the token alone, so any of them would make it
# skip the human's. Clear those out by hand, by address: --if-exists replace
# compares the token case-sensitively and so walks straight past
# 'Co-Authored-By:', which is how both of them spell it.
#
# By address and not by token, because a co-author who is neither a harness nor
# the identity is the real thing -- on a reimplemented contribution the trailer
# is the only credit its author gets. The human's own goes on the list too, so
# whatever spelling it arrived in is replaced by the canonical one below.
# Space-separated, since BSD awk rejects a newline inside a -v value.
HUMAN_ADDR="${CO_AUTHOR##*<}"
DROP_ADDRS="noreply@anthropic.com cursoragent@cursor.com ${SELF_EMAIL} ${HUMAN_ADDR%>}"

STRIPPED="$MSG_FILE.guise"
awk -v drop="$DROP_ADDRS" '
  BEGIN {
    n = split(drop, a, " ")
    for (i = 1; i <= n; i++) if (a[i] != "") mine[tolower(a[i])] = 1
  }
  tolower($0) ~ /^co-authored-by:/ {
    addr = $0
    sub(/^[^<]*</, "", addr)
    sub(/>.*/, "", addr)
    if (tolower(addr) in mine) next
  }
  { print }
' "$MSG_FILE" > "$STRIPPED" || true
if [[ -s "$STRIPPED" ]]; then
  mv "$STRIPPED" "$MSG_FILE"
else
  # Unreadable, or nothing but trailers. Neither is worth losing a message over.
  rm -f "$STRIPPED"
fi

git interpret-trailers --if-exists addIfDifferent \
  --trailer "Co-authored-by: ${CO_AUTHOR}" \
  --in-place "$MSG_FILE"
EOF
}

agent_conf_template() {
  cat <<'EOF'
# Generated by guise -- do not hand-edit; re-run `guise setup` instead.

[user]
	name = {{GIT_NAME}}
	email = {{GIT_EMAIL}}{{SIGNINGKEY}}

{{SIGNING}}

[credential "https://github.com"]
	# Empty value CLEARS inherited helpers (osxkeychain), otherwise the
	# human's cached credentials win and commits push as the human.
	helper =
	helper = {{BIN_DIR}}/guise-credential {{NAME}}

[core]
	hooksPath = {{HOOKS_DIR}}

[url "https://github.com/"]
	# ssh would authenticate as the human's key; force https so the
	# credential helper (and therefore the bot identity) always wins.
	insteadOf = git@github.com:
EOF
}

# Stated rather than inherited: the identity has no signing key, and the human's
# global config almost certainly sets gpgsign true.
signing_off_block() {
  cat <<'EOF'
[commit]
	gpgsign = false

[tag]
	gpgsign = false
EOF
}

signing_on_block() { # <allowed signers path>
  cat <<EOF
[commit]
	gpgsign = true

[tag]
	gpgsign = true

[gpg]
	format = ssh

[gpg "ssh"]
	# Lets 'git log --show-signature' verify locally. GitHub verifies against
	# its own copy of the public key, registered on the agent account.
	allowedSignersFile = $1
	# Stated rather than inherited: a global signer such as 1Password's
	# op-ssh-sign cannot use a key file on disk, and fails every commit here.
	program = ssh-keygen
EOF
}

# ---------------------------------------------------------------------------
# Rendering + ~/.gitconfig wiring
# ---------------------------------------------------------------------------

install_binaries() {
  mkdir -p "$BIN_DIR"
  write_helper_token      > "$BIN_DIR/guise-token"
  write_helper_credential > "$BIN_DIR/guise-credential"
  write_helper_gh         > "$BIN_DIR/guise-gh"
  chmod 755 "$BIN_DIR/guise-token" "$BIN_DIR/guise-credential" "$BIN_DIR/guise-gh"
  if [[ "$SCRIPT_PATH" != "$BIN_DIR/guise" ]]; then
    cp "$SCRIPT_PATH" "$BIN_DIR/guise"
    chmod 755 "$BIN_DIR/guise"
  fi
  case ":$PATH:" in
    *":$BIN_DIR:"*) ;;
    *) warn "$BIN_DIR is not on your PATH -- add it to your shell profile" ;;
  esac
}

install_hook() {
  mkdir -p "$HOOKS_DIR"
  write_hook > "$HOOKS_DIR/prepare-commit-msg"
  chmod 755 "$HOOKS_DIR/prepare-commit-msg"
}

# The rc an interactive shell of this kind actually reads. macOS terminals start
# bash as a login shell, which reads .bash_profile and never .bashrc.
shell_rc() {
  case "${SHELL##*/}" in
    zsh)  printf '%s/.zshrc' "${ZDOTDIR:-$HOME}" ;;
    bash) if [[ "$(uname -s)" == Darwin ]]; then printf '%s/.bash_profile' "$HOME"
          else printf '%s/.bashrc' "$HOME"; fi ;;
    *)    return 1 ;;
  esac
}

# Guarded so that a config dir removed by hand leaves a dead line, not a shell
# that errors on every prompt.
shell_block() {
  local rel="${SHELL_HOOK#"$HOME"/}"
  printf '%s\n[ -f "$HOME/%s" ] && . "$HOME/%s"\n%s' \
    "$MARK_START" "$rel" "$rel" "$MARK_END"
}

install_shell_hook() {
  local rc
  mkdir -p "$CONFIG_DIR"
  write_shell_hook > "$SHELL_HOOK"
  chmod 644 "$SHELL_HOOK"
  if ! rc=$(shell_rc); then
    warn "unrecognized shell '${SHELL:-none}' -- source $(display_path "$SHELL_HOOK") from your shell rc to get 'guise use'"
    return 0
  fi
  # ensure_marked_block is a no-op when the line is already there and current,
  # so re-running setup never stacks up copies.
  ensure_marked_block "$rc" "$(shell_block)"
}

# Uninstall can run under a different shell than setup did, so clear every rc
# the block could have landed in rather than only this shell's.
remove_shell_hook() {
  local rc
  for rc in "${ZDOTDIR:-$HOME}/.zshrc" "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile"; do
    remove_marked_block "$rc"
  done
}

# Harness instructions at the top of the agent workspace. Claude Code (and
# other harnesses that stack context files up the directory tree) pick these
# up for every repo underneath. Never overwrites user edits.
install_agent_docs() { # basedir
  local base="$1"
  if [[ ! -e "$base/AGENTS.md" ]]; then
    cat > "$base/AGENTS.md" <<'EOF'
# Agent workspace

Repos under this directory use a dedicated GitHub identity (a GitHub App bot
or a separate account), wired up by `guise`. Commits here are authored by
that identity automatically.

- Use `guise-gh` instead of `gh` for every GitHub CLI operation (PRs, issues,
  API calls). Plain `gh` acts as the human's account.
- Clone with `guise clone <owner/repo>` or an https URL; never ssh remotes
  (ssh authenticates as the human).
- Do not change git identity settings (user.name, user.email, credential
  helpers, signing) -- the directory-scoped config handles all of that.
EOF
  fi
  if [[ ! -e "$base/CLAUDE.md" ]]; then
    printf '@AGENTS.md\n' > "$base/CLAUDE.md"
  fi
}

render_identity_conf() { # name
  local name="$1" tmpl signing signingkey="" key
  case "$(identity_kind "$name")" in
    user)
      cfg_get "identity.$name.login"  >/dev/null || die "identity '$name' missing login"
      cfg_get "identity.$name.userid" >/dev/null || die "identity '$name' missing user id"
      ;;
    *)
      cfg_get "identity.$name.slug"      >/dev/null || die "identity '$name' missing slug"
      cfg_get "identity.$name.botuserid" >/dev/null || die "identity '$name' missing botuserid"
      ;;
  esac
  mkdir -p "$RENDER_DIR"
  if signing_enabled "$name"; then
    key=$(signing_key "$name")
    [[ -f "$key" && -f "$key.pub" ]] \
      || die "identity '$name' signs commits but its key is gone from $key -- re-run 'guise setup --sign'"
    signing=$(signing_on_block "$(allowed_signers "$name")")
    signingkey=$(printf '\n\tsigningkey = %s' "$key")
    # namespaces="git" stops this key vouching for anything but commits and
    # tags, which is all it is ever asked to sign.
    printf '%s namespaces="git" %s\n' "$(git_email "$name")" "$(pubkey_body "$key.pub")" \
      > "$(allowed_signers "$name")"
  else
    signing=$(signing_off_block)
    rm -f "$(allowed_signers "$name")"
  fi
  tmpl=$(agent_conf_template)
  tmpl=${tmpl//"{{GIT_NAME}}"/$(git_name "$name")}
  tmpl=${tmpl//"{{GIT_EMAIL}}"/$(git_email "$name")}
  tmpl=${tmpl//"{{SIGNINGKEY}}"/$signingkey}
  tmpl=${tmpl//"{{SIGNING}}"/$signing}
  tmpl=${tmpl//"{{NAME}}"/$name}
  tmpl=${tmpl//"{{BIN_DIR}}"/$BIN_DIR}
  tmpl=${tmpl//"{{HOOKS_DIR}}"/$HOOKS_DIR}
  printf '%s\n' "$tmpl" > "$RENDER_DIR/$name.conf"
}

# Regenerate the file we own: one includeIf block per identity. ~/.gitconfig
# itself only ever holds a single [include] pointing here.
regen_owned_gitconfig() {
  local name
  {
    echo "# Generated by guise -- do not hand-edit; re-run 'guise setup' instead."
    for name in $(list_identities); do
      echo
      echo "[includeIf \"gitdir:$(display_path "$(identity_dir "$name")/")\"]"
      printf '\tpath = git/%s.conf\n' "$name"
    done
  } > "$OWNED_GITCONFIG"
}

include_block() {
  printf '%s\n[include]\n\tpath = %s\n%s' \
    "$MARK_START" "$(display_path "$OWNED_GITCONFIG")" "$MARK_END"
}

# Both ~/.gitconfig and the shell rc get a block between the same markers, so
# the add-or-replace and the byte-identical removal are written once.

# Rewrite in place rather than renaming over the path: dotfiles are routinely
# symlinks into a dotfiles repo, and `mv` would swap the link itself for a
# regular file and leave the block behind in the file the shell really reads.
# Writing through the descriptor follows the link and keeps mode and ownership.
replace_contents() { # file source
  cat "$2" > "$1"
  rm -f "$2"
}

# -x, because validation below compares whole lines: without it a line that
# merely quotes the marker text -- `echo "# >>> guise >>>"` -- looks like
# wiring here and like a stray marker there, and setup refuses a good rc.
has_markers() { # file
  grep -qxF "$MARK_START" "$1" || grep -qxF "$MARK_END" "$1"
}

# Exactly one complete pair, in order. Anything else -- an orphan marker left by
# a hand edit, a duplicated block -- makes the removal below ambiguous, and the
# ambiguity would be resolved by deleting lines the human wrote. Refuse instead.
# `bad` carries the verdict rather than the exit status: whether awk keeps a
# rule's status through END is not something every awk agrees on.
valid_markers() { # file
  awk -v s="$MARK_START" -v e="$MARK_END" '
    $0==s { if (open || starts) { bad=1; exit } open=1; starts=1; next }
    $0==e { if (!open || ends)  { bad=1; exit } open=0; ends=1; next }
    END   { if (bad || open || starts != 1 || ends != 1) exit 1 }
  ' "$1"
}

check_markers() { # file
  has_markers "$1" || return 0
  valid_markers "$1" \
    || die "$(display_path "$1") has a stray guise marker -- the block is not one clean pair, so it cannot be edited safely. Fix the markers by hand, then re-run."
}

# Drop the block plus the single blank line setup inserted above it. The file's
# own trailing-newline state has to come back with it, or uninstall leaves a
# file one byte longer than it found -- `separator` covers a block at the end of
# the file, `eofnl` a block with the human's lines still after it.
without_marked_block() { # file -> contents on stdout; caller validates first
  local eof_newline=0
  if [[ -s "$1" && "$(tail -c 1 "$1" | wc -l | tr -d ' ')" == "1" ]]; then
    eof_newline=1
  fi
  awk -v s="$MARK_START" -v e="$MARK_END" -v eofnl="$eof_newline" '
    $0==s { inb=1; if (n > 0 && lines[n] == "") { n--; separator=1 } next }
    $0==e { inb=0; ended=1; next }
    inb   { next }
          { lines[++n]=$0; if (ended) post=1 }
    END {
      final_newline = post ? eofnl : separator
      for (i=1; i<=n; i++) {
        if (i < n || final_newline) print lines[i]
        else printf "%s", lines[i]
      }
    }
  ' "$1"
}

ensure_marked_block() { # file block
  local file="$1" block="$2" current tmp
  touch "$file"
  check_markers "$file"
  if has_markers "$file"; then
    current=$(awk -v s="$MARK_START" -v e="$MARK_END" '$0==s{f=1} f{print} $0==e{f=0}' "$file")
    [[ "$current" == "$block" ]] && return 0
  fi

  # Build the whole result before the file is touched, so a stale block cannot
  # be dropped by a removal that succeeds and an append that then fails. The
  # block is re-appended rather than swapped in place: it spans lines, and
  # `awk -v` will not carry a newline (BWK awk rejects it outright). The end of
  # the file is where a fresh setup puts it anyway, and for ~/.gitconfig it is
  # the position that has to win over anything above it.
  tmp=$(mktemp)
  if has_markers "$file"; then
    without_marked_block "$file" > "$tmp" || { rm -f "$tmp"; return 1; }
  else
    cat "$file" > "$tmp" || { rm -f "$tmp"; return 1; }
  fi
  printf '\n%s\n' "$block" >> "$tmp" || { rm -f "$tmp"; return 1; }
  replace_contents "$file" "$tmp"
}

remove_marked_block() { # file
  local file="$1" tmp
  [[ -f "$file" ]] || return 0
  has_markers "$file" || return 0
  check_markers "$file"
  tmp=$(mktemp)
  without_marked_block "$file" > "$tmp" || { rm -f "$tmp"; return 1; }
  replace_contents "$file" "$tmp"
}

ensure_include_block() { ensure_marked_block "$HOME/.gitconfig" "$(include_block)"; }
remove_include_block() { remove_marked_block "$HOME/.gitconfig"; }

# ---------------------------------------------------------------------------
# Commit signing (user identities only)
# ---------------------------------------------------------------------------

# git learned SSH signing in 2.34. Older git accepts gpg.format=ssh in config
# and only errors at commit time, long after setup claimed success.
git_signs_ssh() {
  local v major minor
  v=$(git --version | awk '{print $3}')
  major=${v%%.*}; minor=${v#*.}; minor=${minor%%.*}
  [[ "$major" =~ ^[0-9]+$ && "$minor" =~ ^[0-9]+$ ]] || return 1
  [[ "$major" -gt 2 || ( "$major" -eq 2 && "$minor" -ge 34 ) ]]
}

# The private half never leaves this machine: generated here, mode 600 under the
# config dir, and regenerated rather than recovered if it is lost. Deliberately
# unlike the PAT -- a signing key grants nothing and is cheap to replace, so a
# copy in 1Password would only widen where it can leak from.
generate_signing_key() { # <path> <comment>
  local path="$1"
  mkdir -p "$KEYS_DIR"; chmod 700 "$KEYS_DIR"
  if [[ ! -f "$path" ]]; then
    rm -f "$path.pub"
    # -N '': no passphrase. One the agent cannot type is one it cannot commit
    # with, and the key is worthless off this machine anyway.
    ssh-keygen -q -t ed25519 -N '' -C "$2" -f "$path" </dev/null
    say "    generated an ed25519 signing key at $path"
  elif [[ ! -f "$path.pub" ]]; then
    # Derive the public half back. Via a temp file: a failed redirect would
    # leave an empty .pub that the branch above then mistakes for a real one.
    ssh-keygen -y -f "$path" > "$path.pub.tmp"
    mv "$path.pub.tmp" "$path.pub"
  fi
  chmod 600 "$path"
}

# Registering a key takes a scope (write:ssh_signing_key) the token is never
# asked to carry, so this asks rather than tries. The only GitHub call in the
# signing path is the unauthenticated read below.
announce_signing_key() { # <login> <public key file>
  local login="$1" body
  body=$(pubkey_body "$2")
  if account_signing_keys "$login" | grep -qxF "$body"; then
    say "    signing key already registered on @$login"
    return 0
  fi
  say "    one step left, in a browser as @$login:"
  say "      github.com/settings/ssh/new  ->  Key type: Signing Key  ->  paste"
  say "      $body"
  say "    doctor flags this until you do; commits sign either way, but GitHub"
  say "    shows them Unverified."
}

# Takes a path, not an identity: callers shred after the config has stopped
# pointing at the key. The public half stays on the account, where only that
# account's owner can remove it, so name it rather than leave it dangling.
shred_signing_key() { # <private key path>
  local key="$1"
  if [[ -f "$key.pub" ]]; then
    say "    remove this key from the agent account's SSH and GPG keys page:"
    say "    $(pubkey_body "$key.pub")"
    rm -f "$key.pub"
  fi
  [[ ! -f "$key" ]] || { shred_file "$key"; say "    shredded the local signing key"; }
}

# ---------------------------------------------------------------------------
# Guided setup
# ---------------------------------------------------------------------------

# openssl only signs App JWTs, so a user-identity-only install never needs it.
# doctor's dependency check has to stay in step with this list.
require_deps() { # kind
  local dep deps="gh jq git curl"
  [[ "$1" != "app" ]] || deps="$deps openssl"
  for dep in $deps; do
    command -v "$dep" >/dev/null || die "missing dependency: $dep"
  done
}

# The wizard's prompts read stdin whether or not it is a terminal. ask() and
# ask_secret() deliberately do not -- they fall back to a default, or refuse,
# when nothing is attached, which is what keeps a flag-driven setup inside a
# script from blocking on a prompt. Here the prompts *are* the input, so
# reading a pipe is the correct behavior, and is how the suite walks the same
# path a human does.
#
# On a terminal the same prompts draw arrow-key menus and redraw each answered
# question in place; from a pipe every answer is one line, and a menu takes its
# key or its number. Everything the wizard draws goes to stderr.
#
# These assign through the caller's variable name, so their own locals are
# underscore-prefixed: bash scoping is dynamic, and a local sharing a name with
# the caller's variable would have the callee assign to itself instead.

WZ_TTY="" WZ_COLS=80 WZ_INDEX=0
WZ_DIM="" WZ_BOLD="" WZ_CYAN="" WZ_GREEN="" WZ_YELLOW="" WZ_INV="" WZ_OFF=""

wz_init() {
  local _num_re='^[0-9]+$'
  # A dumb terminal gets the line-at-a-time prompts a pipe does: every
  # redraw moves the cursor, which it can't.
  if [[ -t 0 && -t 2 && "${TERM:-dumb}" != "dumb" ]]; then
    WZ_TTY=1
    WZ_COLS=$(stty size </dev/tty 2>/dev/null | awk '{print $2}') || WZ_COLS=""
    [[ "$WZ_COLS" =~ $_num_re && "$WZ_COLS" -gt 0 ]] || WZ_COLS=80
    # Menus hide the cursor; a ^C mid-menu must not leave it hidden.
    trap 'printf "\033[?25h" >&2' EXIT
  fi
  if [[ -t 2 && -z "${NO_COLOR:-}" && "${TERM:-dumb}" != "dumb" ]]; then
    WZ_DIM=$'\033[2m' WZ_BOLD=$'\033[1m' WZ_CYAN=$'\033[36m' WZ_GREEN=$'\033[32m'
    WZ_YELLOW=$'\033[33m' WZ_INV=$'\033[7m' WZ_OFF=$'\033[0m'
  fi
}

wz_line() { printf '%s\n' "$*" >&2; }
wz_bar() {
  if [[ $# -eq 0 ]]; then wz_line "${WZ_DIM}│${WZ_OFF}"
  else wz_line "${WZ_DIM}│${WZ_OFF}  $*"; fi
}
wz_warn() { wz_bar "${WZ_YELLOW}$*${WZ_OFF}"; }
wz_done() { wz_line "${WZ_GREEN}◇${WZ_OFF}  $1 ${WZ_DIM}· $2${WZ_OFF}"; }
wz_row()  { wz_bar "${WZ_DIM}$(printf '%-11s' "$1")${WZ_OFF} $2"; }

wz_section() {
  wz_bar
  wz_line "${WZ_DIM}├──${WZ_OFF} ${WZ_CYAN}${WZ_BOLD}$1${WZ_OFF}"
  wz_bar
}

# Rewrites the prompt line just answered as a settled one. Skipped when the
# line could have wrapped: moving up one row would then clobber the wrong one.
wz_settle() { # "prompt" "answer" <width the prompt line took>
  [[ -n "$WZ_TTY" && $3 -lt $WZ_COLS ]] || return 0
  printf '\033[1A\r\033[2K' >&2
  wz_done "$1" "$2"
}

wz_ask() { # varname "prompt" [default] [placeholder] -- non-zero on EOF
  local _var="$1" _val="" _rc=0 _hint="${3:-${4:-}}"
  if [[ -n "$_hint" ]]; then
    printf '%s◆%s  %s %s(%s)%s › ' "$WZ_CYAN" "$WZ_OFF" "$2" "$WZ_DIM" "$_hint" "$WZ_OFF" >&2
  else
    printf '%s◆%s  %s › ' "$WZ_CYAN" "$WZ_OFF" "$2" >&2
  fi
  IFS= read -r _val || _rc=1
  [[ -n "$_val" ]] || _val="${3:-}"
  wz_settle "$2" "${_val:-${4:-ok}}" "$((${#2} + ${#_hint} + ${#_val} + 10))"
  eval "$_var=\"\$_val\""
  return $_rc
}

wz_require() { # varname "prompt" [default] -- re-asks until there is an answer
  local _var="$1" _got=""
  while :; do
    wz_ask _got "$2" "${3:-}" || die "setup: ran out of input at '$2'"
    [[ -z "$_got" ]] || break
    wz_warn "that one's required"
  done
  eval "$_var=\"\$_got\""
}

# Hidden on a terminal, plain from a pipe -- there is nothing to hide from a
# pipe, and it is what lets the suite drive this prompt. Never reaches argv.
wz_secret() { # varname "prompt" -- non-zero on EOF
  local _var="$1" _val="" _rc=0
  printf '%s◆%s  %s › ' "$WZ_CYAN" "$WZ_OFF" "$2" >&2
  if [[ -t 0 ]]; then
    IFS= read -r -s _val || _rc=1
    printf '\n' >&2
  else
    IFS= read -r _val || _rc=1
  fi
  wz_settle "$2" "received" "$((${#2} + 10))"
  eval "$_var=\"\$_val\""
  return $_rc
}

wz_yes() { # "question" <y|n> -- the second argument is the default
  local _q="$1" _yes="" _k="" _rest="" _ans=""
  [[ "$2" != "y" ]] || _yes=1
  if [[ -n "$WZ_TTY" ]]; then
    printf '\033[?25l' >&2
    while :; do
      if [[ -n "$_yes" ]]; then
        printf '\r\033[2K%s◆%s  %s  %s● Yes%s %s/ ○ No%s' \
          "$WZ_CYAN" "$WZ_OFF" "$_q" "$WZ_GREEN" "$WZ_OFF" "$WZ_DIM" "$WZ_OFF" >&2
      else
        printf '\r\033[2K%s◆%s  %s  %s○ Yes /%s %s● No%s' \
          "$WZ_CYAN" "$WZ_OFF" "$_q" "$WZ_DIM" "$WZ_OFF" "$WZ_GREEN" "$WZ_OFF" >&2
      fi
      IFS= read -rsn1 _k || die "setup: ran out of input at '$_q'"
      case "$_k" in
        ""|" ") break ;;
        y|Y) _yes=1; break ;;
        n|N) _yes=""; break ;;
        h|l|$'\t'|$'\033')
          [[ "$_k" != $'\033' ]] || IFS= read -rsn2 -t 1 _rest || true
          if [[ -n "$_yes" ]]; then _yes=""; else _yes=1; fi ;;
      esac
    done
    printf '\r\033[2K\033[?25h' >&2
    wz_done "$_q" "$([[ -n "$_yes" ]] && echo Yes || echo No)"
  else
    while :; do
      wz_ask _ans "$_q (y/n)" "$2" || die "setup: ran out of input at '$_q'"
      case "$(lower "$_ans")" in
        y|yes) _yes=1; break ;;
        n|no)  _yes=""; break ;;
        *) wz_warn "answer y or n" ;;
      esac
    done
  fi
  [[ -n "$_yes" ]]
}

# Sets WZ_INDEX as well as the key, for callers whose keys are free text.
wz_select() { # varname "question" <key> "label" "hint" ... -- the first is the default
  local _var="$1" _q="$2"; shift 2
  local _keys=() _labels=() _hints=() _n=0 _i _cur=0 _k="" _rest="" _ans="" _drawn=""
  while [[ $# -gt 0 ]]; do
    _keys[$_n]="$1"; _labels[$_n]="$2"; _hints[$_n]="$3"
    _n=$((_n + 1)); shift 3
  done

  wz_line "${WZ_CYAN}◆${WZ_OFF}  $_q"
  if [[ -n "$WZ_TTY" ]]; then
    printf '\033[?25l' >&2
    while :; do
      [[ -z "$_drawn" ]] || printf '\033[%dA' "$((_n + 1))" >&2
      _drawn=1
      for ((_i = 0; _i < _n; _i++)); do
        printf '\r\033[2K' >&2
        if [[ $_i -ne $_cur ]]; then
          wz_line "${WZ_DIM}│  ○ ${_labels[$_i]}${WZ_OFF}"
        elif [[ -n "${_hints[$_i]}" && $((${#_labels[$_i]} + ${#_hints[$_i]} + 10)) -lt $WZ_COLS ]]; then
          wz_bar "${WZ_GREEN}●${WZ_OFF} ${_labels[$_i]}  ${WZ_DIM}${_hints[$_i]}${WZ_OFF}"
        else
          wz_bar "${WZ_GREEN}●${WZ_OFF} ${_labels[$_i]}"
        fi
      done
      printf '\r\033[2K' >&2
      wz_line "${WZ_DIM}└  ↑/↓ to move · enter to choose${WZ_OFF}"
      IFS= read -rsn1 _k || die "setup: ran out of input at '$_q'"
      case "$_k" in
        ""|" ") break ;;
        k) _cur=$(( (_cur + _n - 1) % _n )) ;;
        j) _cur=$(( (_cur + 1) % _n )) ;;
        [1-9]) [[ $_k -gt $_n ]] || _cur=$((_k - 1)) ;;
        $'\033')
          IFS= read -rsn2 -t 1 _rest || true
          case "$_rest" in
            "[A") _cur=$(( (_cur + _n - 1) % _n )) ;;
            "[B") _cur=$(( (_cur + 1) % _n )) ;;
          esac ;;
      esac
    done
    printf '\033[%dA\r\033[J\033[?25h' "$((_n + 2))" >&2
  else
    for ((_i = 0; _i < _n; _i++)); do
      wz_bar "$((_i + 1)). ${_labels[$_i]} ${WZ_DIM}[${_keys[$_i]}]${WZ_OFF}"
    done
    _cur=""
    while [[ -z "$_cur" ]]; do
      wz_ask _ans "Pick one" "${_keys[0]}" || die "setup: ran out of input at '$_q'"
      for ((_i = 0; _i < _n; _i++)); do
        if [[ "$(lower "$_ans")" == "$(lower "${_keys[$_i]}")" || "$_ans" == "$((_i + 1))" ]]; then
          _cur=$_i; break
        fi
      done
      [[ -n "$_cur" ]] || wz_warn "pick one of: ${_keys[*]}"
    done
  fi
  wz_done "$_q" "${_labels[$_cur]}"
  WZ_INDEX=$_cur
  eval "$_var=\"\${_keys[\$_cur]}\""
}

# The steps with no API behind them. Printed as a checklist and waited on rather
# than folded into the narration: claiming to have done a browser step is how
# someone ends up debugging a missing installation instead of re-reading a step
# they skipped. Indented lines continue the step above them.
wz_browser() { # "title" "step"...
  local _line _n=0 _ignored=""
  wz_bar
  wz_line "${WZ_YELLOW}◇${WZ_OFF}  ${WZ_BOLD}$1${WZ_OFF} ${WZ_DIM}— over to your browser${WZ_OFF}"
  shift
  for _line in "$@"; do
    case "$_line" in
      " "*) wz_bar "  $_line" ;;
      *)    _n=$((_n + 1)); wz_bar "$_n. $_line" ;;
    esac
  done
  wz_bar
  printf "%s◆%s  Press enter once that's done › " "$WZ_CYAN" "$WZ_OFF" >&2
  IFS= read -r _ignored || die "setup: ran out of input"
  wz_settle "Press enter once that's done" "done" "$((${#_ignored} + 40))"
}

wz_url() { printf '%s%s%s' "$WZ_CYAN" "$1" "$WZ_OFF"; }

wz_intro() {
  wz_line ""
  wz_line "${WZ_DIM}┌${WZ_OFF}  ${WZ_INV} guise ${WZ_OFF}  ${WZ_BOLD}Let's give your agent a GitHub identity of its own${WZ_OFF}"
  wz_bar
  wz_bar "Its commits will say they came from the agent, with you as co-author,"
  wz_bar "and it only gets the access you hand it. A few questions, a browser"
  wz_bar "step or two, and one last look before anything is written."
  wz_bar "${WZ_DIM}^C whenever you like -- nothing changes until you say so.${WZ_OFF}"
}

# Signing is on by default in the wizard, which makes this the step most runs
# end on, so it is walked through and checked rather than left to doctor.
wz_register_signing_key() { # <login> <public key file>
  local _login="$1" _body _again=""
  _body=$(pubkey_body "$2")
  if account_signing_keys "$_login" 2>/dev/null | grep -qxF "$_body"; then
    return 0
  fi
  while :; do
    wz_browser "Add the signing key to @$_login" \
      "Signed in as @$_login, open $(wz_url https://github.com/settings/ssh/new)" \
      "Key type: Signing Key" \
      "Paste this in as the key:" \
      " $_body"
    if account_signing_keys "$_login" 2>/dev/null | grep -qxF "$_body"; then
      wz_bar "${WZ_GREEN}Found it -- @$_login's commits will show up Verified.${WZ_OFF}"
      return 0
    fi
    wz_select _again "GitHub doesn't list that key on @$_login yet." \
      retry "Check again" "" \
      skip "Skip for now" "commits still sign; doctor nags until it's added"
    if [[ "$_again" == "skip" ]]; then
      wz_bar "${WZ_DIM}No problem -- doctor flags it below until it's there.${WZ_OFF}"
      return 0
    fi
  done
}

wz_outro() { # identity
  wz_line ""
  wz_line "${WZ_GREEN}◆${WZ_OFF}  ${WZ_BOLD}$1 is ready.${WZ_OFF}"
  wz_bar "Clone something for it:  guise clone <owner/repo>"
  wz_bar "Hop into its workspace:  guise use $1"
  wz_line "${WZ_DIM}└${WZ_OFF}  Happy building."
}

wz_ask_pem() {
  local _ok=""
  pem=""
  while [[ -z "$_ok" ]]; do
    wz_require pem "Path to the downloaded .pem"
    case "$pem" in "~/"*) pem="$HOME/${pem#\~/}" ;; esac
    if [[ ! -f "$pem" ]]; then wz_warn "nothing at $pem"
    elif ! openssl pkey -in "$pem" -noout 2>/dev/null; then
      wz_warn "$pem isn't a private key -- look for the .pem download, not the app page"
    else _ok=1; fi
  done
  wz_bar "${WZ_DIM}The .pem gets shredded once its key is stored safely.${WZ_OFF}"
}

wz_ask_app_id() { # [default]
  local _num_re='^[0-9]+$'
  while [[ ! "$app_id" =~ $_num_re ]]; do
    [[ -z "$app_id" ]] \
      || wz_warn "the App ID is a number -- not the client ID, and not the app's name"
    wz_require app_id "App ID (top of the app's settings page)" "${1:-}"
  done
}

wz_install_app() {
  wz_browser "Install the app on $owner" \
    "App settings → Install App → $owner" \
    "Pick All repositories, or just the ones the agent works in" \
    "If a repo requires signed commits, add the app to its ruleset's bypass list" \
    " Settings → Rules → Rulesets → Bypass list → Apps → Always"
}

wz_ask_token() {
  wz_browser "Make a token for @$login" \
    "Signed in as @$login, open $(wz_url "https://github.com/settings/tokens/new?scopes=repo&description=guise")" \
    "That's a classic token with the repo scope already ticked -- it reaches" \
    " any repo @$login is added to as a collaborator" \
    "Expiration: whatever you'll actually rotate (doctor fails 30 days out)" \
    "Generate it and copy the token -- GitHub only shows it once"
  # Straight into a variable in this process: never in argv, and never
  # written to disk on the way to being stored.
  wz_secret wizard_token "Paste the token (it won't show)" \
    || die "setup: no token on stdin"
  [[ -n "$wizard_token" ]] || die "setup: empty token"
}

wz_ask_vault() {
  command -v op >/dev/null \
    || die "the 1Password CLI (op) is not installed -- re-run and choose a file"
  while :; do
    wz_require vault "Which 1Password vault?" "$vault"
    if [[ -n "$op_account" ]]; then
      op --account "$op_account" vault get "$vault" >/dev/null 2>&1 && break
    else
      op vault get "$vault" >/dev/null 2>&1 && break
    fi
    wz_warn "can't reach vault '$vault' -- sign in with 'op signin', or check the name"
  done
}

wz_secret_noun() { if [[ "$kind" == "user" ]]; then echo token; else echo "private key"; fi; }

# Offers the stores this machine can actually serve: a file always, 1Password
# with op on PATH, op-cache with both on PATH. An existing identity's store
# goes first so enter keeps it; a new one leads with the file.
wz_ask_store() { # [current]
  local _cur="${1:-file}" _s _rec="" _menu=()
  [[ -n "${1:-}" ]] || _rec="recommended · "
  for _s in "$_cur" file op op-cache; do
    [[ "$_s" != "$_cur" || ${#_menu[@]} -eq 0 ]] || continue
    case "$_s" in
      file) _menu+=(file "In a file on this machine" "${_rec}mode 600 under $(display_path "$KEYS_DIR")") ;;
      op)   command -v op >/dev/null || continue
            _menu+=(op "In 1Password" "read on demand · a locked vault pauses the agent") ;;
      op-cache)
            command -v op >/dev/null && command -v op-cache >/dev/null || continue
            _menu+=(op-cache "In 1Password, cached by op-cache" "experimental · read once per login · a locked vault doesn't pause the agent") ;;
    esac
  done
  if [[ ${#_menu[@]} -eq 3 ]]; then
    store=file
    wz_done "Credential" "a file on this machine (no 1Password CLI found)"
  else
    wz_select store "Where should the $(wz_secret_noun) live?" "${_menu[@]}"
  fi
}

# Walks an existing identity's settings with what it has now as every default,
# so enter all the way through is a plain re-run. Its name, kind and account
# stay put: those are `rename`, or a new identity.
wz_edit_identity() { # identity
  local _was=""
  name="$1"
  kind=$(identity_kind "$1")
  require_deps "$kind"
  op_account=$(cfg_get "identity.$1.opaccount" || true)

  wz_section "$1"
  if [[ "$kind" == "app" ]]; then
    _was=$(cfg_get "identity.$1.owner" || true)
    wz_require owner "Which account or org is it installed on?" "$_was"
    [[ "$owner" == "$_was" ]] || wz_install_app
    _was=$(cfg_get "identity.$1.appid" || true)
    app_id=""
    wz_ask_app_id "$_was"
    # The stored key belongs to the App ID it was stored with.
    if [[ "$app_id" != "$_was" ]] || wz_yes "Use a new private key?" n; then
      wz_ask_pem
    else
      reuse="$1"
    fi
  else
    login=$(cfg_get "identity.$1.login" || true)
    wz_done "Account" "@$login"
    if wz_yes "Paste a new token for @$login?" n; then wz_ask_token; fi
    if signing_enabled "$1"; then _was=y; else _was=n; fi
    if wz_yes "Sign @$login's commits?" "$_was"; then sign=1; else sign=0; fi
  fi

  wz_ask_store "$(key_source "$1")"
  if op_backed "$store"; then
    _was=$(cfg_get "identity.$1.opitem" || true)
    _was=${_was#op://}
    [[ -z "$_was" ]] || vault=${_was%%/*}
    wz_ask_vault
  fi

  if [[ "$(default_identity)" == "$1" ]]; then
    wz_done "Default identity" "yes, already"
  elif wz_yes "Make it your default identity?" n; then
    make_default=1
  fi
}

wz_review() {
  wz_section "One last look"
  if [[ "$kind" == "app" ]]; then
    wz_row "App" "$app_id, installed on $owner"
    if [[ -n "$reuse" && "$reuse" == "$name" ]]; then wz_row "Key" "keeping the stored one"
    elif [[ -n "$reuse" ]]; then wz_row "Key" "reusing the one stored for $reuse"
    else wz_row "Key" "$(display_path "$pem") ${WZ_DIM}(shredded once stored)${WZ_OFF}"; fi
  else
    wz_row "Account" "@$login"
    if [[ -n "$token_file" ]]; then wz_row "Token" "$token_file ${WZ_DIM}(shredded once stored)${WZ_OFF}"
    elif [[ -n "$wizard_token" ]]; then wz_row "Token" "the one you just pasted"
    else wz_row "Token" "keeping the one already stored"; fi
    if [[ "$sign" == "1" ]]; then wz_row "Signing" "on, with a key made on this machine"
    else wz_row "Signing" "off"; fi
  fi
  case "$store" in
    op)       wz_row "Stored in" "1Password, vault $vault" ;;
    op-cache) wz_row "Stored in" "1Password, vault $vault, read through op-cache" ;;
    *)        wz_row "Stored in" "a file under $(display_path "$KEYS_DIR")" ;;
  esac
  wz_row "Identity" "${name:-$derived}"
  if [[ -n "$base" ]]; then
    wz_row "Clones in" "$(display_path "$base")/${name:-${login:-<app name>}}/"
  else
    wz_row "Clones in" "$(display_path "$(basedir "$name")")/$name/"
  fi
  if [[ -n "$make_default" || -z "$existing" || "$(default_identity)" == "$name" ]]; then
    wz_row "Default" "yes"
  else
    wz_row "Default" "no, $(default_identity) stays"
  fi
  wz_bar
  wz_bar "${WZ_DIM}Writes $(display_path "$CONFIG_DIR"), a few helpers in $(display_path "$BIN_DIR"),${WZ_OFF}"
  wz_bar "${WZ_DIM}and one marked block in ~/.gitconfig.${WZ_OFF}"
  wz_bar
  if ! wz_yes "Look good?" y; then
    wz_line "${WZ_DIM}└${WZ_OFF}  No worries -- nothing was written."
    exit 1
  fi
  wz_line "${WZ_DIM}└${WZ_OFF}  On it."
  wz_line ""
}

# Fills in the flags a flag-driven `setup` would have been given, then returns
# and lets that one path do the work -- so there is one provisioning
# implementation, and the wizard is only a way of answering it. Assigns to
# cmd_setup's locals directly, which bash's dynamic scoping allows and which is
# the same trick ask() uses.
#
# Everything checkable without the network is checked in a re-ask loop here, so
# a typo costs one prompt instead of the whole run. What is left is the GitHub
# API -- and nothing has been written to disk by the time those calls run, so a
# rejected credential means re-running, not repairing.
wizard_setup() {
  local existing="" choice="" reuse="" human="" derived="" n="" count=""
  wz_init
  wz_intro

  existing=$(list_identities)
  if [[ -n "$existing" ]]; then
    local menu=(new "Set up a new identity" "")
    for n in $existing; do
      menu+=("$n" "Review $n" "walk its settings, keeping whatever you don't change")
    done
    count=$(printf '%s\n' "$existing" | wc -l | tr -d ' ')
    wz_bar
    if [[ "$count" == "1" ]]; then
      wz_select choice "You already have $existing set up. What's next?" "${menu[@]}"
    else
      wz_select choice "You already have $count identities set up. What's next?" "${menu[@]}"
    fi
    if [[ $WZ_INDEX -ne 0 ]]; then
      wz_edit_identity "$choice"
      wz_review
      return 0
    fi
  fi

  wz_section "The agent"
  if [[ -n "$kind" ]]; then
    wz_done "Kind" "$kind (from --kind)"
  else
    wz_select kind "How should your agent show up on GitHub?" \
      user "As its own GitHub account" "recommended · works anywhere it's invited, signs commits" \
      app  "As a GitHub App bot" "shows up as name[bot] · only where the app is installed"
  fi
  require_deps "$kind"

  if [[ "$kind" == "app" ]]; then
    if ! wz_yes "Have you created the GitHub App yet?" y; then
      wz_browser "Create the app" \
        "Open $(wz_url https://github.com/settings/apps/new)" \
        "Name it <yourname>-agent -- app names are global, so make it yours" \
        "Under Webhook, uncheck Active" \
        "Where can it be installed: Any account" \
        "Repository permissions: Contents, Pull requests and Issues Read and write," \
        " Checks Read-only, Workflows No access" \
        "Create it, then Generate a private key (a .pem downloads) and note the App ID"
    fi
    [[ -n "$owner" ]] || wz_require owner "Which account or org will it be installed on?"
    local num_re='^[0-9]+$'
    [[ "$app_id" =~ $num_re ]] || wz_ask_app_id

    # A second installation of an app already set up needs no new key, which is
    # worth offering: the download is one-time-only on GitHub's side.
    reuse=$(find_identity_by_appid "$app_id") || reuse=""
    if [[ -n "$reuse" ]]; then
      if wz_yes "App $app_id already has a key stored for $reuse. Reuse it?" y; then
        pem=""
      else
        reuse=""
      fi
    fi
    [[ -n "$reuse" || -n "$pem" ]] || wz_ask_pem
    wz_install_app
  else
    if ! wz_yes "Does the agent have its own GitHub account yet?" y; then
      wz_browser "Make the agent an account" \
        "Sign up at $(wz_url https://github.com/signup) with an email address of its own" \
        " GitHub allows one machine account per person, next to your own"
    fi
    # Checkable without the network, so it is re-asked like every other local
    # mistake rather than ending the run. A logged-out gh answers nothing, which
    # leaves the real check to cmd_setup once the token names an account.
    human=$(gh api user --jq .login 2>/dev/null || true)
    while :; do
      [[ -n "$login" ]] || wz_require login "What's the agent account's login?"
      [[ -n "$human" && "$(lower "$login")" == "$(lower "$human")" ]] || break
      wz_warn "@$human is you -- the agent needs an account of its own"
      login=""
    done

    reuse=$(find_identity_by_login "$login") || reuse=""
    if [[ -n "$token_file" ]]; then
      wz_done "Token" "$token_file (from --token-file)"
    elif [[ -n "$reuse" ]] && wz_yes "A token for @$login is already stored. Reuse it?" y; then
      : # the main path finds it by login, exactly as a bare re-run does
    else
      wz_ask_token
    fi
  fi

  wz_section "Keeping it safe"
  if [[ "$kind" == "user" ]]; then
    if [[ -n "$sign" ]]; then
      wz_done "Signing" "$([[ "$sign" == "1" ]] && echo on || echo off) (from the flags)"
    else
      wz_bar "Signed commits show up Verified on GitHub. The key is made here and"
      wz_bar "never leaves this machine; its public half goes on @$login at the end."
      if wz_yes "Sign @$login's commits?" y; then sign=1; else sign=0; fi
    fi
  fi

  if [[ -n "$store" ]]; then
    wz_done "Credential" "$store (from --store)"
  else
    wz_ask_store
  fi
  ! op_backed "$store" || wz_ask_vault

  wz_section "Where it lives"
  if [[ "$kind" == "user" ]]; then derived="$login"; else derived="named after the app"; fi
  # Empty is a real answer here: it means "name it after the account", which is
  # what setup does with no --name. The name pattern is checked by cmd_setup
  # either way, so a bad one dies there with the same message a flag gets.
  [[ -n "$name" ]] \
    || wz_ask name "Name this identity" "" "$derived" \
    || die "setup: ran out of input"
  [[ -n "$base" ]] || wz_require base "Where should its clones live?" "$(display_path "$(basedir)")"
  case "$base" in "~") base="$HOME" ;; "~/"*) base="$HOME/${base#\~/}" ;; esac

  if [[ -n "$make_default" ]]; then
    wz_done "Default identity" "yes (from --default)"
  elif [[ -z "$existing" ]]; then
    wz_done "Default identity" "yes, it's your first"
  elif wz_yes "Make it your default identity?" y; then
    make_default=1
  fi

  wz_review
}

# ---------------------------------------------------------------------------
# setup
# ---------------------------------------------------------------------------

cmd_setup() {
  local owner="" app_id="" pem="" name="" vault="$VAULT" coauthor="" base="" op_account="" store=""
  local kind="" login="" token_file="" make_default="" sign=""
  # Set by the wizard only: a token it read from its own prompt, carried in
  # this process rather than through argv or a file on the way to its store.
  local wizard="" wizard_token="" argc=$#
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --kind)       kind="$2"; shift 2 ;;
      # --org is the work checkout's name for the same flag; accept both so one
      # habit works in either repo.
      --owner|--org) owner="$2"; shift 2 ;;
      --app-id)     app_id="$2"; shift 2 ;;
      --pem)        pem="$2"; shift 2 ;;
      --login)      login="$2"; shift 2 ;;
      --token-file) token_file="$2"; shift 2 ;;
      --name)       name="$2"; shift 2 ;;
      --store)      store="$2"; shift 2 ;;
      --vault)      vault="$2"; shift 2 ;;
      --op-account) op_account="$2"; shift 2 ;;
      --coauthor)   coauthor="$2"; shift 2 ;;
      --base-dir)   base="$2"; shift 2 ;;
      --default)    make_default=1; shift ;;
      --wizard)     wizard=1; shift ;;
      --no-wizard)  wizard=0; shift ;;
      --sign)       sign=1; shift ;;
      --no-sign)    sign=0; shift ;;
      --token)      die "there is no --token flag on purpose -- argv lands in ps output and shell history; use --token-file, or let setup prompt" ;;
      *) die "setup: unknown flag '$1'" ;;
    esac
  done

  op_do() {
    if [[ -n "$op_account" ]]; then op --account "$op_account" "$@"; else op "$@"; fi
  }

  # A bare `setup` on a terminal has nothing to go on, and dying at the first
  # `ask` teaches nobody which flags they needed -- so it asks for the answers
  # instead. One flag, or no terminal, and the flag-driven path stands
  # unchanged, which is what keeps scripted installs and CI working.
  [[ -n "$wizard" || $argc -ne 0 || ! -t 0 ]] || wizard=1
  [[ "$wizard" != "1" ]] || wizard_setup

  # Unnamed identities are named after the account once we've discovered it.
  local name_re='^[A-Za-z0-9_-]+$'
  if [[ -n "$name" ]]; then
    [[ "$name" =~ $name_re ]] || die "identity name must match [A-Za-z0-9_-]+: '$name'"
  fi
  [[ -z "$store" || "$store" == "file" ]] || op_backed "$store" \
    || die "--store must be 'file', 'op' or 'op-cache', got '$store'"

  # Whose stored settings a re-run may reuse: the named identity, or the
  # default when no name was given (which is the one it would derive anyway).
  local probe="$name"
  [[ -n "$probe" ]] || probe=$(default_identity)

  # Flags for one kind mean that kind, and re-running setup for an existing
  # identity keeps its kind; anything else is an account.
  if [[ -z "$kind" ]]; then
    if [[ -n "$owner$app_id$pem" ]]; then kind="app"
    elif [[ -n "$login$token_file" ]]; then kind="user"
    elif identity_exists "$probe"; then kind=$(identity_kind "$probe")
    else kind="user"; fi
  fi

  [[ "$kind" == "app" || "$kind" == "user" ]] || die "--kind must be 'app' or 'user', got '$kind'"
  if [[ "$kind" == "user" ]]; then
    [[ -z "$owner$app_id$pem" ]] \
      || die "--owner/--app-id/--pem are app-only; an account identity takes --login and --token-file"
  else
    [[ -z "$login$token_file" ]] || die "--login/--token-file are for an account identity, not an app"
    [[ "$sign" != "1" ]] \
      || die "--sign is for account identities -- a foo[bot] account has no settings page to register a signing key on"
  fi

  require_deps "$kind"

  [[ -n "$base" ]] || base=$(cfg_get core.basedir) || base="$DEFAULT_BASEDIR"

  # Optional: when unset, the hook falls back to global user.name/email at
  # commit time, so it tracks the engineer's real config instead of a copy.
  if [[ -z "$coauthor" ]]; then
    coauthor=$(cfg_get core.coauthor) || true
  fi

  # Filled in by whichever discovery branch runs below.
  local secret_material="" secret_source="" secret_path="" op_title="" op_item=""
  local slug="" install_id="" bot_user_id="" user_id="" expires=""

  if [[ "$kind" == "user" ]]; then
    # Token: a freshly issued PAT, or one already stored for this identity --
    # or for any identity using the same account.
    local token_owner=""
    if [[ -n "$token_file" ]]; then
      [[ -f "$token_file" ]] || die "token file not found at $token_file"
      secret_material=$(tr -d '\r\n' < "$token_file")
      [[ -n "$secret_material" ]] || die "$token_file is empty"
      secret_source="file"
    elif [[ -n "$wizard_token" ]]; then
      secret_material="$wizard_token"
    else
      if [[ "$(identity_kind "$probe")" == "user" ]] \
         && cfg_get "identity.$probe.login" >/dev/null; then
        token_owner="$probe"
      elif [[ -n "$login" ]]; then
        token_owner=$(find_identity_by_login "$login") || true
      fi
      if [[ -n "$token_owner" ]]; then
        secret_material=$(read_identity_secret "$token_owner") \
          || die "could not read stored token of identity '$token_owner' -- pass --token-file to store a fresh one"
      else
        ask_secret secret_material "Personal access token for the agent account"
      fi
    fi

    # --- identify the account the token belongs to --------------------------
    say "==> checking the token against GitHub"
    local user_json hdr acct_login human_login
    hdr=$(mktemp)
    # The token goes through a config file on a pipe, never argv (and so never ps).
    user_json=$(curl -sf -D "$hdr" \
      --config <(printf 'header = "Authorization: Bearer %s"\n' "$secret_material") \
      -H "Accept: application/vnd.github+json" \
      -H "X-GitHub-Api-Version: 2022-11-28" \
      "${GITHUB_API}/user") \
      || { rm -f "$hdr"; die "GitHub rejected the token -- expired, revoked, or mistyped"; }
    # Split on the first colon only -- the value is a timestamp full of them.
    expires=$(tr -d '\r' < "$hdr" \
      | awk 'tolower($1) == "github-authentication-token-expiration:" {
               sub(/^[^:]*: */, ""); print }' | tail -1)
    rm -f "$hdr"

    acct_login=$(printf '%s' "$user_json" | jq -r '.login')
    user_id=$(printf '%s' "$user_json" | jq -r '.id')
    [[ -n "$acct_login" && "$acct_login" != "null" ]] || die "GitHub returned no login for this token"
    [[ -n "$user_id" && "$user_id" != "null" ]] || die "GitHub returned no user id for this token"
    if [[ -n "$login" && "$(lower "$login")" != "$(lower "$acct_login")" ]]; then
      die "that token belongs to '$acct_login', not '$login'"
    fi
    login="$acct_login"
    say "    account: $login (user id $user_id)"
    [[ -n "$expires" ]] && say "    token expires: $expires"

    # Separation is the entire point: a token for the human's own account would
    # quietly give the agent the human's identity and access.
    human_login=$(gh api user --jq .login 2>/dev/null) || human_login=""
    if [[ -z "$human_login" ]]; then
      warn "could not read your own gh login -- skipped the 'not your own account' check"
    elif [[ "$(lower "$human_login")" == "$(lower "$login")" ]]; then
      die "that token belongs to your own account ($human_login) -- the agent needs an account of its own"
    fi

    [[ -n "$name" ]] || name="$login"
    op_title="$login"
    secret_path="$KEYS_DIR/$name.token"
  else
    if [[ "$(identity_kind "$probe")" == "app" ]] && identity_exists "$probe"; then
      [[ -n "$owner" ]]  || owner=$(cfg_get "identity.$probe.owner" || true)
      [[ -n "$app_id" ]] || app_id=$(cfg_get "identity.$probe.appid" || true)
    fi
    [[ -n "$owner" ]]  || ask owner "GitHub account (user or org) the app is installed on"
    [[ -n "$app_id" ]] || ask app_id "App ID (top of the app settings page)"
    local num_re='^[0-9]+$'
    [[ "$app_id" =~ $num_re ]] || die "app id must be numeric, got '$app_id'"

    # Key material: a freshly downloaded PEM, or a key already stored for this
    # identity -- or for ANY identity using the same app, so adding a second
    # installation of one app never needs a new key download.
    local key_owner=""
    if [[ -n "$pem" ]]; then
      [[ -f "$pem" ]] || die "PEM not found at $pem"
      openssl pkey -in "$pem" -noout 2>/dev/null || die "$pem is not a valid private key"
      secret_material=$(cat "$pem")
      secret_source="file"
    else
      if [[ -n "$name" ]] && [[ "$(cfg_get "identity.$name.appid")" == "$app_id" ]]; then
        key_owner="$name"
      else
        key_owner=$(find_identity_by_appid "$app_id") || true
      fi
      [[ -n "$key_owner" ]] \
        || die "no --pem given and no stored key for app $app_id -- pass --pem <downloaded .pem>"
      secret_material=$(read_identity_secret "$key_owner") \
        || die "could not read stored key of identity '$key_owner' -- pass --pem to store a fresh one"
    fi

    # --- discover slug, installation id, bot user id -----------------------
    say "==> discovering app metadata from GitHub"
    local now header payload signature jwt
    now=$(date +%s)
    header=$(printf '{"typ":"JWT","alg":"RS256"}' | b64url)
    payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$((now - 60))" "$((now + 540))" "$app_id" | b64url)
    signature=$(printf '%s.%s' "$header" "$payload" \
      | openssl dgst -sha256 -sign <(printf '%s\n' "$secret_material") -binary | b64url)
    jwt="${header}.${payload}.${signature}"

    api() {
      curl -sf \
        -H "Authorization: Bearer ${jwt}" \
        -H "Accept: application/vnd.github+json" \
        -H "X-GitHub-Api-Version: 2022-11-28" \
        "${GITHUB_API}$1"
    }

    local app_json
    app_json=$(api /app) || die "GitHub rejected the app JWT -- wrong App ID, or PEM doesn't belong to app $app_id"
    slug=$(printf '%s' "$app_json" | jq -r '.slug')
    [[ "$(printf '%s' "$app_json" | jq -r '.id')" == "$app_id" ]] || die "App ID mismatch -- expected $app_id, API returned $(printf '%s' "$app_json" | jq -r '.id')"
    say "    app slug: $slug"

    local installs
    installs=$(api "/app/installations?per_page=100") || die "could not list installations for the app"
    install_id=$(printf '%s' "$installs" | jq -r --arg owner "$owner" \
      '.[] | select((.account.login | ascii_downcase) == ($owner | ascii_downcase)) | .id')
    [[ -n "$install_id" && "$install_id" != "null" ]] \
      || die "app '$slug' is not installed on '$owner' -- do the install step (see README)"
    say "    installation id: $install_id"

    bot_user_id=$(curl -sf "${GITHUB_API}/users/${slug}%5Bbot%5D" | jq -r '.id') \
      || die "could not resolve bot user ${slug}[bot]"
    [[ "$bot_user_id" != "$app_id" ]] || die "bot user id equals app id ($app_id) -- that can't be right, refusing"
    say "    bot user id: $bot_user_id (this goes in the commit email, NOT the app id)"

    [[ -n "$name" ]] || name="$slug"
    op_title="$slug"
    secret_path="$KEYS_DIR/$name.pem"
  fi

  # A login or slug is already [A-Za-z0-9-] in practice, but this name becomes a
  # directory and a git config key -- check rather than trust.
  [[ "$name" =~ $name_re ]] \
    || die "can't use '$name' as an identity name -- pass --name explicitly"

  # Deferred until the name is settled: an explicit --store wins, an existing
  # identity keeps the store it already uses (re-running setup is the advertised
  # repair action, so it must not move a secret), and anything new goes to a
  # file. Deciding any earlier would make a new identity inherit the store of
  # whatever unrelated identity happened to be the default.
  if [[ -z "$store" ]]; then
    if identity_exists "$name"; then store=$(key_source "$name"); else store="file"; fi
  fi

  # --- commit signing -------------------------------------------------------
  # Sticky: a bare re-run keeps doing whatever this identity already does, so
  # only an explicit --sign / --no-sign turns it on or off.
  local want_sign="" sign_key="" drop_sign=""
  case "$sign" in
    1) want_sign=1 ;;
    0) want_sign="" ;;
    *) if [[ "$kind" == "user" ]] && signing_enabled "$name"; then want_sign=1; fi ;;
  esac
  if [[ -n "$want_sign" ]]; then
    command -v ssh-keygen >/dev/null || die "missing dependency: ssh-keygen (commit signing needs it)"
    git_signs_ssh || die "git $(git --version | awk '{print $3}') is too old for SSH signing -- 2.34 or newer"
    sign_key="$KEYS_DIR/$name.signing"
    say "==> provisioning an SSH signing key for @$login"
    generate_signing_key "$sign_key" "guise $name"
    # The wizard walks this step through once everything else is in place.
    [[ "$wizard" == "1" ]] || announce_signing_key "$login" "$sign_key.pub"
  elif signing_enabled "$name"; then
    # Shredding now would leave a rendered conf that still signs, naming a key
    # that is gone, if anything below this died -- storing the secret can. Same
    # rule as a source file: shred once the new state is durable, and only after.
    drop_sign=$(signing_key "$name")
  fi

  # A secret moving into 1Password leaves a file the config no longer tracks.
  # Shredded at the very end, by the same rule as the signing key above.
  local drop_secret=""
  if op_backed "$store" && identity_exists "$name" && [[ "$(key_source "$name")" == "file" ]]; then
    drop_secret=$(cfg_get "identity.$name.tokenfile" || cfg_get "identity.$name.keyfile" || true)
  fi

  # --- store the secret (1Password or a local file), shred the source -------
  mkdir -p "$CONFIG_DIR"; chmod 700 "$CONFIG_DIR"
  if op_backed "$store"; then
    command -v op >/dev/null || die "missing dependency: op (or use --store file to keep the secret on disk)"
    [[ "$store" != "op-cache" ]] || command -v op-cache >/dev/null \
      || die "missing dependency: op-cache (brew install PatrickTulskie/tap/op-cache, or use --store op)"
    # Not `op whoami`: it reports session-token state and fails under the
    # desktop app's biometric integration even when real operations work.
    op_do vault get "$vault" >/dev/null 2>&1 \
      || die "1Password vault '$vault' unreachable -- not signed in (op signin / enable CLI integration) or the vault doesn't exist"
    local op_fields readback_field readback_value
    if [[ "$kind" == "user" ]]; then
      op_fields=("login[text]=$login" "token[concealed]=$secret_material")
      readback_field="login"; readback_value="$login"
    else
      op_fields=("app_id[text]=$app_id" "installation_id[text]=$install_id" \
                 "private_key[concealed]=$secret_material")
      readback_field="app_id"; readback_value="$app_id"
    fi
    op_item="op://$vault/$op_title"
    say "==> storing credentials in 1Password ($op_item)"
    if op_do item get "$op_title" --vault "$vault" >/dev/null 2>&1; then
      op_do item edit "$op_title" --vault "$vault" "${op_fields[@]}" >/dev/null
    else
      op_do item create --category "API Credential" --title "$op_title" --vault "$vault" \
        "${op_fields[@]}" >/dev/null
    fi
    [[ "$(op_do read "$op_item/$readback_field")" == "$readback_value" ]] \
      || die "1Password readback failed for $op_item/$readback_field"
    # op-cache remembers a reference until its daemon exits and can't forget
    # just one, so a rotated secret would otherwise keep answering as the old
    # one for the rest of the session.
    [[ "$store" != "op-cache" ]] || op-cache clear >/dev/null
    secret_path=""
  else
    # Deliberately under ~/.config, NOT the agent workspace -- agents roam
    # the workspace and must not be able to read or commit the secret.
    say "==> storing secret at $secret_path"
    mkdir -p "$KEYS_DIR"; chmod 700 "$KEYS_DIR"
    printf '%s\n' "$secret_material" > "$secret_path"
    chmod 600 "$secret_path"
  fi

  if [[ "$secret_source" == "file" ]]; then
    local src="$pem"
    [[ "$kind" == "user" ]] && src="$token_file"
    if [[ ! "$src" -ef "$secret_path" ]]; then
      shred_file "$src"
      say "    secret stored and the file it came from shredded"
    fi
  fi

  # --- write config + render everything -------------------------------------
  say "==> writing config and git wiring"
  touch "$CONFIG_FILE"; chmod 600 "$CONFIG_FILE"
  cfg_set core.basedir "$base"
  if [[ -n "$coauthor" ]]; then
    cfg_set core.coauthor "$coauthor"
  fi
  if [[ -n "$op_account" ]]; then
    cfg_set "identity.$name.opaccount" "$op_account"
  fi
  cfg_set "identity.$name.kind" "$kind"
  if [[ "$kind" == "user" ]]; then
    cfg_set "identity.$name.login" "$login"
    cfg_set "identity.$name.userid" "$user_id"
    if [[ -n "$expires" ]]; then
      cfg_set "identity.$name.tokenexpires" "$expires"
    else
      cfg_unset "identity.$name.tokenexpires"
    fi
  else
    cfg_set "identity.$name.owner" "$owner"
    cfg_set "identity.$name.appid" "$app_id"
    cfg_set "identity.$name.slug" "$slug"
    cfg_set "identity.$name.installationid" "$install_id"
    cfg_set "identity.$name.botuserid" "$bot_user_id"
  fi
  cfg_set "identity.$name.keysource" "$store"
  if op_backed "$store"; then
    cfg_set "identity.$name.opitem" "$op_item"
    cfg_unset "identity.$name.keyfile"
    cfg_unset "identity.$name.tokenfile"
  else
    if [[ "$kind" == "user" ]]; then
      cfg_set "identity.$name.tokenfile" "$secret_path"
    else
      cfg_set "identity.$name.keyfile" "$secret_path"
    fi
    cfg_unset "identity.$name.opitem"
  fi
  if [[ -n "$want_sign" ]]; then
    cfg_set "identity.$name.signing" ssh
    cfg_set "identity.$name.signingkey" "$sign_key"
  else
    cfg_unset "identity.$name.signing"
    cfg_unset "identity.$name.signingkey"
  fi
  # The first identity provisioned becomes the default; later ones don't steal
  # it unless asked to.
  if [[ -n "$make_default" ]]; then
    cfg_set core.defaultidentity "$name"
  else
    cfg_get core.defaultidentity >/dev/null || cfg_set core.defaultidentity "$name"
  fi

  local rc_path
  install_binaries
  install_hook
  install_shell_hook
  render_identity_conf "$name"
  regen_owned_gitconfig
  ensure_include_block
  if [[ -n "$drop_sign" ]]; then
    say "==> commit signing is now off for identity '$name'"
    shred_signing_key "$drop_sign"
  fi
  if [[ -n "$drop_secret" && -f "$drop_secret" ]]; then
    shred_file "$drop_secret"
    say "    shredded $(display_path "$drop_secret"), now that the secret is in 1Password"
  fi
  mkdir -p "$(identity_dir "$name")"
  install_agent_docs "$(basedir "$name")"

  say "==> setup complete for identity '$name'"
  [[ -z "$want_sign" ]] || say "    commits are SSH-signed with $sign_key"
  say "    agent clones go in $(identity_dir "$name")/ (use 'guise clone <owner/repo>')"
  say "    default identity: $(default_identity)"
  if rc_path=$(shell_rc); then
    say "    'guise use' cds this shell once $(display_path "$rc_path") is reloaded"
    say "    -- open a new shell, or: . $(display_path "$rc_path")"
  fi
  say ""
  if [[ "$wizard" != "1" ]]; then
    cmd_doctor --name "$name"
    return
  fi
  [[ -z "$want_sign" ]] || wz_register_signing_key "$login" "$sign_key.pub"
  cmd_doctor --name "$name"
  wz_outro "$name"
}

# ---------------------------------------------------------------------------
# doctor
# ---------------------------------------------------------------------------

DOCTOR_FAILURES=0

check() { # "description" "remediation hint" fn args...
  local desc="$1" hint="$2"; shift 2
  if "$@" >/dev/null 2>&1; then
    printf '  ok    %s\n' "$desc"
  else
    printf '  FAIL  %s\n' "$desc"
    printf '        hint: %s\n' "$hint"
    DOCTOR_FAILURES=$((DOCTOR_FAILURES + 1))
  fi
}

# Same shape as check(), but does not count towards the exit status. For things
# that are worth telling someone about without calling the install broken --
# the shell hook is a convenience, and declining it is a legitimate choice.
note() { # "description" "remediation hint" fn args...
  local desc="$1" hint="$2"; shift 2
  if "$@" >/dev/null 2>&1; then
    printf '  ok    %s\n' "$desc"
  else
    printf '  warn  %s\n' "$desc"
    printf '        hint: %s\n' "$hint"
  fi
}

chk_deps() {
  local c
  for c in gh jq git curl; do command -v "$c" >/dev/null || return 1; done
  # openssl only signs App JWTs, and setup requires it only for those, so doctor
  # must stay in step rather than demanding it everywhere.
  if git config -f "$CONFIG_FILE" --get-regexp '^identity\..*\.appid$' >/dev/null 2>&1; then
    command -v openssl >/dev/null || return 1
  fi
  if git config -f "$CONFIG_FILE" --get-regexp '^identity\..*\.signing$' >/dev/null 2>&1; then
    command -v ssh-keygen >/dev/null || return 1
  fi
  if git config -f "$CONFIG_FILE" --get-regexp '^identity\..*\.keysource$' '^op-cache$' >/dev/null 2>&1; then
    command -v op-cache >/dev/null || return 1
  fi
}
chk_op() { # name field
  command -v "$(op_reader "$1")" >/dev/null || return 1
  op_read "$1" "$2" >/dev/null
}
op_hint() { # name -> what to do when its 1Password secret can't be read
  if [[ "$(key_source "$1")" == "op-cache" ]]; then
    printf 'op signin, install op-cache (brew install PatrickTulskie/tap/op-cache), or re-run setup to recreate %s' \
      "$(cfg_get "identity.$1.opitem")"
  else
    printf 'op signin, or re-run setup to recreate %s' "$(cfg_get "identity.$1.opitem")"
  fi
}
chk_keyfile() {
  local f
  f=$(cfg_get "identity.$1.keyfile") || return 1
  [[ -f "$f" ]] || return 1
  [[ "$(file_mode "$f")" == "600" ]] || return 1
  openssl pkey -in "$f" -noout 2>/dev/null
}
chk_tokenfile() {
  local f
  f=$(cfg_get "identity.$1.tokenfile") || return 1
  [[ -s "$f" ]] || return 1
  [[ "$(file_mode "$f")" == "600" ]]
}
chk_token() {
  local t re='^ghs_'
  [[ "$(identity_kind "$1")" != "user" ]] || re='^(github_pat_|ghp_)'
  t=$("$BIN_DIR/guise-token" "$1"); [[ "$t" =~ $re ]]
}
chk_cache() {
  local a b
  a=$("$BIN_DIR/guise-token" "$1"); b=$("$BIN_DIR/guise-token" "$1")
  [[ "$a" == "$b" && -f "$CACHE_DIR/$1.token.json" ]]
}
chk_email_format() {
  local re='^[0-9]+\+.*\[bot\]@users\.noreply\.github\.com$'
  [[ "$(identity_kind "$1")" != "user" ]] || re='^[0-9]+\+[^@]+@users\.noreply\.github\.com$'
  [[ "$(git_email "$1")" =~ $re ]]
}
chk_bot_real() {
  local id
  id=$(curl -sf "${GITHUB_API}/users/$(cfg_get "identity.$1.slug")%5Bbot%5D" | jq -r '.id')
  [[ "$id" == "$(cfg_get "identity.$1.botuserid")" ]]
}
chk_ids_differ() { [[ "$(cfg_get "identity.$1.appid")" != "$(cfg_get "identity.$1.botuserid")" ]]; }

# One authenticated call as the identity itself. Works for both kinds:
# guise-token mints an installation token for apps and returns the PAT for
# accounts. The credential goes through a config file on a pipe, never argv.
api_as_identity() { # name path -> JSON on stdout
  local t
  t=$("$BIN_DIR/guise-token" "$1") || return 1
  curl -sf --config <(printf 'header = "Authorization: Bearer %s"\n' "$t") \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "${GITHUB_API}$2"
}

# The PAT still works AND still belongs to the account we recorded -- a swapped
# token would otherwise silently change who the agent is.
chk_user_real() {
  local json
  json=$(api_as_identity "$1" /user) || return 1
  [[ "$(printf '%s' "$json" | jq -r '.id')" == "$(cfg_get "identity.$1.userid")" ]] \
    && [[ "$(lower "$(printf '%s' "$json" | jq -r '.login')")" \
          == "$(lower "$(cfg_get "identity.$1.login")")" ]]
}

# A credential can be entirely valid and still reach zero repositories, which
# otherwise surfaces only as a 403 "Write access to repository not granted" at
# clone time. For an account: an invite not yet accepted, a token missing the
# repo scope, or a fine-grained token scoped to the account itself.
# For an app: it may be installed on no repositories.
chk_reaches_repo() {
  local n
  if [[ "$(identity_kind "$1")" == "user" ]]; then
    n=$(api_as_identity "$1" "/user/repos?per_page=1" | jq -r 'length') || return 1
  else
    n=$(api_as_identity "$1" "/installation/repositories?per_page=1" | jq -r '.total_count') || return 1
  fi
  [[ "$n" =~ ^[0-9]+$ ]] && (( n > 0 ))
}

# PATs expire; installation tokens are minted on demand. Warn while there is
# still time to rotate. Only the date part is compared -- BSD and GNU date
# disagree on parsing GitHub's timestamp, and hours don't matter at 30 days.
chk_token_fresh() {
  local exp cutoff
  exp=$(cfg_get "identity.$1.tokenexpires") || return 0
  cutoff=$(date -u -v+30d +%Y-%m-%d 2>/dev/null || date -u -d '+30 days' +%Y-%m-%d)
  [[ "${exp:0:10}" > "$cutoff" ]]
}

chk_not_human() {
  local human
  human=$(gh api user --jq .login 2>/dev/null) || return 0
  [[ "$(lower "$human")" != "$(lower "$(cfg_get "identity.$1.login")")" ]]
}

with_scoped_repo() { # name cmd... -- runs cmd with $REPO set to a repo inside scope
  local name="$1"; shift
  local dir rc=0
  [[ -d "$(identity_dir "$name")" ]] || return 1
  dir=$(mktemp -d "$(identity_dir "$name")/.doctor.XXXXXX")
  git init -q "$dir/repo"
  REPO="$dir/repo" "$@" || rc=$?
  rm -rf "$dir"
  return $rc
}
_chk_includeif() {
  [[ "$(git -C "$REPO" config --show-origin --get user.email)" == *"/git/$1.conf"* ]] \
    && [[ "$(git -C "$REPO" config --get user.email)" == "$(git_email "$1")" ]]
}
chk_includeif() { with_scoped_repo "$1" _chk_includeif "$1"; }
_chk_gpgsign() { [[ "$(git -C "$REPO" config --get commit.gpgsign)" == "false" ]]; }
chk_gpgsign() { with_scoped_repo "$1" _chk_gpgsign; }
chk_signing_key() {
  local k
  k=$(signing_key "$1")
  [[ -f "$k" && -f "$k.pub" ]] || return 1
  # Anything looser than 600 and another local account can sign as the agent.
  [[ "$(file_mode "$k")" == "600" ]]
}
chk_signing_registered() {
  local k
  k=$(signing_key "$1"); [[ -f "$k.pub" ]] || return 1
  account_signing_keys "$(cfg_get "identity.$1.login")" | grep -qxF "$(pubkey_body "$k.pub")"
}
# Resolved inside agent scope, so a later include that overrides either one is
# caught too. A signingkey that is not guise's own file -- a public-key literal,
# say -- would route signing to an ssh-agent, which holds the human's keys.
_chk_signing_program() { [[ "$(git -C "$REPO" config --get gpg.ssh.program)" == "ssh-keygen" ]]; }
chk_signing_program() { with_scoped_repo "$1" _chk_signing_program; }
_chk_signingkey_path() { [[ "$(git -C "$REPO" config --get user.signingkey)" == "$(signing_key "$1")" ]]; }
chk_signingkey_path() { with_scoped_repo "$1" _chk_signingkey_path "$1"; }
# End to end rather than by inspection: make a real commit inside agent scope
# and verify it against the rendered allowed-signers file.
_chk_signs() {
  git -C "$REPO" commit -q --allow-empty -m "guise doctor" || return 1
  git -C "$REPO" verify-commit HEAD
}
chk_signs() { with_scoped_repo "$1" _chk_signs; }
_chk_credential() {
  printf 'protocol=https\nhost=github.com\n\n' \
    | GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/usr/bin/false git -C "$REPO" credential fill \
    | grep -q '^username=x-access-token$'
}
chk_credential() { with_scoped_repo "$1" _chk_credential; }
chk_human_untouched() {
  local dir rc=0
  dir=$(mktemp -d)
  git init -q "$dir/repo"
  [[ "$(git -C "$dir/repo" config --get user.email 2>/dev/null || true)" == "$(git config --global --get user.email 2>/dev/null || true)" ]] \
    && [[ "$(git -C "$dir/repo" config --get commit.gpgsign 2>/dev/null || true)" == "$(git config --global --get commit.gpgsign 2>/dev/null || true)" ]] \
    || rc=1
  rm -rf "$dir"
  return $rc
}
chk_hook() { [[ -x "$HOOKS_DIR/prepare-commit-msg" ]]; }

chk_shell_hook() {
  local rc
  [[ -f "$SHELL_HOOK" ]] || return 1
  rc=$(shell_rc) || return 1
  grep -qxF "$MARK_START" "$rc"
}
chk_binaries() { local b; for b in $HELPERS; do [[ -x "$BIN_DIR/$b" ]] || return 1; done; }

# A repo sitting in a workspace root but outside every identity directory gets
# none of the wiring, so it commits as the human -- silently, which is the whole
# problem. Usually the leftovers of a workspace that moved without its clones.
# Depth 3 covers <root>/<identity>/<repo>/.git, so a stray one at
# <root>/<repo>/.git is inside the same walk.
stranded_clones() {
  local root repo dir
  basedirs | while read -r root; do
    [[ -n "$root" && -d "$root" ]] || continue
    # A submodule's or worktree's .git is a file, and either is still a repo,
    # so this matches on the name rather than the type.
    find "$root" -maxdepth 3 -name .git 2>/dev/null | while read -r repo; do
      dir="${repo%/.git}"
      identity_owning "$dir" >/dev/null || printf '%s\n' "$dir"
    done
  done
}

chk_no_stranded_clones() { [[ -z "$STRANDED" ]]; }

cmd_doctor() {
  local only="" STRANDED=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) only="$2"; shift 2 ;;
      *) die "doctor: unknown flag '$1'" ;;
    esac
  done
  [[ -f "$CONFIG_FILE" ]] || die "no config at $CONFIG_FILE -- run 'guise setup' first"

  say "doctor:"
  check "dependencies present (gh jq openssl git curl, op-cache if used)" \
        "brew install the missing one" chk_deps
  check "helper binaries installed in $BIN_DIR" \
        "re-run 'guise setup'" chk_binaries
  check "co-author hook installed and executable" \
        "re-run 'guise setup'" chk_hook
  note  "shell hook sourced (lets 'guise use' cd this shell)" \
        "re-run 'guise setup', or source $(display_path "$SHELL_HOOK") from your shell rc yourself" chk_shell_hook
  check "human identity untouched outside $(basedir)" \
        "something overrode global config -- inspect ~/.gitconfig for stray edits" chk_human_untouched
  # Walked once, not once per interpolation.
  STRANDED=$(stranded_clones | tr '\n' ' ')
  note  "no clones stranded outside an identity directory" \
        "these commit as YOU: ${STRANDED}-- move them under an identity directory, or point the workspace back with 'guise basedir <path>'" \
        chk_no_stranded_clones

  local names name
  names=$(list_identities)
  [[ -n "$names" ]] || die "no identities in config -- run 'guise setup'"
  if [[ -n "$only" ]]; then names="$only"; fi

  for name in $names; do
    say ""
    if [[ "$(identity_kind "$name")" == "user" ]]; then
      say "identity '$name' (account @$(cfg_get "identity.$name.login")):"
      if [[ "$(key_source "$name")" == "file" ]]; then
        check "token file present, non-empty, mode 600" \
              "re-run setup with --store file --token-file, or chmod 600 $(cfg_get "identity.$name.tokenfile")" chk_tokenfile "$name"
      else
        check "1Password token reachable through $(op_reader "$name")" \
              "$(op_hint "$name")" chk_op "$name" token
      fi
      check "stored token looks like a PAT (github_pat_... / ghp_...)" \
            "the stored secret isn't a PAT -- re-run setup with a fresh --token-file" chk_token "$name"
      check "token valid and still @$(cfg_get "identity.$name.login")" \
            "token revoked, expired, or replaced with one for another account -- re-run setup" chk_user_real "$name"
      check "token not expiring within 30 days" \
            "issue a new PAT and re-run 'guise setup --name $name --token-file <path>'" chk_token_fresh "$name"
      check "agent account is not your own account" \
            "this identity holds a token for YOUR account -- issue one from the agent account" chk_not_human "$name"
      check "token reaches at least one repository" \
            "add @$(cfg_get "identity.$name.login" || true) as a collaborator and accept the invite as that account, and check the token has the 'repo' scope (docs/troubleshooting.md)" chk_reaches_repo "$name"
      check "account email well-formed" \
            "re-run setup; email must be <userId>+<login>@users.noreply.github.com" chk_email_format "$name"
    else
      say "identity '$name' ($(cfg_get "identity.$name.slug") on $(cfg_get "identity.$name.owner")):"
      if [[ "$(key_source "$name")" == "file" ]]; then
        check "key file present, valid, mode 600" \
              "re-run setup with --store file --pem, or chmod 600 $(cfg_get "identity.$name.keyfile")" chk_keyfile "$name"
      else
        check "1Password key reachable through $(op_reader "$name")" \
              "$(op_hint "$name")" chk_op "$name" private_key
      fi
      check "token mints (ghs_...)" \
            "wrong app id / installation id / PEM -- re-run setup with a fresh --pem" chk_token "$name"
      check "token cache returns identical token" \
            "cache dir $CACHE_DIR unwritable, or expiry math broken" chk_cache "$name"
      check "bot email well-formed" \
            "re-run setup; email must be <botUserId>+<slug>[bot]@users.noreply.github.com" chk_email_format "$name"
      check "bot user id matches GitHub" \
            "slug or bot user id stale -- re-run setup to rediscover" chk_bot_real "$name"
      check "app id != bot user id (the classic mixup)" \
            "config has the app id in the email -- re-run setup" chk_ids_differ "$name"
      check "installation reaches at least one repository" \
            "the app is installed on no repos -- open its installation settings and pick some under 'Only select repositories'" chk_reaches_repo "$name"
    fi
    check "includeIf resolves identity inside $(identity_dir "$name")/" \
          "check the include block in ~/.gitconfig and $OWNED_GITCONFIG" chk_includeif "$name"
    if signing_enabled "$name"; then
      check "signing key present, mode 600" \
            "regenerate it with 'guise setup --sign --name $name'" chk_signing_key "$name"
      check "signing key registered on @$(cfg_get "identity.$name.login")" \
            "as the agent account, add $(signing_key "$name").pub at github.com/settings/ssh/new with Key type: Signing Key" \
            chk_signing_registered "$name"
      check "agent scope signs with ssh-keygen, not an inherited signer" \
            "run 'guise update' to re-render the conf; if it still fails, ~/.gitconfig sets gpg.ssh.program below the guise block, which wins -- move the guise block to the end" \
            chk_signing_program "$name"
      check "agent scope signs with the identity's own key file" \
            "run 'guise update'; if it still fails, ~/.gitconfig sets user.signingkey below the guise block, which wins -- move the guise block to the end" \
            chk_signingkey_path "$name"
      check "commits sign and verify in agent scope" \
            "fix any signing check above first; otherwise try a commit inside $(identity_dir "$name")/ and read git's error" chk_signs "$name"
    else
      check "commit signing off in agent scope" \
            "rendered conf should set commit.gpgsign=false -- re-run setup" chk_gpgsign "$name"
    fi
    check "credential helper wins (x-access-token)" \
          "inherited osxkeychain not cleared -- rendered conf needs the empty 'helper =' line" chk_credential "$name"
  done

  say ""
  if [[ $DOCTOR_FAILURES -gt 0 ]]; then
    say "doctor: $DOCTOR_FAILURES check(s) failed"
    exit 1
  fi
  say "doctor: all checks passed"
}

# ---------------------------------------------------------------------------
# uninstall
# ---------------------------------------------------------------------------

cmd_uninstall() {
  local yes="" b roots name signed=""
  # Read while the config still exists -- and every root, not just the shared
  # one, or an identity with a workspace of its own goes unmentioned.
  roots=$(basedirs)
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -y|--yes) yes=1; shift ;;
      *) die "uninstall: unknown flag '$1'" ;;
    esac
  done
  if [[ -z "$yes" && -t 0 ]]; then
    read -r -p "Remove guise wiring (gitconfig include, binaries, config, token cache)? [y/N] " reply
    case "$reply" in y|Y|yes) ;; *) say "aborted"; exit 0 ;; esac
  fi

  # Read while the config still exists: the public half of a signing key stays
  # on the agent account, and only that account's owner can take it down.
  for name in $(list_identities); do
    if signing_enabled "$name"; then signed=1; fi
  done

  remove_include_block
  say "removed guise block from ~/.gitconfig"
  remove_shell_hook
  say "removed guise block from your shell rc"

  for b in $HELPERS guise; do
    rm -f "$BIN_DIR/$b"
  done
  say "removed binaries from $BIN_DIR"

  # Key files are credentials, same policy as 1Password items: left alone.
  rmdir "$KEYS_DIR" 2>/dev/null || true
  rm -f "$CONFIG_FILE" "$OWNED_GITCONFIG"
  rm -rf "$RENDER_DIR"
  if [[ -d "$KEYS_DIR" ]]; then
    say "removed config and git wiring from $CONFIG_DIR"
  else
    rm -rf "$CONFIG_DIR"
    say "removed $CONFIG_DIR (config, rendered git confs, hooks)"
  fi

  rm -rf "$CACHE_DIR"
  say "removed token cache $CACHE_DIR"

  say ""
  say "left alone (remove yourself if you want them gone):"
  say "  - the 1Password item(s) holding the agent credentials"
  [[ -d "$KEYS_DIR" ]] && say "  - private keys / tokens / signing keys in $KEYS_DIR"
  [[ -z "$signed" ]] \
    || say "  - the public signing key on the agent account (SSH and GPG keys page)"
  printf '%s\n' "$roots" | while read -r b; do
    [[ -z "$b" ]] || say "  - $b and any clones in it"
  done
  say "your own git identity was never modified and is unchanged"
}

# ---------------------------------------------------------------------------
# clone
# ---------------------------------------------------------------------------

cmd_clone() {
  local repo="" name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      -*) die "clone: unknown flag '$1'" ;;
      *) repo="$1"; shift ;;
    esac
  done
  [[ -n "$repo" ]] || die "usage: guise clone <owner/repo | https url> [--name identity]"
  [[ -f "$CONFIG_FILE" ]] || die "run 'guise setup' first"

  if [[ -z "$name" ]]; then
    name=$(identity_from_cwd) || name=""
  fi
  if [[ -z "$name" ]]; then
    name=$(resolve_default) \
      || die "no default identity set -- pass --name, or set one with 'guise default <name>'"
  fi
  identity_exists "$name" || die "identity '$name' not in config"

  local url
  case "$repo" in
    https://*) url="$repo" ;;
    git@github.com:*)
      url="https://github.com/${repo#git@github.com:}"
      warn "rewrote ssh URL to https -- ssh would push as YOU, not the bot"
      ;;
    */*) url="https://github.com/$repo.git" ;;
    *) die "can't parse repo '$repo' -- use owner/repo or an https URL" ;;
  esac

  local dest
  dest="$(identity_dir "$name")/$(basename "$url" .git)"
  [[ -e "$dest" ]] && die "$dest already exists"
  say "cloning into $dest (identity '$name' applies here)"
  git clone "$url" "$dest"
  say "done -- work in $dest; use 'guise-gh' instead of 'gh' for PRs"
}

# ---------------------------------------------------------------------------
# update -- reinstall what this script embeds, and nothing else
# ---------------------------------------------------------------------------

# Everything rewritten here comes from heredocs in this file plus the existing
# config, so update reads no credential and calls no API. That is the point:
# picking up a new version must work with the 1Password vault locked and the
# network down. `setup` remains the repair action for anything that needs the
# credential or fresh GitHub metadata.
cmd_update() {
  [[ $# -eq 0 ]] || die "update takes no arguments"
  [[ -f "$CONFIG_FILE" ]] || die "no config at $CONFIG_FILE -- run 'guise setup' first"
  local names name count=0
  names=$(list_identities)
  [[ -n "$names" ]] || die "no identities in config -- run 'guise setup'"

  install_binaries
  install_hook
  install_shell_hook
  say "reinstalled $HELPERS, the commit hook, and the shell hook"

  # Every identity, not just the default: a bare `setup` re-renders only the one
  # it ran for, which leaves the others on an old template.
  for name in $names; do
    render_identity_conf "$name"
    count=$((count + 1))
  done
  regen_owned_gitconfig
  ensure_include_block
  say "re-rendered $count identity conf(s) in $RENDER_DIR"
  say ""
  say "config and stored secrets untouched -- run 'guise doctor' to verify the chain"
}

# ---------------------------------------------------------------------------
# which -- the identity owning the current directory
# ---------------------------------------------------------------------------

# The guise-gh helper's identity resolution, and a straight answer to "who am
# I about to act as here?". Exits 1 outside every agent directory: callers that
# want the configured default ask for it themselves.
cmd_which() {
  [[ $# -eq 0 ]] || die "which takes no arguments"
  [[ -f "$CONFIG_FILE" ]] || die "no config at $CONFIG_FILE -- run 'guise setup' first"
  local name
  name=$(identity_from_cwd) \
    || die "$PWD belongs to no identity -- agent clones live under $(basedir)/<identity>/"
  say "$name"
}

# ---------------------------------------------------------------------------
# list -- every identity at a glance
# ---------------------------------------------------------------------------

# How GitHub shows the account behind an identity: an app identity commits as
# <slug>[bot] and reaches only what its owner installed it on, a user identity
# is a plain @login.
identity_account() { # name
  if [[ "$(identity_kind "$1")" == "user" ]]; then
    printf '@%s' "$(cfg_get "identity.$1.login")"
  else
    printf '%s[bot] on %s' "$(cfg_get "identity.$1.slug")" "$(cfg_get "identity.$1.owner")"
  fi
}

# "What do I have, and which one do commands fall back to?" -- otherwise only
# answerable by reading the config file. Columns are sized from the rows, so a
# long identity name doesn't shear the table.
cmd_list() {
  [[ $# -eq 0 ]] || die "list takes no arguments"
  [[ -f "$CONFIG_FILE" ]] || die "no config at $CONFIG_FILE -- run 'guise setup' first"
  local names name def mark acct nw=8 aw=7
  names=$(list_identities)
  [[ -n "$names" ]] || die "no identities in config -- run 'guise setup'"
  # What `clone` and `use` would actually fall back to, which is not always
  # what the config records: with nothing recorded and one identity in there,
  # they resolve to it, and the star has to say the same thing they would.
  def=$(resolve_default) || def=""

  for name in $names; do
    [[ ${#name} -le $nw ]] || nw=${#name}
    acct=$(identity_account "$name")
    [[ ${#acct} -le $aw ]] || aw=${#acct}
  done

  printf '  %-*s  %-4s  %-*s  %-8s  %s\n' "$nw" IDENTITY KIND "$aw" ACCOUNT STORE WORKSPACE
  for name in $names; do
    mark=" "; [[ "$name" != "$def" ]] || mark="*"
    printf '%s %-*s  %-4s  %-*s  %-8s  %s\n' "$mark" "$nw" "$name" \
      "$(identity_kind "$name")" "$aw" "$(identity_account "$name")" \
      "$(key_source "$name")" "$(display_path "$(identity_dir "$name")")"
  done
  say ""
  say "'*' marks the default -- what commands fall back to with no name and no agent directory to read"
}

# ---------------------------------------------------------------------------
# basedir -- move a workspace directory after the fact
# ---------------------------------------------------------------------------

# Same shape as `update`: config plus this script's own output, so no credential
# is read and no API called. What makes this more than a config edit is the
# clones -- a directory left behind under the old path falls out of includeIf
# scope and starts committing as the human, which is the one failure this tool
# exists to prevent. So the directories move with the setting, and a
# destination that is already occupied stops the whole thing.
cmd_basedir() {
  local path="" name="" clear=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)  name="$2"; shift 2 ;;
      --unset) clear=1; shift ;;
      -*) die "basedir: unknown flag '$1'" ;;
      *)
        [[ -z "$path" ]] || die "basedir: too many arguments"
        path="$1"; shift ;;
    esac
  done
  [[ -f "$CONFIG_FILE" ]] || die "no config at $CONFIG_FILE -- run 'guise setup' first"
  if [[ -n "$name" ]]; then
    identity_exists "$name" \
      || die "identity '$name' not in config (have: $(list_identities | tr '\n' ' '))"
  fi

  if [[ -z "$path" && -z "$clear" ]]; then
    say "$(basedir "$name")"
    return 0
  fi
  [[ -z "$clear" || -z "$path" ]] || die "basedir: --unset takes no path"
  [[ -z "$clear" || -n "$name" ]] \
    || die "basedir: --unset needs --name -- the shared workspace always has a value"

  if [[ -n "$path" ]]; then
    case "$path" in
      "~") path="$HOME" ;;
      "~/"*) path="$HOME/${path#\~/}" ;;
      /*) ;;
      *) die "basedir: '$path' must be an absolute path (it becomes an includeIf gitdir)" ;;
    esac
    while [[ "$path" != "/" && "$path" == */ ]]; do path="${path%/}"; done
  fi

  # Which identities move, and where to. A per-identity change moves that one;
  # a change to the shared setting moves everyone still falling back to it.
  local targets="" n
  if [[ -n "$name" ]]; then
    targets="$name"
  else
    for n in $(list_identities); do
      cfg_get "identity.$n.basedir" >/dev/null 2>&1 || targets="$targets $n"
    done
  fi

  # Every move resolved and validated before any of them runs: a refusal
  # halfway through would leave the workspace split across two roots. Tab
  # separates the pair -- an identity name is [A-Za-z0-9_-]+, so it cannot
  # carry one, and a path that does still round-trips.
  local newroot moves="" src dst other cnewroot csrc
  if [[ -n "$clear" ]]; then newroot=$(basedir); else newroot="$path"; fi
  for n in $targets; do
    src=$(identity_dir "$n")
    dst="$newroot/$n"
    [[ "$src" != "$dst" ]] || continue
    [[ ! -e "$dst" ]] || die "$dst already exists -- move it aside first (nothing changed)"
    [[ -d "$src" || ! -e "$src" ]] || die "$src is not a directory (nothing changed)"
    moves="$moves$src	$dst
"
  done

  # Two ways a plan eats itself, both of which strand half the workspace under
  # the wrong identity while the config still says the old thing. Neither is
  # visible one move at a time, so the whole plan is checked before any of it
  # runs -- there is nothing to roll back to once an mv has happened.
  # Resolved, not compared as typed: a symlinked root points inside a tree it
  # does not lexically sit in, and `mv` follows the link while a string compare
  # does not.
  cnewroot=$(canonical_path "$newroot")
  while IFS="	" read -r src dst; do
    [[ -n "$src" ]] || continue
    csrc=$(canonical_path "$src")
    # The new root inside a directory that is itself leaving: the first move
    # lands under a tree the next one then tries to move into itself.
    case "$cnewroot/" in
      "$csrc"/*) die "the new workspace resolves inside $src, which is moving too -- pick a path outside every identity directory (nothing changed)" ;;
    esac
    # An identity that is staying put but lives inside one that is leaving: its
    # clones would ride along and fall out of its own scope.
    for other in $(list_identities); do
      dst=$(canonical_path "$(identity_dir "$other")")
      [[ "$dst" != "$csrc" ]] || continue
      case "$dst/" in
        "$csrc"/*) die "identity '$other' sits inside $src, which is moving -- move '$other' out first (nothing changed)" ;;
      esac
    done
  done <<EOF
$moves
EOF

  while IFS="	" read -r src dst; do
    [[ -n "$src" && -d "$src" ]] || continue
    mkdir -p "$(dirname "$dst")"
    mv "$src" "$dst" || die "could not move $src to $dst"
    say "moved $(display_path "$src") -> $(display_path "$dst") (reopen anything you had open in there)"
  done <<EOF
$moves
EOF

  if [[ -n "$clear" ]]; then
    cfg_unset "identity.$name.basedir"
  elif [[ -n "$name" ]]; then
    cfg_set "identity.$name.basedir" "$path"
  else
    cfg_set core.basedir "$path"
  fi

  # Only the includeIf paths name the workspace; the rendered confs do not, so
  # they are left alone.
  regen_owned_gitconfig
  ensure_include_block
  for n in $(list_identities); do mkdir -p "$(identity_dir "$n")"; done
  basedirs | while read -r n; do [[ -z "$n" ]] || install_agent_docs "$n"; done

  if [[ -n "$name" ]]; then
    say "identity '$name' now works out of $(display_path "$(identity_dir "$name")")"
  else
    say "shared workspace is now $(display_path "$(basedir)")"
  fi
  say "run 'guise doctor' to verify the chain"
}

# ---------------------------------------------------------------------------
# token
# ---------------------------------------------------------------------------

cmd_token() {
  [[ -x "$BIN_DIR/guise-token" ]] || die "helpers not installed -- run 'guise setup' first"
  # Empty is fine: the helper resolves the configured default.
  exec "$BIN_DIR/guise-token" "${1:-}"
}

# ---------------------------------------------------------------------------
# warm-cache -- prime op-cache before the agents start
# ---------------------------------------------------------------------------

# op-cache only holds what something has already asked it for, so after a
# reboot the first read of an `--store op-cache` identity is the one that
# prompts 1Password -- usually an unattended agent, with nobody there to
# approve it. Reading each of those secrets once, by hand or from a login item,
# moves that prompt to a moment you are present for. Nothing is written: the
# secret is read and discarded, and op-cache keeps its own copy in memory for
# the rest of the login session.
cmd_warm_cache() {
  local only="" name warmed=0 failed=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) only="$2"; shift 2 ;;
      *) die "warm-cache: unknown flag '$1'" ;;
    esac
  done
  [[ -f "$CONFIG_FILE" ]] || die "no config at $CONFIG_FILE -- run 'guise setup' first"
  if [[ -n "$only" ]]; then
    identity_exists "$only" \
      || die "identity '$only' not in config (have: $(list_identities | tr '\n' ' '))"
    [[ "$(key_source "$only")" == "op-cache" ]] \
      || die "identity '$only' reads its secret from $(key_source "$only"), not op-cache -- nothing to warm"
  fi

  for name in $(list_identities); do
    [[ -z "$only" || "$name" == "$only" ]] || continue
    [[ "$(key_source "$name")" == "op-cache" ]] || continue
    # stdout is the secret itself, so it goes nowhere; op's own complaint on
    # stderr is the useful part of a failure.
    if op_read "$name" "$(secret_field "$name")" >/dev/null; then
      say "warmed '$name' from $(cfg_get "identity.$name.opitem")"
      warmed=$((warmed + 1))
    else
      warn "could not read '$name' -- $(op_hint "$name")"
      failed=$((failed + 1))
    fi
  done

  if [[ $warmed -eq 0 && $failed -eq 0 ]]; then
    say "no identity reads through op-cache -- nothing to warm"
    return 0
  fi
  [[ $failed -eq 0 ]] || die "$failed identity(ies) unread -- the agent that needs one will still prompt"
  say "$warmed secret(s) cached for the rest of this login session"
}

# ---------------------------------------------------------------------------
# default / rename
# ---------------------------------------------------------------------------

cmd_default() {
  [[ -f "$CONFIG_FILE" ]] || die "no config at $CONFIG_FILE -- run 'guise setup' first"
  if [[ $# -eq 0 ]]; then
    say "$(default_identity)"
    return 0
  fi
  identity_exists "$1" || die "identity '$1' not in config (have: $(list_identities | tr '\n' ' '))"
  cfg_set core.defaultidentity "$1"
  say "default identity is now '$1'"
}

# ---------------------------------------------------------------------------
# use -- drop into a shell in an identity's directory
# ---------------------------------------------------------------------------

# A child process cannot cd its parent, so this replaces itself with a shell
# already sitting in the directory. Leave it the way you leave any shell: exit.
# Wrap a path so the shell hook's eval sees one word whatever is in it. Split on
# the quote by hand rather than with ${var//}, which mangles the '\'' escape on
# bash 3.2, or with sed, which under a UTF-8 locale rejects a path carrying
# bytes that are not valid in it. Builtins only, so no locale is consulted.
shell_quote() {
  local out="" rest="$1"
  while [[ "$rest" == *\'* ]]; do
    out="$out${rest%%\'*}'\\''"
    rest="${rest#*\'}"
  done
  printf "'%s%s'" "$out" "$rest"
}

cmd_use() {
  local name="" emit="" dir
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --emit-shell) emit=1; shift ;;
      -*) die "use: unknown flag '$1'" ;;
      *)
        [[ -z "$name" ]] || die "use: too many arguments"
        name="$1"; shift ;;
    esac
  done
  [[ -f "$CONFIG_FILE" ]] || die "no config at $CONFIG_FILE -- run 'guise setup' first"

  if [[ -z "$name" ]]; then
    name=$(resolve_default) \
      || die "no default identity set -- name one, or set one with 'guise default <name>'"
  fi
  identity_exists "$name" \
    || die "identity '$name' not in config (have: $(list_identities | tr '\n' ' '))"

  dir=$(identity_dir "$name")
  mkdir -p "$dir"

  # The identity follows the directory -- git through includeIf, gh through
  # guise-gh reading $PWD -- so landing there is the whole job. Nothing is
  # exported, which is what keeps a later cd out of the tree from carrying a
  # stale identity with it.
  if [[ -n "$emit" ]]; then
    printf 'cd %s\n' "$(shell_quote "$dir")"
    return 0
  fi

  cd "$dir"
  say "identity '$name' -- $(display_path "$dir"); exit to come back"
  exec "${SHELL:-/bin/sh}"
}

# ---------------------------------------------------------------------------

# Renames an identity and everything named after it: its config section, its
# key file, its rendered git conf, and its directory under the base dir.
cmd_rename() {
  local old="" new="" src dst
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -*) die "rename: unknown flag '$1'" ;;
      *)
        if   [[ -z "$old" ]]; then old="$1"
        elif [[ -z "$new" ]]; then new="$1"
        else die "rename: too many arguments"; fi
        shift ;;
    esac
  done
  [[ -n "$old" && -n "$new" ]] || die "usage: guise rename <old> <new>"
  [[ -f "$CONFIG_FILE" ]] || die "no config at $CONFIG_FILE -- run 'guise setup' first"

  local name_re='^[A-Za-z0-9_-]+$'
  [[ "$new" =~ $name_re ]] || die "identity name must match [A-Za-z0-9_-]+: '$new'"
  identity_exists "$old" || die "identity '$old' not in config"
  identity_exists "$new" && die "identity '$new' already exists"

  src=$(identity_dir "$old")
  # The override travels with the name, so the destination is under whatever
  # workspace the old name resolved to.
  dst="$(basedir "$old")/$new"
  [[ ! -e "$dst" ]] || die "$dst already exists -- move it aside first"

  git config -f "$CONFIG_FILE" --rename-section "identity.$old" "identity.$new"

  # Key material is named after the identity too; keep the two in step.
  local key f
  for key in keyfile tokenfile; do
    f=$(cfg_get "identity.$new.$key") || continue
    if [[ -f "$f" ]]; then
      mv "$f" "${f%/*}/$new.${f##*.}"
      cfg_set "identity.$new.$key" "${f%/*}/$new.${f##*.}"
    fi
  done

  # The signing key is a pair, and ${f##*.} above would turn <old>.signing.pub
  # into <new>.pub, so it moves separately.
  if signing_enabled "$new"; then
    f=$(signing_key "$new")
    if [[ -f "$f" ]]; then
      mv "$f" "$KEYS_DIR/$new.signing"
      [[ ! -f "$f.pub" ]] || mv "$f.pub" "$KEYS_DIR/$new.signing.pub"
      cfg_set "identity.$new.signingkey" "$KEYS_DIR/$new.signing"
    fi
  fi

  if [[ -d "$src" ]]; then
    mv "$src" "$dst"
    say "moved $src -> $dst (reopen anything you had open in there)"
  else
    mkdir -p "$dst"
  fi

  rm -f "$RENDER_DIR/$old.conf" "$CACHE_DIR/$old.token.json" "$(allowed_signers "$old")"
  render_identity_conf "$new"
  regen_owned_gitconfig
  ensure_include_block

  if [[ "$(default_identity)" == "$old" ]]; then
    cfg_set core.defaultidentity "$new"
    say "default identity is now '$new'"
  fi
  say "renamed identity '$old' to '$new'"
}

# ---------------------------------------------------------------------------

usage() {
  cat <<EOF
guise $VERSION -- a dedicated GitHub identity for coding harnesses

usage: guise <command> [flags]

  setup      provision an identity (idempotent; safe to re-run)
             Separate GitHub account (default):
               [--login <account>] [--token-file <path>]
               the token file is shredded after storing; with neither flag
               setup reuses a stored token or prompts (never via argv)
               [--sign | --no-sign]  SSH-sign this identity's commits with a
                                     key of its own (app identities can't)
             GitHub App bot (implied by any of its flags, or --kind app):
               --owner <account> --app-id <id> [--pem <path>]
               --pem is only needed the first time per app; later identities
               of the same app reuse the stored key
             common:
               [--name <identity>]  default: the app slug / account login
               [--default]          make this the default identity
               [--store <file|op|op-cache>]
                                    file: secret on disk, mode 600 (default
                                          for a new identity)
                                    op: secret in 1Password, read on
                                        demand; a locked vault blocks
                                        the agent
                                    op-cache (experimental): secret in
                                        1Password, read through op-cache,
                                        which keeps it in memory for the
                                        rest of the login session; needs
                                        op-cache on PATH
                                    re-running setup keeps the store the
                                    identity already uses; a different one
                                    moves the secret
               [--vault <1password vault>] [--op-account <1password account>]
               [--coauthor "Name <email>"] [--base-dir <dir>]
               [--wizard]   ask for the answers instead of taking flags;
                            this is what a bare "guise setup" does on a
                            terminal. [--no-wizard] to insist on flags.
  doctor     verify the whole chain; non-zero exit on any failure
             [--name <identity>]
  uninstall  remove all wiring; leaves keys + clones alone  [-y]
  clone      clone a repo into the agent directory so the identity applies
             <owner/repo | url> [--name <identity>]
             without --name: the identity owning the current directory,
             otherwise the default
  use        go to an identity's directory  [<name>]
             without <name>: the default identity; cds the current shell once
             the shell hook is loaded, otherwise opens a subshell
  update     reinstall the helpers, hook, and rendered confs from this copy
             of the script; no credential read, no network, config untouched
  token      print the identity's token  [identity]
  default    show the identity used when none is named, or set it  [<name>]
  rename     rename an identity, its directory, and its key files
             <old> <new>
  basedir    show or move the workspace directory, taking the clones with it
             [<path>] [--name <identity>] [--unset]
             without <path>: print it; --name: just that identity's, which
             overrides the shared one; --unset: drop an override
  which      print the identity owning the current directory
  list       print every identity, its account, store, and workspace
  warm-cache read every op-cache-backed secret once, so the first agent of
             the session doesn't hit the 1Password prompt  [--name <identity>]
  version    print the version of this copy of the script
EOF
}

case "${1:-}" in
  setup)      shift; cmd_setup "$@" ;;
  doctor)     shift; cmd_doctor "$@" ;;
  uninstall)  shift; cmd_uninstall "$@" ;;
  clone)      shift; cmd_clone "$@" ;;
  use)        shift; cmd_use "$@" ;;
  update)     shift; cmd_update "$@" ;;
  token)      shift; cmd_token "$@" ;;
  default)    shift; cmd_default "$@" ;;
  rename)     shift; cmd_rename "$@" ;;
  basedir)    shift; cmd_basedir "$@" ;;
  which)      shift; cmd_which "$@" ;;
  list)       shift; cmd_list "$@" ;;
  warm-cache) shift; cmd_warm_cache "$@" ;;
  version|--version|-v) say "guise $VERSION" ;;
  help|--help|-h|"") usage ;;
  *) usage >&2; die "unknown command '${1}'" ;;
esac
