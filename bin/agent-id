#!/usr/bin/env bash
# agent-id — provision a dedicated GitHub identity for coding harnesses.
#
# An identity is either a GitHub App installation (a bot) or a separate
# GitHub account holding a PAT.
#
# Subcommands: setup | doctor | uninstall | clone | use | token | update
#
# Self-contained: the helper binaries, git config template, and commit hook
# are embedded below and written out by `setup`. Targets bash 3.2 (macOS).

set -euo pipefail

SCRIPT_PATH="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

CONFIG_DIR="$HOME/.config/agent-id"
CONFIG_FILE="$CONFIG_DIR/config"
OWNED_GITCONFIG="$CONFIG_DIR/gitconfig"
RENDER_DIR="$CONFIG_DIR/git"
HOOKS_DIR="$RENDER_DIR/agent-hooks"
KEYS_DIR="$CONFIG_DIR/keys"
SHELL_HOOK="$CONFIG_DIR/hook.sh"
BIN_DIR="$HOME/.local/bin"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/agent-id"
DEFAULT_BASEDIR="$HOME/agentic-code"
MARK_START='# >>> agent-id >>>'
MARK_END='# <<< agent-id <<<'
GITHUB_API="${AGENT_ID_GITHUB_API:-https://api.github.com}"
HELPERS="agent-id-token agent-id-credential agent-gh"

say()  { printf '%s\n' "$*"; }
warn() { printf 'agent-id: %s\n' "$*" >&2; }
die()  { printf 'agent-id: error: %s\n' "$*" >&2; exit 1; }

cfg_get()   { git config -f "$CONFIG_FILE" --get "$1" 2>/dev/null; }
cfg_set()   { git config -f "$CONFIG_FILE" "$1" "$2"; }
cfg_unset() { git config -f "$CONFIG_FILE" --unset "$1" 2>/dev/null || true; }

# Remove a secret's source file once the secret is stored somewhere durable.
shred_file() {
  if command -v shred >/dev/null; then
    shred -u "$1"
  else
    rm -f "$1"
    warn "shred not available -- $1 removed with rm (contents may persist on disk)"
  fi
}

# GNU first: BSD stat rejects -c with a usage error and no stdout, while GNU
# stat -f prints filesystem info to stdout *before* failing, so a BSD-first
# fallback would concatenate garbage onto the real answer on Linux.
file_mode() { stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null; }

# ~-form for values written into git config files
display_path() {
  case "$1" in
    "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;;
    *)         printf '%s' "$1" ;;
  esac
}

# An identity is anything with an account handle: .slug for app identities,
# .login for user ones.
list_identities() {
  [[ -f "$CONFIG_FILE" ]] || return 0
  git config -f "$CONFIG_FILE" --name-only --list 2>/dev/null \
    | sed -n -e 's/^identity\.\(.*\)\.slug$/\1/p' -e 's/^identity\.\(.*\)\.login$/\1/p' \
    | sort -u
}

basedir() { cfg_get core.basedir || printf '%s' "$DEFAULT_BASEDIR"; }

# Which identity commands act on when none is named. Set to the first identity
# provisioned; change it with `agent-id default <name>`. "default" is only the
# fallback for configs written before this was configurable.
default_identity() { cfg_get core.defaultidentity || printf 'default'; }

identity_exists() {
  cfg_get "identity.$1.slug" >/dev/null 2>&1 || cfg_get "identity.$1.login" >/dev/null 2>&1
}

# The identity that owns the current directory, by the same basedir/<identity>/
# rule the agent-gh helper uses. Standing in an agent directory is a clearer
# statement of intent than whatever the configured default happens to be.
identity_from_cwd() {
  local base rel name
  base=$(basedir)
  case "$PWD/" in "$base"/*) ;; *) return 1 ;; esac
  rel="${PWD#"$base"/}"
  name="${rel%%/*}"
  [[ -n "$name" ]] || return 1
  identity_exists "$name" || return 1
  printf '%s' "$name"
}

key_source() { cfg_get "identity.$1.keysource" || printf 'op'; }

# Commit signing is opt-in, and user identities only: a foo[bot] account has no
# settings page, so nothing can register a signing key against it.
signing_enabled() { [[ "$(cfg_get "identity.$1.signing" || true)" == "ssh" ]]; }
signing_key()     { cfg_get "identity.$1.signingkey" || printf '%s/%s.signing' "$KEYS_DIR" "$1"; }
allowed_signers() { printf '%s/%s.allowed_signers' "$RENDER_DIR" "$1"; }

# "type base64" with the trailing comment dropped -- the form GitHub stores,
# and the only part worth comparing.
pubkey_body() { awk '{print $1" "$2}' "$1"; }

# Public and unauthenticated on purpose: a fine-grained PAT scoped to an org can
# never read the account's own key list, so ask GitHub the way anyone else would.
account_signing_keys() { # login -> "type base64", one per line
  local json
  json=$(curl -sf "${GITHUB_API}/users/$1/ssh_signing_keys") || return 1
  printf '%s' "$json" | jq -r '.[] | .key' | awk '{print $1" "$2}'
}

lower() { printf '%s' "$1" | tr 'A-Z' 'a-z'; }

# "app" is a GitHub App installation (bot), "user" a real GitHub account with a
# PAT. Configs written before user identities existed have no kind: they're apps.
identity_kind() { cfg_get "identity.$1.kind" || printf 'app'; }

secret_field() {
  if [[ "$(identity_kind "$1")" == "user" ]]; then printf 'token'; else printf 'private_key'; fi
}

secret_file() {
  if [[ "$(identity_kind "$1")" == "user" ]]; then cfg_get "identity.$1.tokenfile"
  else cfg_get "identity.$1.keyfile"; fi
}

read_identity_secret() { # name -> PEM (app) or PAT (user) on stdout
  local acct item path
  if [[ "$(key_source "$1")" == "file" ]]; then
    path=$(secret_file "$1") && [[ -f "$path" ]] || return 1
    cat "$path"
  else
    command -v op >/dev/null || die "missing dependency: op -- identity '$1' keeps its secret in 1Password"
    item=$(cfg_get "identity.$1.opitem") || return 1
    acct=$(cfg_get "identity.$1.opaccount") || acct=""
    if [[ -n "$acct" ]]; then op --account "$acct" read "$item/$(secret_field "$1")"
    else op read "$item/$(secret_field "$1")"; fi
  fi
}

# Git identity: bots commit as <slug>[bot], user accounts as themselves. Both
# use GitHub's noreply address so commits link to the account without leaking
# a real mailbox.
git_name() { # name
  if [[ "$(identity_kind "$1")" == "user" ]]; then cfg_get "identity.$1.login"
  else printf '%s[bot]' "$(cfg_get "identity.$1.slug")"; fi
}

git_email() { # name
  if [[ "$(identity_kind "$1")" == "user" ]]; then
    printf '%s+%s@users.noreply.github.com' \
      "$(cfg_get "identity.$1.userid")" "$(cfg_get "identity.$1.login")"
  else
    printf '%s+%s[bot]@users.noreply.github.com' \
      "$(cfg_get "identity.$1.botuserid")" "$(cfg_get "identity.$1.slug")"
  fi
}

find_identity_by_appid() { # app_id -> identity name
  local n
  for n in $(list_identities); do
    if [[ "$(cfg_get "identity.$n.appid")" == "$1" ]]; then printf '%s' "$n"; return 0; fi
  done
  return 1
}

find_identity_by_login() { # login -> identity name
  local n
  for n in $(list_identities); do
    if [[ "$(lower "$(cfg_get "identity.$n.login")")" == "$(lower "$1")" ]]; then
      printf '%s' "$n"; return 0
    fi
  done
  return 1
}

# Menu goes to stderr so the chosen name is the only thing on stdout. Answer
# with a number or a name; empty (including no terminal at all) takes the
# default, the same way ask() does.
pick_identity() {
  local names def choice="" n i=0
  names=$(list_identities)
  [[ -n "$names" ]] || die "no identities in config -- run 'agent-id setup' first"
  def=$(default_identity)
  identity_exists "$def" || def=$(printf '%s\n' "$names" | head -1)
  if [[ -t 0 ]]; then
    for n in $names; do
      i=$((i + 1))
      if [[ "$n" == "$def" ]]; then printf '  %d) %s (default)\n' "$i" "$n" >&2
      else printf '  %d) %s\n' "$i" "$n" >&2; fi
    done
  fi
  read -r -p "identity [$def]: " choice || choice=""
  if [[ -z "$choice" ]]; then printf '%s' "$def"
  elif [[ "$choice" =~ ^[0-9]+$ ]]; then printf '%s\n' "$names" | sed -n "${choice}p"
  else printf '%s' "$choice"
  fi
}

ask() { # varname "prompt" [default]
  local _var="$1" _prompt="$2" _def="${3:-}" _val=""
  if [[ -t 0 ]]; then
    if [[ -n "$_def" ]]; then
      read -r -p "$_prompt [$_def]: " _val
      _val="${_val:-$_def}"
    else
      read -r -p "$_prompt: " _val
    fi
  else
    _val="$_def"
  fi
  [[ -n "$_val" ]] || die "missing required value: $_prompt (pass it as a flag; run 'agent-id help')"
  eval "$_var=\"\$_val\""
}

# Like ask(), but never echoes and never takes a default -- secrets must not
# reach argv (and therefore ps) or shell history.
ask_secret() { # varname "prompt"
  local _var="$1" _val=""
  [[ -t 0 ]] || die "$2: no value available non-interactively (pass it as a file)"
  read -r -s -p "$2: " _val
  printf '\n' >&2
  [[ -n "$_val" ]] || die "missing required value: $2"
  eval "$_var=\"\$_val\""
}

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

# ---------------------------------------------------------------------------
# Embedded artifacts. `setup` writes these out; keep them dependency-light.
# ---------------------------------------------------------------------------

write_helper_token() {
  cat <<'EOF'
#!/usr/bin/env bash
# Print a GitHub credential for a named identity:
#   app identities  -- mint (and cache) an installation access token
#   user identities -- print the stored personal access token
# Usage: agent-id-token [identity]   (default: $AGENT_ID_IDENTITY or "default")
set -euo pipefail

CONFIG="${AGENT_ID_CONFIG:-$HOME/.config/agent-id/config}"
IDENTITY="${1:-${AGENT_ID_IDENTITY:-}}"

die() { printf 'agent-id-token: %s\n' "$*" >&2; exit 1; }

[[ -f "$CONFIG" ]] || die "no config at $CONFIG -- run 'agent-id setup' first"

# The other helpers pass through whatever they were given (often nothing), so
# resolving the configured default happens here, once.
if [[ -z "$IDENTITY" ]]; then
  IDENTITY=$(git config -f "$CONFIG" --get core.defaultidentity 2>/dev/null || true)
  [[ -n "$IDENTITY" ]] || IDENTITY="default"
fi

cfg() { git config -f "$CONFIG" --get "identity.$IDENTITY.$1" 2>/dev/null; }

KIND=$(cfg kind) || KIND="app"

# Key source is per-identity config: "file" reads a local secret (no 1Password
# involved, suits unattended runs), anything else reads 1Password.
KEY_SOURCE=$(cfg keysource) || KEY_SOURCE="op"
read_secret() { # <1password field> <config key holding the file path>
  local field="$1" path item account
  if [[ "$KEY_SOURCE" == "file" ]]; then
    path=$(cfg "$2") && [[ -f "$path" ]] \
      || die "secret file missing for identity '$IDENTITY' -- re-run 'agent-id setup'"
    cat "$path"
  else
    item=$(cfg opitem) \
      || die "no 1Password item in config for '$IDENTITY' -- re-run 'agent-id setup'"
    account=$(cfg opaccount) || account=""
    if [[ -n "$account" ]]; then op --account "$account" read "$item/$field"
    else op read "$item/$field"; fi
  fi
}

# A PAT is a standing credential: there is nothing to mint, and caching it
# would only put a second copy of it on disk.
if [[ "$KIND" == "user" ]]; then
  read_secret token tokenfile
  exit 0
fi

APP_ID=$(cfg appid) \
  || die "identity '$IDENTITY' not in config -- run 'agent-id setup --name $IDENTITY'"
INSTALL_ID=$(cfg installationid) \
  || die "identity '$IDENTITY' has no installation id -- re-run 'agent-id setup'"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/agent-id"
mkdir -p "$CACHE_DIR"; chmod 700 "$CACHE_DIR"
TOKEN_FILE="$CACHE_DIR/$IDENTITY.token.json"

# Expiry is self-computed at mint time; BSD and GNU date disagree on parsing
# GitHub's ISO-8601 expires_at, so we never parse it.
if [[ -f "$TOKEN_FILE" ]]; then
  cached_exp=$(jq -r '.expires_unix // 0' "$TOKEN_FILE")
  if (( cached_exp - $(date +%s) > 300 )); then
    jq -r '.token' "$TOKEN_FILE"
    exit 0
  fi
fi

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
read_key() { read_secret private_key keyfile; }

# Token acquisition lives in this one function so an alternate source
# (e.g. a remote token service) is a single-body swap.
mint_token() {
  local now header payload signature jwt
  now=$(date +%s)
  header=$(printf '{"typ":"JWT","alg":"RS256"}' | b64url)
  # iat backdated 60s for clock skew; GitHub rejects exp > 10 min out
  payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$((now - 60))" "$((now + 540))" "$APP_ID" | b64url)

  # PEM reaches openssl via process substitution -- never leaves its store.
  signature=$(printf '%s.%s' "$header" "$payload" \
    | openssl dgst -sha256 -sign <(read_key) -binary \
    | b64url)
  jwt="${header}.${payload}.${signature}"

  curl -sf -X POST \
    -H "Authorization: Bearer ${jwt}" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "${AGENT_ID_GITHUB_API:-https://api.github.com}/app/installations/${INSTALL_ID}/access_tokens" \
    || die "failed to mint installation token -- key unreadable (1Password locked / file gone), stale ids, or app uninstalled"
}

mint_unix=$(date +%s)
response=$(mint_token)

# Tokens are valid 1h; treat as 55m to stay clear of the boundary.
printf '%s' "$response" \
  | jq --argjson exp "$((mint_unix + 3300))" '. + {expires_unix: $exp}' \
  > "$TOKEN_FILE"
chmod 600 "$TOKEN_FILE"

jq -r '.token' "$TOKEN_FILE"
EOF
}

write_helper_credential() {
  cat <<'EOF'
#!/usr/bin/env bash
# Git credential helper. Invoked from agent-scoped git config as:
#   agent-id-credential <identity> <get|store|erase>
# Must drain stdin in all cases or git may block on the write side.
set -euo pipefail

IDENTITY=""
if [[ $# -ge 2 ]]; then IDENTITY="$1"; shift; fi

case "${1:-}" in
  get)
    cat >/dev/null
    echo "username=x-access-token"
    echo "password=$("$(cd "$(dirname "$0")" && pwd)/agent-id-token" "$IDENTITY")"
    ;;
  *)
    # store/erase: tokens are ephemeral, nothing to persist. Exit clean.
    cat >/dev/null
    exit 0
    ;;
esac
EOF
}

write_helper_gh() {
  cat <<'EOF'
#!/usr/bin/env bash
# Run `gh` as the agent bot. Identity is inferred from the current directory
# (basedir/<identity>/...), overridable with AGENT_ID_IDENTITY.
# gh prefers GH_TOKEN over its stored credentials, so this is sufficient.
set -euo pipefail

CONFIG="${AGENT_ID_CONFIG:-$HOME/.config/agent-id/config}"
IDENTITY="${AGENT_ID_IDENTITY:-}"

if [[ -z "$IDENTITY" && -f "$CONFIG" ]]; then
  basedir=$(git config -f "$CONFIG" --get core.basedir 2>/dev/null || true)
  if [[ -n "$basedir" ]]; then
    case "$PWD/" in
      "$basedir"/*)
        rel="${PWD#"$basedir"/}"
        IDENTITY="${rel%%/*}"
        ;;
    esac
  fi
fi

# Empty is fine: agent-id-token resolves the configured default.
GH_TOKEN="$("$(cd "$(dirname "$0")" && pwd)/agent-id-token" "$IDENTITY")" exec gh "$@"
EOF
}

# Sourced into an interactive zsh/bash by a marked line in the shell rc. Only
# `use` needs it: changing the caller's directory is something no child process
# can do, so `use --emit-shell` prints the cd and this runs it. Everything else
# falls through untouched, which is what keeps a broken hook from taking the
# whole tool down with it.
write_shell_hook() {
  cat <<'EOF'
# agent-id shell integration -- written by `agent-id setup`, do not edit.
# Rewritten by `agent-id update`; edits here are lost.

agent-id() {
  if [ "${1:-}" = use ]; then
    shift
    local __agent_id_cd
    __agent_id_cd=$(command agent-id use --emit-shell "$@") || return $?
    eval "$__agent_id_cd"
  else
    command agent-id "$@"
  fi
}
EOF
}

write_hook() {
  cat <<'EOF'
#!/usr/bin/env bash
# Append the human co-author trailer to every agent commit.
#
# prepare-commit-msg (not commit-msg) so `git commit -m` is covered.
# The trailer survives rebase merge and is parsed natively by GitHub,
# so the human keeps contribution credit for agent-authored commits.
set -euo pipefail

MSG_FILE="$1"
COMMIT_SOURCE="${2:-}"

# Skip merges and squashes -- trailers there are noise.
[[ "$COMMIT_SOURCE" == "merge" || "$COMMIT_SOURCE" == "squash" ]] && exit 0

CONFIG="${AGENT_ID_CONFIG:-$HOME/.config/agent-id/config}"
CO_AUTHOR="${AGENT_ID_CO_AUTHOR:-}"
if [[ -z "$CO_AUTHOR" && -f "$CONFIG" ]]; then
  CO_AUTHOR=$(git config -f "$CONFIG" --get core.coauthor 2>/dev/null || true)
fi
if [[ -z "$CO_AUTHOR" ]]; then
  # git config exits 1 when a key is unset, and under set -e that would take
  # the whole hook down and abort a commit that was otherwise fine.
  name=$(git config --global user.name || true)
  email=$(git config --global user.email || true)
  [[ -z "$name" || -z "$email" ]] || CO_AUTHOR="$name <$email>"
fi

# No one to credit: leave the message alone rather than failing the commit.
[[ -n "$CO_AUTHOR" ]] || exit 0

git interpret-trailers --if-exists doNothing \
  --trailer "Co-authored-by: ${CO_AUTHOR}" \
  --in-place "$MSG_FILE"
EOF
}

agent_conf_template() {
  cat <<'EOF'
# Generated by agent-id -- do not hand-edit; re-run `agent-id setup` instead.

[user]
	name = {{GIT_NAME}}
	email = {{GIT_EMAIL}}{{SIGNINGKEY}}

{{SIGNING}}

[credential "https://github.com"]
	# Empty value CLEARS inherited helpers (osxkeychain), otherwise the
	# human's cached credentials win and commits push as the human.
	helper =
	helper = {{BIN_DIR}}/agent-id-credential {{NAME}}

[core]
	hooksPath = {{HOOKS_DIR}}

[url "https://github.com/"]
	# ssh would authenticate as the human's key; force https so the
	# credential helper (and therefore the bot identity) always wins.
	insteadOf = git@github.com:
EOF
}

# Stated rather than inherited: the identity has no signing key, and the human's
# global config almost certainly sets gpgsign true.
signing_off_block() {
  cat <<'EOF'
[commit]
	gpgsign = false

[tag]
	gpgsign = false
EOF
}

signing_on_block() { # <allowed signers path>
  cat <<EOF
[commit]
	gpgsign = true

[tag]
	gpgsign = true

[gpg]
	format = ssh

[gpg "ssh"]
	# Lets 'git log --show-signature' verify locally. GitHub verifies against
	# its own copy of the public key, registered on the agent account.
	allowedSignersFile = $1
EOF
}

# ---------------------------------------------------------------------------
# Rendering + ~/.gitconfig wiring
# ---------------------------------------------------------------------------

install_binaries() {
  mkdir -p "$BIN_DIR"
  write_helper_token      > "$BIN_DIR/agent-id-token"
  write_helper_credential > "$BIN_DIR/agent-id-credential"
  write_helper_gh         > "$BIN_DIR/agent-gh"
  chmod 755 "$BIN_DIR/agent-id-token" "$BIN_DIR/agent-id-credential" "$BIN_DIR/agent-gh"
  if [[ "$SCRIPT_PATH" != "$BIN_DIR/agent-id" ]]; then
    cp "$SCRIPT_PATH" "$BIN_DIR/agent-id"
    chmod 755 "$BIN_DIR/agent-id"
  fi
  case ":$PATH:" in
    *":$BIN_DIR:"*) ;;
    *) warn "$BIN_DIR is not on your PATH -- add it to your shell profile" ;;
  esac
}

install_hook() {
  mkdir -p "$HOOKS_DIR"
  write_hook > "$HOOKS_DIR/prepare-commit-msg"
  chmod 755 "$HOOKS_DIR/prepare-commit-msg"
}

# The rc an interactive shell of this kind actually reads. macOS terminals start
# bash as a login shell, which reads .bash_profile and never .bashrc.
shell_rc() {
  case "${SHELL##*/}" in
    zsh)  printf '%s/.zshrc' "${ZDOTDIR:-$HOME}" ;;
    bash) if [[ "$(uname -s)" == Darwin ]]; then printf '%s/.bash_profile' "$HOME"
          else printf '%s/.bashrc' "$HOME"; fi ;;
    *)    return 1 ;;
  esac
}

# Guarded so that a config dir removed by hand leaves a dead line, not a shell
# that errors on every prompt.
shell_block() {
  local rel="${SHELL_HOOK#"$HOME"/}"
  printf '%s\n[ -f "$HOME/%s" ] && . "$HOME/%s"\n%s' \
    "$MARK_START" "$rel" "$rel" "$MARK_END"
}

install_shell_hook() {
  local rc
  mkdir -p "$CONFIG_DIR"
  write_shell_hook > "$SHELL_HOOK"
  chmod 644 "$SHELL_HOOK"
  if ! rc=$(shell_rc); then
    warn "unrecognized shell '${SHELL:-none}' -- source $(display_path "$SHELL_HOOK") from your shell rc to get 'agent-id use'"
    return 0
  fi
  # ensure_marked_block is a no-op when the line is already there and current,
  # so re-running setup never stacks up copies.
  ensure_marked_block "$rc" "$(shell_block)"
}

# Uninstall can run under a different shell than setup did, so clear every rc
# the block could have landed in rather than only this shell's.
remove_shell_hook() {
  local rc
  for rc in "${ZDOTDIR:-$HOME}/.zshrc" "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile"; do
    remove_marked_block "$rc"
  done
}

# Harness instructions at the top of the agent workspace. Claude Code (and
# other harnesses that stack context files up the directory tree) pick these
# up for every repo underneath. Never overwrites user edits.
install_agent_docs() { # basedir
  local base="$1"
  if [[ ! -e "$base/AGENTS.md" ]]; then
    cat > "$base/AGENTS.md" <<'EOF'
# Agent workspace

Repos under this directory use a dedicated GitHub identity (a GitHub App bot
or a separate account), wired up by `agent-id`. Commits here are authored by
that identity automatically.

- Use `agent-gh` instead of `gh` for every GitHub CLI operation (PRs, issues,
  API calls). Plain `gh` acts as the human's account.
- Clone with `agent-id clone <owner/repo>` or an https URL; never ssh remotes
  (ssh authenticates as the human).
- Do not change git identity settings (user.name, user.email, credential
  helpers, signing) -- the directory-scoped config handles all of that.
EOF
  fi
  if [[ ! -e "$base/CLAUDE.md" ]]; then
    printf '@AGENTS.md\n' > "$base/CLAUDE.md"
  fi
}

render_identity_conf() { # name
  local name="$1" tmpl signing signingkey="" key
  case "$(identity_kind "$name")" in
    user)
      cfg_get "identity.$name.login"  >/dev/null || die "identity '$name' missing login"
      cfg_get "identity.$name.userid" >/dev/null || die "identity '$name' missing user id"
      ;;
    *)
      cfg_get "identity.$name.slug"      >/dev/null || die "identity '$name' missing slug"
      cfg_get "identity.$name.botuserid" >/dev/null || die "identity '$name' missing botuserid"
      ;;
  esac
  mkdir -p "$RENDER_DIR"
  if signing_enabled "$name"; then
    key=$(signing_key "$name")
    [[ -f "$key" && -f "$key.pub" ]] \
      || die "identity '$name' signs commits but its key is gone from $key -- re-run 'agent-id setup --sign'"
    signing=$(signing_on_block "$(allowed_signers "$name")")
    signingkey=$(printf '\n\tsigningkey = %s' "$key")
    # namespaces="git" stops this key vouching for anything but commits and
    # tags, which is all it is ever asked to sign.
    printf '%s namespaces="git" %s\n' "$(git_email "$name")" "$(pubkey_body "$key.pub")" \
      > "$(allowed_signers "$name")"
  else
    signing=$(signing_off_block)
    rm -f "$(allowed_signers "$name")"
  fi
  tmpl=$(agent_conf_template)
  tmpl=${tmpl//"{{GIT_NAME}}"/$(git_name "$name")}
  tmpl=${tmpl//"{{GIT_EMAIL}}"/$(git_email "$name")}
  tmpl=${tmpl//"{{SIGNINGKEY}}"/$signingkey}
  tmpl=${tmpl//"{{SIGNING}}"/$signing}
  tmpl=${tmpl//"{{NAME}}"/$name}
  tmpl=${tmpl//"{{BIN_DIR}}"/$BIN_DIR}
  tmpl=${tmpl//"{{HOOKS_DIR}}"/$HOOKS_DIR}
  printf '%s\n' "$tmpl" > "$RENDER_DIR/$name.conf"
}

# Regenerate the file we own: one includeIf block per identity. ~/.gitconfig
# itself only ever holds a single [include] pointing here.
regen_owned_gitconfig() {
  local base name
  base=$(basedir)
  {
    echo "# Generated by agent-id -- do not hand-edit; re-run 'agent-id setup' instead."
    for name in $(list_identities); do
      echo
      echo "[includeIf \"gitdir:$(display_path "$base/$name/")\"]"
      printf '\tpath = git/%s.conf\n' "$name"
    done
  } > "$OWNED_GITCONFIG"
}

include_block() {
  printf '%s\n[include]\n\tpath = %s\n%s' \
    "$MARK_START" "$(display_path "$OWNED_GITCONFIG")" "$MARK_END"
}

# Both ~/.gitconfig and the shell rc get a block between the same markers, so
# the add-or-replace and the byte-identical removal are written once.

# Rewrite in place rather than renaming over the path: dotfiles are routinely
# symlinks into a dotfiles repo, and `mv` would swap the link itself for a
# regular file and leave the block behind in the file the shell really reads.
# Writing through the descriptor follows the link and keeps mode and ownership.
replace_contents() { # file source
  cat "$2" > "$1"
  rm -f "$2"
}

ensure_marked_block() { # file block
  local file="$1" block="$2" current
  touch "$file"
  if grep -qF "$MARK_START" "$file"; then
    current=$(awk -v s="$MARK_START" -v e="$MARK_END" '$0==s{f=1} f{print} $0==e{f=0}' "$file")
    [[ "$current" == "$block" ]] && return 0
    # Drop it and re-append rather than swapping it in place: the block spans
    # lines, and `awk -v` will not carry a newline (BWK awk rejects it outright,
    # so the in-place form failed on macOS). The end of the file is where a
    # fresh setup puts the block anyway, and for ~/.gitconfig it is the position
    # that has to win over anything above it.
    remove_marked_block "$file"
  fi
  printf '\n%s\n' "$block" >> "$file"
}

remove_marked_block() { # file
  local file="$1" tmp
  [[ -f "$file" ]] || return 0
  grep -qF "$MARK_START" "$file" || return 0
  tmp=$(mktemp)
  # Drop the block plus the single blank line setup inserted above it.
  awk -v s="$MARK_START" -v e="$MARK_END" '
    $0==s { inb=1; if (n > 0 && lines[n] == "") n--; next }
    $0==e { inb=0; next }
    inb   { next }
          { lines[++n]=$0 }
    END   { for (i=1; i<=n; i++) print lines[i] }
  ' "$file" > "$tmp" && replace_contents "$file" "$tmp"
}

ensure_include_block() { ensure_marked_block "$HOME/.gitconfig" "$(include_block)"; }
remove_include_block() { remove_marked_block "$HOME/.gitconfig"; }

# ---------------------------------------------------------------------------
# Commit signing (user identities only)
# ---------------------------------------------------------------------------

# git learned SSH signing in 2.34. Older git accepts gpg.format=ssh in config
# and only errors at commit time, long after setup claimed success.
git_signs_ssh() {
  local v major minor
  v=$(git --version | awk '{print $3}')
  major=${v%%.*}; minor=${v#*.}; minor=${minor%%.*}
  [[ "$major" =~ ^[0-9]+$ && "$minor" =~ ^[0-9]+$ ]] || return 1
  [[ "$major" -gt 2 || ( "$major" -eq 2 && "$minor" -ge 34 ) ]]
}

# The private half never leaves this machine: generated here, mode 600 under the
# config dir, and regenerated rather than recovered if it is lost. Deliberately
# unlike the PAT -- a signing key grants nothing and is cheap to replace, so a
# copy in 1Password would only widen where it can leak from.
generate_signing_key() { # <path> <comment>
  local path="$1"
  mkdir -p "$KEYS_DIR"; chmod 700 "$KEYS_DIR"
  if [[ ! -f "$path" ]]; then
    rm -f "$path.pub"
    # -N '': no passphrase. One the agent cannot type is one it cannot commit
    # with, and the key is worthless off this machine anyway.
    ssh-keygen -q -t ed25519 -N '' -C "$2" -f "$path" </dev/null
    say "    generated an ed25519 signing key at $path"
  elif [[ ! -f "$path.pub" ]]; then
    # Derive the public half back. Via a temp file: a failed redirect would
    # leave an empty .pub that the branch above then mistakes for a real one.
    ssh-keygen -y -f "$path" > "$path.pub.tmp"
    mv "$path.pub.tmp" "$path.pub"
  fi
  chmod 600 "$path"
}

# Registering a key needs an account-level permission a fine-grained PAT cannot
# carry, so this asks rather than tries. The only GitHub call in the signing
# path is the unauthenticated read below.
announce_signing_key() { # <login> <public key file>
  local login="$1" body
  body=$(pubkey_body "$2")
  if account_signing_keys "$login" | grep -qxF "$body"; then
    say "    signing key already registered on @$login"
    return 0
  fi
  say "    one step left, in a browser as @$login:"
  say "      github.com/settings/ssh/new  ->  Key type: Signing Key  ->  paste"
  say "      $body"
  say "    doctor flags this until you do; commits sign either way, but GitHub"
  say "    shows them Unverified."
}

# Takes a path, not an identity: callers shred after the config has stopped
# pointing at the key. The public half stays on the account, where only that
# account's owner can remove it, so name it rather than leave it dangling.
shred_signing_key() { # <private key path>
  local key="$1"
  if [[ -f "$key.pub" ]]; then
    say "    remove this key from the agent account's SSH and GPG keys page:"
    say "    $(pubkey_body "$key.pub")"
    rm -f "$key.pub"
  fi
  [[ ! -f "$key" ]] || { shred_file "$key"; say "    shredded the local signing key"; }
}

# ---------------------------------------------------------------------------
# setup
# ---------------------------------------------------------------------------

cmd_setup() {
  local owner="" app_id="" pem="" name="" vault="Private" coauthor="" base="" op_account="" store=""
  local kind="" login="" token_file="" make_default="" sign=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --kind)       kind="$2"; shift 2 ;;
      # --org is the work checkout's name for the same flag; accept both so one
      # habit works in either repo.
      --owner|--org) owner="$2"; shift 2 ;;
      --app-id)     app_id="$2"; shift 2 ;;
      --pem)        pem="$2"; shift 2 ;;
      --login)      login="$2"; shift 2 ;;
      --token-file) token_file="$2"; shift 2 ;;
      --name)       name="$2"; shift 2 ;;
      --store)      store="$2"; shift 2 ;;
      --vault)      vault="$2"; shift 2 ;;
      --op-account) op_account="$2"; shift 2 ;;
      --coauthor)   coauthor="$2"; shift 2 ;;
      --base-dir)   base="$2"; shift 2 ;;
      --default)    make_default=1; shift ;;
      --sign)       sign=1; shift ;;
      --no-sign)    sign=0; shift ;;
      --token)      die "there is no --token flag on purpose -- argv lands in ps output and shell history; use --token-file, or let setup prompt" ;;
      *) die "setup: unknown flag '$1'" ;;
    esac
  done

  op_do() {
    if [[ -n "$op_account" ]]; then op --account "$op_account" "$@"; else op "$@"; fi
  }

  # Unnamed identities are named after the account once we've discovered it.
  local name_re='^[A-Za-z0-9_-]+$'
  if [[ -n "$name" ]]; then
    [[ "$name" =~ $name_re ]] || die "identity name must match [A-Za-z0-9_-]+: '$name'"
  fi
  [[ -z "$store" || "$store" == "op" || "$store" == "file" ]] \
    || die "--store must be 'op' or 'file', got '$store'"

  # Re-running setup for an existing identity keeps its kind unless told
  # otherwise; with no name there is nothing to look up, so apps win the tie.
  if [[ -z "$kind" ]]; then
    if [[ -n "$name" ]]; then kind=$(identity_kind "$name"); else kind="app"; fi
  fi

  # Whose stored secret a bare re-run may reuse: the named identity, or the
  # default when no name was given (which is the one it would derive anyway).
  local probe="$name"
  [[ -n "$probe" ]] || probe=$(default_identity)

  [[ "$kind" == "app" || "$kind" == "user" ]] || die "--kind must be 'app' or 'user', got '$kind'"
  if [[ "$kind" == "user" ]]; then
    [[ -z "$owner$app_id$pem" ]] \
      || die "--owner/--app-id/--pem are app-only; --kind user takes --login and --token-file"
  else
    [[ -z "$login$token_file" ]] || die "--login/--token-file require --kind user"
    [[ "$sign" != "1" ]] \
      || die "--sign applies to --kind user -- a foo[bot] account has no settings page to register a signing key on"
  fi

  # openssl only signs App JWTs, so a user-identity-only install never needs it.
  # doctor's dependency check has to stay in step with this list.
  local dep deps="gh jq git curl"
  [[ "$kind" != "app" ]] || deps="$deps openssl"
  for dep in $deps; do
    command -v "$dep" >/dev/null || die "missing dependency: $dep"
  done

  [[ -n "$base" ]] || base=$(cfg_get core.basedir) || base="$DEFAULT_BASEDIR"

  # Optional: when unset, the hook falls back to global user.name/email at
  # commit time, so it tracks the engineer's real config instead of a copy.
  if [[ -z "$coauthor" ]]; then
    coauthor=$(cfg_get core.coauthor) || true
  fi

  # Filled in by whichever discovery branch runs below.
  local secret_material="" secret_source="" secret_path="" op_title="" op_item=""
  local slug="" install_id="" bot_user_id="" user_id="" expires=""

  if [[ "$kind" == "user" ]]; then
    # Token: a freshly issued PAT, or one already stored for this identity --
    # or for any identity using the same account.
    local token_owner=""
    if [[ -n "$token_file" ]]; then
      [[ -f "$token_file" ]] || die "token file not found at $token_file"
      secret_material=$(tr -d '\r\n' < "$token_file")
      [[ -n "$secret_material" ]] || die "$token_file is empty"
      secret_source="file"
    else
      if [[ "$(identity_kind "$probe")" == "user" ]] \
         && cfg_get "identity.$probe.login" >/dev/null; then
        token_owner="$probe"
      elif [[ -n "$login" ]]; then
        token_owner=$(find_identity_by_login "$login") || true
      fi
      if [[ -n "$token_owner" ]]; then
        secret_material=$(read_identity_secret "$token_owner") \
          || die "could not read stored token of identity '$token_owner' -- pass --token-file to store a fresh one"
      else
        ask_secret secret_material "Personal access token for the agent account"
      fi
    fi

    # --- identify the account the token belongs to --------------------------
    say "==> checking the token against GitHub"
    local user_json hdr acct_login human_login
    hdr=$(mktemp)
    # The token goes through a config file on a pipe, never argv (and so never ps).
    user_json=$(curl -sf -D "$hdr" \
      --config <(printf 'header = "Authorization: Bearer %s"\n' "$secret_material") \
      -H "Accept: application/vnd.github+json" \
      -H "X-GitHub-Api-Version: 2022-11-28" \
      "${GITHUB_API}/user") \
      || { rm -f "$hdr"; die "GitHub rejected the token -- expired, revoked, or mistyped"; }
    # Split on the first colon only -- the value is a timestamp full of them.
    expires=$(tr -d '\r' < "$hdr" \
      | awk 'tolower($1) == "github-authentication-token-expiration:" {
               sub(/^[^:]*: */, ""); print }' | tail -1)
    rm -f "$hdr"

    acct_login=$(printf '%s' "$user_json" | jq -r '.login')
    user_id=$(printf '%s' "$user_json" | jq -r '.id')
    [[ -n "$acct_login" && "$acct_login" != "null" ]] || die "GitHub returned no login for this token"
    [[ -n "$user_id" && "$user_id" != "null" ]] || die "GitHub returned no user id for this token"
    if [[ -n "$login" && "$(lower "$login")" != "$(lower "$acct_login")" ]]; then
      die "that token belongs to '$acct_login', not '$login'"
    fi
    login="$acct_login"
    say "    account: $login (user id $user_id)"
    [[ -n "$expires" ]] && say "    token expires: $expires"

    # Separation is the entire point: a token for the human's own account would
    # quietly give the agent the human's identity and access.
    human_login=$(gh api user --jq .login 2>/dev/null) || human_login=""
    if [[ -z "$human_login" ]]; then
      warn "could not read your own gh login -- skipped the 'not your own account' check"
    elif [[ "$(lower "$human_login")" == "$(lower "$login")" ]]; then
      die "that token belongs to your own account ($human_login) -- the agent needs an account of its own"
    fi

    [[ -n "$name" ]] || name="$login"
    op_title="$login"
    secret_path="$KEYS_DIR/$name.token"
  else
    [[ -n "$owner" ]]  || ask owner "GitHub account (user or org) the app is installed on"
    [[ -n "$app_id" ]] || ask app_id "App ID (top of the app settings page)"
    local num_re='^[0-9]+$'
    [[ "$app_id" =~ $num_re ]] || die "app id must be numeric, got '$app_id'"

    # Key material: a freshly downloaded PEM, or a key already stored for this
    # identity -- or for ANY identity using the same app, so adding a second
    # installation of one app never needs a new key download.
    local key_owner=""
    if [[ -n "$pem" ]]; then
      [[ -f "$pem" ]] || die "PEM not found at $pem"
      openssl pkey -in "$pem" -noout 2>/dev/null || die "$pem is not a valid private key"
      secret_material=$(cat "$pem")
      secret_source="file"
    else
      if [[ -n "$name" ]] && [[ "$(cfg_get "identity.$name.appid")" == "$app_id" ]]; then
        key_owner="$name"
      else
        key_owner=$(find_identity_by_appid "$app_id") || true
      fi
      [[ -n "$key_owner" ]] \
        || die "no --pem given and no stored key for app $app_id -- pass --pem <downloaded .pem>"
      secret_material=$(read_identity_secret "$key_owner") \
        || die "could not read stored key of identity '$key_owner' -- pass --pem to store a fresh one"
    fi

    # --- discover slug, installation id, bot user id -----------------------
    say "==> discovering app metadata from GitHub"
    local now header payload signature jwt
    now=$(date +%s)
    header=$(printf '{"typ":"JWT","alg":"RS256"}' | b64url)
    payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$((now - 60))" "$((now + 540))" "$app_id" | b64url)
    signature=$(printf '%s.%s' "$header" "$payload" \
      | openssl dgst -sha256 -sign <(printf '%s\n' "$secret_material") -binary | b64url)
    jwt="${header}.${payload}.${signature}"

    api() {
      curl -sf \
        -H "Authorization: Bearer ${jwt}" \
        -H "Accept: application/vnd.github+json" \
        -H "X-GitHub-Api-Version: 2022-11-28" \
        "${GITHUB_API}$1"
    }

    local app_json
    app_json=$(api /app) || die "GitHub rejected the app JWT -- wrong App ID, or PEM doesn't belong to app $app_id"
    slug=$(printf '%s' "$app_json" | jq -r '.slug')
    [[ "$(printf '%s' "$app_json" | jq -r '.id')" == "$app_id" ]] || die "App ID mismatch -- expected $app_id, API returned $(printf '%s' "$app_json" | jq -r '.id')"
    say "    app slug: $slug"

    local installs
    installs=$(api "/app/installations?per_page=100") || die "could not list installations for the app"
    install_id=$(printf '%s' "$installs" | jq -r --arg owner "$owner" \
      '.[] | select((.account.login | ascii_downcase) == ($owner | ascii_downcase)) | .id')
    [[ -n "$install_id" && "$install_id" != "null" ]] \
      || die "app '$slug' is not installed on '$owner' -- do the install step (see README)"
    say "    installation id: $install_id"

    bot_user_id=$(curl -sf "${GITHUB_API}/users/${slug}%5Bbot%5D" | jq -r '.id') \
      || die "could not resolve bot user ${slug}[bot]"
    [[ "$bot_user_id" != "$app_id" ]] || die "bot user id equals app id ($app_id) -- that can't be right, refusing"
    say "    bot user id: $bot_user_id (this goes in the commit email, NOT the app id)"

    [[ -n "$name" ]] || name="$slug"
    op_title="$slug"
    secret_path="$KEYS_DIR/$name.pem"
  fi

  # A login or slug is already [A-Za-z0-9-] in practice, but this name becomes a
  # directory and a git config key -- check rather than trust.
  [[ "$name" =~ $name_re ]] \
    || die "can't use '$name' as an identity name -- pass --name explicitly"

  # Deferred until the name is settled: an explicit --store wins, an existing
  # identity keeps the store it already uses (re-running setup is the advertised
  # repair action, so it must not move a secret), and anything new goes to
  # 1Password. Deciding any earlier would make a new identity inherit the store
  # of whatever unrelated identity happened to be the default.
  if [[ -z "$store" ]]; then
    if identity_exists "$name"; then store=$(key_source "$name"); else store="op"; fi
  fi

  # --- commit signing -------------------------------------------------------
  # Sticky: a bare re-run keeps doing whatever this identity already does, so
  # only an explicit --sign / --no-sign turns it on or off.
  local want_sign="" sign_key="" drop_sign=""
  case "$sign" in
    1) want_sign=1 ;;
    0) want_sign="" ;;
    *) if [[ "$kind" == "user" ]] && signing_enabled "$name"; then want_sign=1; fi ;;
  esac
  if [[ -n "$want_sign" ]]; then
    command -v ssh-keygen >/dev/null || die "missing dependency: ssh-keygen (commit signing needs it)"
    git_signs_ssh || die "git $(git --version | awk '{print $3}') is too old for SSH signing -- 2.34 or newer"
    sign_key="$KEYS_DIR/$name.signing"
    say "==> provisioning an SSH signing key for @$login"
    generate_signing_key "$sign_key" "agent-id $name"
    announce_signing_key "$login" "$sign_key.pub"
  elif signing_enabled "$name"; then
    # Shredding now would leave a rendered conf that still signs, naming a key
    # that is gone, if anything below this died -- storing the secret can. Same
    # rule as a source file: shred once the new state is durable, and only after.
    drop_sign=$(signing_key "$name")
  fi

  # --- store the secret (1Password or a local file), shred the source -------
  mkdir -p "$CONFIG_DIR"; chmod 700 "$CONFIG_DIR"
  if [[ "$store" == "op" ]]; then
    command -v op >/dev/null || die "missing dependency: op (or use --store file to keep the secret on disk)"
    # Not `op whoami`: it reports session-token state and fails under the
    # desktop app's biometric integration even when real operations work.
    op_do vault get "$vault" >/dev/null 2>&1 \
      || die "1Password vault '$vault' unreachable -- not signed in (op signin / enable CLI integration) or the vault doesn't exist"
    local op_fields readback_field readback_value
    if [[ "$kind" == "user" ]]; then
      op_fields=("login[text]=$login" "token[concealed]=$secret_material")
      readback_field="login"; readback_value="$login"
    else
      op_fields=("app_id[text]=$app_id" "installation_id[text]=$install_id" \
                 "private_key[concealed]=$secret_material")
      readback_field="app_id"; readback_value="$app_id"
    fi
    op_item="op://$vault/$op_title"
    say "==> storing credentials in 1Password ($op_item)"
    if op_do item get "$op_title" --vault "$vault" >/dev/null 2>&1; then
      op_do item edit "$op_title" --vault "$vault" "${op_fields[@]}" >/dev/null
    else
      op_do item create --category "API Credential" --title "$op_title" --vault "$vault" \
        "${op_fields[@]}" >/dev/null
    fi
    [[ "$(op_do read "$op_item/$readback_field")" == "$readback_value" ]] \
      || die "1Password readback failed for $op_item/$readback_field"
    secret_path=""
  else
    # Deliberately under ~/.config, NOT the agent workspace -- agents roam
    # the workspace and must not be able to read or commit the secret.
    say "==> storing secret at $secret_path"
    mkdir -p "$KEYS_DIR"; chmod 700 "$KEYS_DIR"
    printf '%s\n' "$secret_material" > "$secret_path"
    chmod 600 "$secret_path"
  fi

  if [[ "$secret_source" == "file" ]]; then
    local src="$pem"
    [[ "$kind" == "user" ]] && src="$token_file"
    if [[ ! "$src" -ef "$secret_path" ]]; then
      shred_file "$src"
      say "    secret stored and the file it came from shredded"
    fi
  fi

  # --- write config + render everything -------------------------------------
  say "==> writing config and git wiring"
  touch "$CONFIG_FILE"; chmod 600 "$CONFIG_FILE"
  cfg_set core.basedir "$base"
  if [[ -n "$coauthor" ]]; then
    cfg_set core.coauthor "$coauthor"
  fi
  if [[ -n "$op_account" ]]; then
    cfg_set "identity.$name.opaccount" "$op_account"
  fi
  cfg_set "identity.$name.kind" "$kind"
  if [[ "$kind" == "user" ]]; then
    cfg_set "identity.$name.login" "$login"
    cfg_set "identity.$name.userid" "$user_id"
    if [[ -n "$expires" ]]; then
      cfg_set "identity.$name.tokenexpires" "$expires"
    else
      cfg_unset "identity.$name.tokenexpires"
    fi
  else
    cfg_set "identity.$name.owner" "$owner"
    cfg_set "identity.$name.appid" "$app_id"
    cfg_set "identity.$name.slug" "$slug"
    cfg_set "identity.$name.installationid" "$install_id"
    cfg_set "identity.$name.botuserid" "$bot_user_id"
  fi
  cfg_set "identity.$name.keysource" "$store"
  if [[ "$store" == "op" ]]; then
    cfg_set "identity.$name.opitem" "$op_item"
    cfg_unset "identity.$name.keyfile"
    cfg_unset "identity.$name.tokenfile"
  else
    if [[ "$kind" == "user" ]]; then
      cfg_set "identity.$name.tokenfile" "$secret_path"
    else
      cfg_set "identity.$name.keyfile" "$secret_path"
    fi
    cfg_unset "identity.$name.opitem"
  fi
  if [[ -n "$want_sign" ]]; then
    cfg_set "identity.$name.signing" ssh
    cfg_set "identity.$name.signingkey" "$sign_key"
  else
    cfg_unset "identity.$name.signing"
    cfg_unset "identity.$name.signingkey"
  fi
  # The first identity provisioned becomes the default; later ones don't steal
  # it unless asked to.
  if [[ -n "$make_default" ]]; then
    cfg_set core.defaultidentity "$name"
  else
    cfg_get core.defaultidentity >/dev/null || cfg_set core.defaultidentity "$name"
  fi

  local rc_path
  install_binaries
  install_hook
  install_shell_hook
  render_identity_conf "$name"
  regen_owned_gitconfig
  ensure_include_block
  if [[ -n "$drop_sign" ]]; then
    say "==> commit signing is now off for identity '$name'"
    shred_signing_key "$drop_sign"
  fi
  mkdir -p "$base/$name"
  install_agent_docs "$base"

  say "==> setup complete for identity '$name'"
  [[ -z "$want_sign" ]] || say "    commits are SSH-signed with $sign_key"
  say "    agent clones go in $base/$name/ (use 'agent-id clone <owner/repo>')"
  say "    default identity: $(default_identity)"
  if rc_path=$(shell_rc); then
    say "    'agent-id use' cds this shell once $(display_path "$rc_path") is reloaded"
    say "    -- open a new shell, or: . $(display_path "$rc_path")"
  fi
  say ""
  cmd_doctor --name "$name"
}

# ---------------------------------------------------------------------------
# doctor
# ---------------------------------------------------------------------------

DOCTOR_FAILURES=0

check() { # "description" "remediation hint" fn args...
  local desc="$1" hint="$2"; shift 2
  if "$@" >/dev/null 2>&1; then
    printf '  ok    %s\n' "$desc"
  else
    printf '  FAIL  %s\n' "$desc"
    printf '        hint: %s\n' "$hint"
    DOCTOR_FAILURES=$((DOCTOR_FAILURES + 1))
  fi
}

# Same shape as check(), but does not count towards the exit status. For things
# that are worth telling someone about without calling the install broken --
# the shell hook is a convenience, and declining it is a legitimate choice.
note() { # "description" "remediation hint" fn args...
  local desc="$1" hint="$2"; shift 2
  if "$@" >/dev/null 2>&1; then
    printf '  ok    %s\n' "$desc"
  else
    printf '  warn  %s\n' "$desc"
    printf '        hint: %s\n' "$hint"
  fi
}

chk_deps() {
  local c
  for c in gh jq git curl; do command -v "$c" >/dev/null || return 1; done
  # openssl only signs App JWTs, and setup requires it only for those, so doctor
  # must stay in step rather than demanding it everywhere.
  if git config -f "$CONFIG_FILE" --get-regexp '^identity\..*\.appid$' >/dev/null 2>&1; then
    command -v openssl >/dev/null || return 1
  fi
  if git config -f "$CONFIG_FILE" --get-regexp '^identity\..*\.signing$' >/dev/null 2>&1; then
    command -v ssh-keygen >/dev/null || return 1
  fi
}
chk_op() { # name field
  local acct
  command -v op >/dev/null || return 1
  acct=$(cfg_get "identity.$1.opaccount") || acct=""
  if [[ -n "$acct" ]]; then
    op --account "$acct" read "$(cfg_get "identity.$1.opitem")/$2" >/dev/null
  else
    op read "$(cfg_get "identity.$1.opitem")/$2" >/dev/null
  fi
}
chk_keyfile() {
  local f
  f=$(cfg_get "identity.$1.keyfile") || return 1
  [[ -f "$f" ]] || return 1
  [[ "$(file_mode "$f")" == "600" ]] || return 1
  openssl pkey -in "$f" -noout 2>/dev/null
}
chk_tokenfile() {
  local f
  f=$(cfg_get "identity.$1.tokenfile") || return 1
  [[ -s "$f" ]] || return 1
  [[ "$(file_mode "$f")" == "600" ]]
}
chk_token() {
  local t re='^ghs_'
  [[ "$(identity_kind "$1")" != "user" ]] || re='^(github_pat_|ghp_)'
  t=$("$BIN_DIR/agent-id-token" "$1"); [[ "$t" =~ $re ]]
}
chk_cache() {
  local a b
  a=$("$BIN_DIR/agent-id-token" "$1"); b=$("$BIN_DIR/agent-id-token" "$1")
  [[ "$a" == "$b" && -f "$CACHE_DIR/$1.token.json" ]]
}
chk_email_format() {
  local re='^[0-9]+\+.*\[bot\]@users\.noreply\.github\.com$'
  [[ "$(identity_kind "$1")" != "user" ]] || re='^[0-9]+\+[^@]+@users\.noreply\.github\.com$'
  [[ "$(git_email "$1")" =~ $re ]]
}
chk_bot_real() {
  local id
  id=$(curl -sf "${GITHUB_API}/users/$(cfg_get "identity.$1.slug")%5Bbot%5D" | jq -r '.id')
  [[ "$id" == "$(cfg_get "identity.$1.botuserid")" ]]
}
chk_ids_differ() { [[ "$(cfg_get "identity.$1.appid")" != "$(cfg_get "identity.$1.botuserid")" ]]; }

# One authenticated call as the identity itself. Works for both kinds:
# agent-id-token mints an installation token for apps and returns the PAT for
# accounts. The credential goes through a config file on a pipe, never argv.
api_as_identity() { # name path -> JSON on stdout
  local t
  t=$("$BIN_DIR/agent-id-token" "$1") || return 1
  curl -sf --config <(printf 'header = "Authorization: Bearer %s"\n' "$t") \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "${GITHUB_API}$2"
}

# The PAT still works AND still belongs to the account we recorded -- a swapped
# token would otherwise silently change who the agent is.
chk_user_real() {
  local json
  json=$(api_as_identity "$1" /user) || return 1
  [[ "$(printf '%s' "$json" | jq -r '.id')" == "$(cfg_get "identity.$1.userid")" ]] \
    && [[ "$(lower "$(printf '%s' "$json" | jq -r '.login')")" \
          == "$(lower "$(cfg_get "identity.$1.login")")" ]]
}

# A credential can be entirely valid and still reach zero repositories, which
# otherwise surfaces only as a 403 "Write access to repository not granted" at
# clone time. For an account: a fine-grained PAT reaches only repos owned by its
# resource owner, and the picker offers an org only if the account is a MEMBER,
# so an outside collaborator can scope a token to itself and nothing else.
# For an app: it may be installed on no repositories.
chk_reaches_repo() {
  local n
  if [[ "$(identity_kind "$1")" == "user" ]]; then
    n=$(api_as_identity "$1" "/user/repos?per_page=1" | jq -r 'length') || return 1
  else
    n=$(api_as_identity "$1" "/installation/repositories?per_page=1" | jq -r '.total_count') || return 1
  fi
  [[ "$n" =~ ^[0-9]+$ ]] && (( n > 0 ))
}

# PATs expire; installation tokens are minted on demand. Warn while there is
# still time to rotate. Only the date part is compared -- BSD and GNU date
# disagree on parsing GitHub's timestamp, and hours don't matter at 30 days.
chk_token_fresh() {
  local exp cutoff
  exp=$(cfg_get "identity.$1.tokenexpires") || return 0
  cutoff=$(date -u -v+30d +%Y-%m-%d 2>/dev/null || date -u -d '+30 days' +%Y-%m-%d)
  [[ "${exp:0:10}" > "$cutoff" ]]
}

chk_not_human() {
  local human
  human=$(gh api user --jq .login 2>/dev/null) || return 0
  [[ "$(lower "$human")" != "$(lower "$(cfg_get "identity.$1.login")")" ]]
}

with_scoped_repo() { # name cmd... -- runs cmd with $REPO set to a repo inside scope
  local name="$1"; shift
  local dir rc=0
  [[ -d "$(basedir)/$name" ]] || return 1
  dir=$(mktemp -d "$(basedir)/$name/.doctor.XXXXXX")
  git init -q "$dir/repo"
  REPO="$dir/repo" "$@" || rc=$?
  rm -rf "$dir"
  return $rc
}
_chk_includeif() {
  [[ "$(git -C "$REPO" config --show-origin --get user.email)" == *"/git/$1.conf"* ]] \
    && [[ "$(git -C "$REPO" config --get user.email)" == "$(git_email "$1")" ]]
}
chk_includeif() { with_scoped_repo "$1" _chk_includeif "$1"; }
_chk_gpgsign() { [[ "$(git -C "$REPO" config --get commit.gpgsign)" == "false" ]]; }
chk_gpgsign() { with_scoped_repo "$1" _chk_gpgsign; }
chk_signing_key() {
  local k
  k=$(signing_key "$1")
  [[ -f "$k" && -f "$k.pub" ]] || return 1
  # Anything looser than 600 and another local account can sign as the agent.
  [[ "$(file_mode "$k")" == "600" ]]
}
chk_signing_registered() {
  local k
  k=$(signing_key "$1"); [[ -f "$k.pub" ]] || return 1
  account_signing_keys "$(cfg_get "identity.$1.login")" | grep -qxF "$(pubkey_body "$k.pub")"
}
# End to end rather than by inspection: make a real commit inside agent scope
# and verify it against the rendered allowed-signers file.
_chk_signs() {
  git -C "$REPO" commit -q --allow-empty -m "agent-id doctor" || return 1
  git -C "$REPO" verify-commit HEAD
}
chk_signs() { with_scoped_repo "$1" _chk_signs; }
_chk_credential() {
  printf 'protocol=https\nhost=github.com\n\n' \
    | GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/usr/bin/false git -C "$REPO" credential fill \
    | grep -q '^username=x-access-token$'
}
chk_credential() { with_scoped_repo "$1" _chk_credential; }
chk_human_untouched() {
  local dir rc=0
  dir=$(mktemp -d)
  git init -q "$dir/repo"
  [[ "$(git -C "$dir/repo" config --get user.email 2>/dev/null || true)" == "$(git config --global --get user.email 2>/dev/null || true)" ]] \
    && [[ "$(git -C "$dir/repo" config --get commit.gpgsign 2>/dev/null || true)" == "$(git config --global --get commit.gpgsign 2>/dev/null || true)" ]] \
    || rc=1
  rm -rf "$dir"
  return $rc
}
chk_hook() { [[ -x "$HOOKS_DIR/prepare-commit-msg" ]]; }

chk_shell_hook() {
  local rc
  [[ -f "$SHELL_HOOK" ]] || return 1
  rc=$(shell_rc) || return 1
  grep -qF "$MARK_START" "$rc"
}
chk_binaries() { local b; for b in $HELPERS; do [[ -x "$BIN_DIR/$b" ]] || return 1; done; }

cmd_doctor() {
  local only=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) only="$2"; shift 2 ;;
      *) die "doctor: unknown flag '$1'" ;;
    esac
  done
  [[ -f "$CONFIG_FILE" ]] || die "no config at $CONFIG_FILE -- run 'agent-id setup' first"

  say "doctor:"
  check "dependencies present (gh jq openssl git curl)" \
        "brew install the missing one" chk_deps
  check "helper binaries installed in $BIN_DIR" \
        "re-run 'agent-id setup'" chk_binaries
  check "co-author hook installed and executable" \
        "re-run 'agent-id setup'" chk_hook
  note  "shell hook sourced (lets 'agent-id use' cd this shell)" \
        "re-run 'agent-id setup', or source $(display_path "$SHELL_HOOK") from your shell rc yourself" chk_shell_hook
  check "human identity untouched outside $(basedir)" \
        "something overrode global config -- inspect ~/.gitconfig for stray edits" chk_human_untouched

  local names name
  names=$(list_identities)
  [[ -n "$names" ]] || die "no identities in config -- run 'agent-id setup'"
  if [[ -n "$only" ]]; then names="$only"; fi

  for name in $names; do
    say ""
    if [[ "$(identity_kind "$name")" == "user" ]]; then
      say "identity '$name' (account @$(cfg_get "identity.$name.login")):"
      if [[ "$(key_source "$name")" == "file" ]]; then
        check "token file present, non-empty, mode 600" \
              "re-run setup with --store file --token-file, or chmod 600 $(cfg_get "identity.$name.tokenfile")" chk_tokenfile "$name"
      else
        check "1Password token reachable" \
              "op signin, or re-run setup to recreate $(cfg_get "identity.$name.opitem")" chk_op "$name" token
      fi
      check "stored token looks like a PAT (github_pat_... / ghp_...)" \
            "the stored secret isn't a PAT -- re-run setup with a fresh --token-file" chk_token "$name"
      check "token valid and still @$(cfg_get "identity.$name.login")" \
            "token revoked, expired, or replaced with one for another account -- re-run setup" chk_user_real "$name"
      check "token not expiring within 30 days" \
            "issue a new PAT and re-run 'agent-id setup --kind user --name $name --token-file <path>'" chk_token_fresh "$name"
      check "agent account is not your own account" \
            "this identity holds a token for YOUR account -- issue one from the agent account" chk_not_human "$name"
      check "token reaches at least one repository" \
            "the PAT's resource owner is probably the agent account itself -- the org only appears in the picker if the account is an org MEMBER, not an outside collaborator (docs/troubleshooting.md)" chk_reaches_repo "$name"
      check "account email well-formed" \
            "re-run setup; email must be <userId>+<login>@users.noreply.github.com" chk_email_format "$name"
    else
      say "identity '$name' ($(cfg_get "identity.$name.slug") on $(cfg_get "identity.$name.owner")):"
      if [[ "$(key_source "$name")" == "file" ]]; then
        check "key file present, valid, mode 600" \
              "re-run setup with --store file --pem, or chmod 600 $(cfg_get "identity.$name.keyfile")" chk_keyfile "$name"
      else
        check "1Password key reachable" \
              "op signin, or re-run setup to recreate $(cfg_get "identity.$name.opitem")" chk_op "$name" private_key
      fi
      check "token mints (ghs_...)" \
            "wrong app id / installation id / PEM -- re-run setup with a fresh --pem" chk_token "$name"
      check "token cache returns identical token" \
            "cache dir $CACHE_DIR unwritable, or expiry math broken" chk_cache "$name"
      check "bot email well-formed" \
            "re-run setup; email must be <botUserId>+<slug>[bot]@users.noreply.github.com" chk_email_format "$name"
      check "bot user id matches GitHub" \
            "slug or bot user id stale -- re-run setup to rediscover" chk_bot_real "$name"
      check "app id != bot user id (the classic mixup)" \
            "config has the app id in the email -- re-run setup" chk_ids_differ "$name"
      check "installation reaches at least one repository" \
            "the app is installed on no repos -- open its installation settings and pick some under 'Only select repositories'" chk_reaches_repo "$name"
    fi
    check "includeIf resolves identity inside $(basedir)/$name/" \
          "check the include block in ~/.gitconfig and $OWNED_GITCONFIG" chk_includeif "$name"
    if signing_enabled "$name"; then
      check "signing key present, mode 600" \
            "regenerate it with 'agent-id setup --sign --name $name'" chk_signing_key "$name"
      check "signing key registered on @$(cfg_get "identity.$name.login")" \
            "as the agent account, add $(signing_key "$name").pub at github.com/settings/ssh/new with Key type: Signing Key" \
            chk_signing_registered "$name"
      check "commits sign and verify in agent scope" \
            "rendered conf should set gpg.format=ssh and user.signingkey -- re-run 'agent-id setup --sign'" chk_signs "$name"
    else
      check "commit signing off in agent scope" \
            "rendered conf should set commit.gpgsign=false -- re-run setup" chk_gpgsign "$name"
    fi
    check "credential helper wins (x-access-token)" \
          "inherited osxkeychain not cleared -- rendered conf needs the empty 'helper =' line" chk_credential "$name"
  done

  say ""
  if [[ $DOCTOR_FAILURES -gt 0 ]]; then
    say "doctor: $DOCTOR_FAILURES check(s) failed"
    exit 1
  fi
  say "doctor: all checks passed"
}

# ---------------------------------------------------------------------------
# uninstall
# ---------------------------------------------------------------------------

cmd_uninstall() {
  local yes="" b base name signed=""
  base=$(basedir)
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -y|--yes) yes=1; shift ;;
      *) die "uninstall: unknown flag '$1'" ;;
    esac
  done
  if [[ -z "$yes" && -t 0 ]]; then
    read -r -p "Remove agent-id wiring (gitconfig include, binaries, config, token cache)? [y/N] " reply
    case "$reply" in y|Y|yes) ;; *) say "aborted"; exit 0 ;; esac
  fi

  # Read while the config still exists: the public half of a signing key stays
  # on the agent account, and only that account's owner can take it down.
  for name in $(list_identities); do
    if signing_enabled "$name"; then signed=1; fi
  done

  remove_include_block
  say "removed agent-id block from ~/.gitconfig"
  remove_shell_hook
  say "removed agent-id block from your shell rc"

  for b in $HELPERS agent-id; do
    rm -f "$BIN_DIR/$b"
  done
  say "removed binaries from $BIN_DIR"

  # Key files are credentials, same policy as 1Password items: left alone.
  rmdir "$KEYS_DIR" 2>/dev/null || true
  rm -f "$CONFIG_FILE" "$OWNED_GITCONFIG"
  rm -rf "$RENDER_DIR"
  if [[ -d "$KEYS_DIR" ]]; then
    say "removed config and git wiring from $CONFIG_DIR"
  else
    rm -rf "$CONFIG_DIR"
    say "removed $CONFIG_DIR (config, rendered git confs, hooks)"
  fi

  rm -rf "$CACHE_DIR"
  say "removed token cache $CACHE_DIR"

  say ""
  say "left alone (remove yourself if you want them gone):"
  say "  - the 1Password item(s) holding the agent credentials"
  [[ -d "$KEYS_DIR" ]] && say "  - private keys / tokens / signing keys in $KEYS_DIR"
  [[ -z "$signed" ]] \
    || say "  - the public signing key on the agent account (SSH and GPG keys page)"
  say "  - $base and any clones in it"
  say "your own git identity was never modified and is unchanged"
}

# ---------------------------------------------------------------------------
# clone
# ---------------------------------------------------------------------------

cmd_clone() {
  local repo="" name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      -*) die "clone: unknown flag '$1'" ;;
      *) repo="$1"; shift ;;
    esac
  done
  [[ -n "$repo" ]] || die "usage: agent-id clone <owner/repo | https url> [--name identity]"
  [[ -f "$CONFIG_FILE" ]] || die "run 'agent-id setup' first"

  if [[ -z "$name" ]]; then
    name=$(identity_from_cwd) || name=""
  fi
  if [[ -z "$name" ]]; then
    name=$(default_identity)
    if ! identity_exists "$name"; then
      local count
      count=$(list_identities | wc -l | tr -d ' ')
      [[ "$count" == "1" ]] \
        || die "no default identity set -- pass --name, or set one with 'agent-id default <name>'"
      name=$(list_identities)
    fi
  fi
  identity_exists "$name" || die "identity '$name' not in config"

  local url
  case "$repo" in
    https://*) url="$repo" ;;
    git@github.com:*)
      url="https://github.com/${repo#git@github.com:}"
      warn "rewrote ssh URL to https -- ssh would push as YOU, not the bot"
      ;;
    */*) url="https://github.com/$repo.git" ;;
    *) die "can't parse repo '$repo' -- use owner/repo or an https URL" ;;
  esac

  local dest
  dest="$(basedir)/$name/$(basename "$url" .git)"
  [[ -e "$dest" ]] && die "$dest already exists"
  say "cloning into $dest (identity '$name' applies here)"
  git clone "$url" "$dest"
  say "done -- work in $dest; use 'agent-gh' instead of 'gh' for PRs"
}

# ---------------------------------------------------------------------------
# update -- reinstall what this script embeds, and nothing else
# ---------------------------------------------------------------------------

# Everything rewritten here comes from heredocs in this file plus the existing
# config, so update reads no credential and calls no API. That is the point:
# picking up a new version must work with the 1Password vault locked and the
# network down. `setup` remains the repair action for anything that needs the
# credential or fresh GitHub metadata.
cmd_update() {
  [[ $# -eq 0 ]] || die "update takes no arguments"
  [[ -f "$CONFIG_FILE" ]] || die "no config at $CONFIG_FILE -- run 'agent-id setup' first"
  local names name count=0
  names=$(list_identities)
  [[ -n "$names" ]] || die "no identities in config -- run 'agent-id setup'"

  install_binaries
  install_hook
  install_shell_hook
  say "reinstalled $HELPERS, the commit hook, and the shell hook"

  # Every identity, not just the default: a bare `setup` re-renders only the one
  # it ran for, which leaves the others on an old template.
  for name in $names; do
    render_identity_conf "$name"
    count=$((count + 1))
  done
  regen_owned_gitconfig
  ensure_include_block
  say "re-rendered $count identity conf(s) in $RENDER_DIR"
  say ""
  say "config and stored secrets untouched -- run 'agent-id doctor' to verify the chain"
}

# ---------------------------------------------------------------------------
# token
# ---------------------------------------------------------------------------

cmd_token() {
  [[ -x "$BIN_DIR/agent-id-token" ]] || die "helpers not installed -- run 'agent-id setup' first"
  # Empty is fine: the helper resolves the configured default.
  exec "$BIN_DIR/agent-id-token" "${1:-}"
}

# ---------------------------------------------------------------------------
# default / rename
# ---------------------------------------------------------------------------

cmd_default() {
  [[ -f "$CONFIG_FILE" ]] || die "no config at $CONFIG_FILE -- run 'agent-id setup' first"
  if [[ $# -eq 0 ]]; then
    say "$(default_identity)"
    return 0
  fi
  identity_exists "$1" || die "identity '$1' not in config (have: $(list_identities | tr '\n' ' '))"
  cfg_set core.defaultidentity "$1"
  say "default identity is now '$1'"
}

# ---------------------------------------------------------------------------
# use -- drop into a shell in an identity's directory
# ---------------------------------------------------------------------------

# A child process cannot cd its parent, so this replaces itself with a shell
# already sitting in the directory. Leave it the way you leave any shell: exit.
# Wrap a path so the shell hook's eval sees one word whatever is in it.
shell_quote() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

cmd_use() {
  local name="" emit="" dir
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --emit-shell) emit=1; shift ;;
      -*) die "use: unknown flag '$1'" ;;
      *)
        [[ -z "$name" ]] || die "use: too many arguments"
        name="$1"; shift ;;
    esac
  done
  [[ -f "$CONFIG_FILE" ]] || die "no config at $CONFIG_FILE -- run 'agent-id setup' first"

  if [[ -z "$name" ]]; then
    name=$(pick_identity)
    [[ -n "$name" ]] || die "no identity selected"
  fi
  identity_exists "$name" \
    || die "identity '$name' not in config (have: $(list_identities | tr '\n' ' '))"

  dir="$(basedir)/$name"
  mkdir -p "$dir"

  # The identity follows the directory -- git through includeIf, gh through
  # agent-gh reading $PWD -- so landing there is the whole job. Nothing is
  # exported, which is what keeps a later cd out of the tree from carrying a
  # stale identity with it.
  if [[ -n "$emit" ]]; then
    printf 'cd %s\n' "$(shell_quote "$dir")"
    return 0
  fi

  cd "$dir"
  say "identity '$name' -- $(display_path "$dir"); exit to come back"
  exec "${SHELL:-/bin/sh}"
}

# ---------------------------------------------------------------------------

# Renames an identity and everything named after it: its config section, its
# key file, its rendered git conf, and its directory under the base dir.
cmd_rename() {
  local old="" new="" base src dst
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -*) die "rename: unknown flag '$1'" ;;
      *)
        if   [[ -z "$old" ]]; then old="$1"
        elif [[ -z "$new" ]]; then new="$1"
        else die "rename: too many arguments"; fi
        shift ;;
    esac
  done
  [[ -n "$old" && -n "$new" ]] || die "usage: agent-id rename <old> <new>"
  [[ -f "$CONFIG_FILE" ]] || die "no config at $CONFIG_FILE -- run 'agent-id setup' first"

  local name_re='^[A-Za-z0-9_-]+$'
  [[ "$new" =~ $name_re ]] || die "identity name must match [A-Za-z0-9_-]+: '$new'"
  identity_exists "$old" || die "identity '$old' not in config"
  identity_exists "$new" && die "identity '$new' already exists"

  base=$(basedir); src="$base/$old"; dst="$base/$new"
  [[ ! -e "$dst" ]] || die "$dst already exists -- move it aside first"

  git config -f "$CONFIG_FILE" --rename-section "identity.$old" "identity.$new"

  # Key material is named after the identity too; keep the two in step.
  local key f
  for key in keyfile tokenfile; do
    f=$(cfg_get "identity.$new.$key") || continue
    if [[ -f "$f" ]]; then
      mv "$f" "${f%/*}/$new.${f##*.}"
      cfg_set "identity.$new.$key" "${f%/*}/$new.${f##*.}"
    fi
  done

  # The signing key is a pair, and ${f##*.} above would turn <old>.signing.pub
  # into <new>.pub, so it moves separately.
  if signing_enabled "$new"; then
    f=$(signing_key "$new")
    if [[ -f "$f" ]]; then
      mv "$f" "$KEYS_DIR/$new.signing"
      [[ ! -f "$f.pub" ]] || mv "$f.pub" "$KEYS_DIR/$new.signing.pub"
      cfg_set "identity.$new.signingkey" "$KEYS_DIR/$new.signing"
    fi
  fi

  if [[ -d "$src" ]]; then
    mv "$src" "$dst"
    say "moved $src -> $dst (reopen anything you had open in there)"
  else
    mkdir -p "$dst"
  fi

  rm -f "$RENDER_DIR/$old.conf" "$CACHE_DIR/$old.token.json" "$(allowed_signers "$old")"
  render_identity_conf "$new"
  regen_owned_gitconfig
  ensure_include_block

  if [[ "$(default_identity)" == "$old" ]]; then
    cfg_set core.defaultidentity "$new"
    say "default identity is now '$new'"
  fi
  say "renamed identity '$old' to '$new'"
}

# ---------------------------------------------------------------------------

usage() {
  cat <<EOF
agent-id -- a dedicated GitHub identity for coding harnesses

usage: agent-id <command> [flags]

  setup      provision an identity (idempotent; safe to re-run)
             GitHub App bot (default):
               --owner <account> --app-id <id> [--pem <path>]
               --pem is only needed the first time per app; later identities
               of the same app reuse the stored key
             Separate GitHub account:
               --kind user [--login <account>] [--token-file <path>]
               the token file is shredded after storing; with neither flag
               setup reuses a stored token or prompts (never via argv)
               [--sign | --no-sign]  SSH-sign this identity's commits with a
                                     key of its own (app identities can't)
             common:
               [--name <identity>]  default: the app slug / account login
               [--default]          make this the default identity
               [--store <op|file>]  op: secret in 1Password (default for a
                                        new identity)
                                    file: secret on disk, no 1Password
                                          (unattended use)
                                    re-running setup keeps the store the
                                    identity already uses
               [--vault <1password vault>] [--op-account <1password account>]
               [--coauthor "Name <email>"] [--base-dir <dir>]
  doctor     verify the whole chain; non-zero exit on any failure
             [--name <identity>]
  uninstall  remove all wiring; leaves keys + clones alone  [-y]
  clone      clone a repo into the agent directory so the identity applies
             <owner/repo | url> [--name <identity>]
             without --name: the identity owning the current directory,
             otherwise the default
  use        go to an identity's directory  [<name>]
             with no name, pick one from a list; cds the current shell once
             the shell hook is loaded, otherwise opens a subshell
  update     reinstall the helpers, hook, and rendered confs from this copy
             of the script; no credential read, no network, config untouched
  token      print the identity's token  [identity]
  default    show the identity used when none is named, or set it  [<name>]
  rename     rename an identity, its directory, and its key files
             <old> <new>
EOF
}

case "${1:-}" in
  setup)     shift; cmd_setup "$@" ;;
  doctor)    shift; cmd_doctor "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  clone)     shift; cmd_clone "$@" ;;
  use)       shift; cmd_use "$@" ;;
  update)    shift; cmd_update "$@" ;;
  token)     shift; cmd_token "$@" ;;
  default)   shift; cmd_default "$@" ;;
  rename)    shift; cmd_rename "$@" ;;
  help|--help|-h|"") usage ;;
  *) usage >&2; die "unknown command '${1}'" ;;
esac
