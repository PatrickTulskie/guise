#!/usr/bin/env bash
# Fake GitHub API. Matches on the URL, logs every call to $CURL_LOG. An
# endpoint that needs auth takes its Authorization header only through
# --config (a file, or - for stdin); one anywhere in argv is the leak this
# stub is here to catch, whatever the URL.
set -euo pipefail

url="" hdr="" config="" prev=""
for a in "$@"; do
  case "$a" in *Authorization:*) echo "curl stub: an Authorization header in argv" >&2; exit 99 ;; esac
  case "$prev" in -D) hdr="$a" ;; --config) config="$a" ;; esac
  case "$a" in https://*) url="$a" ;; esac
  prev="$a"
done
[[ -n "${CURL_LOG:-}" ]] && echo "$url" >> "$CURL_LOG"

need_auth() {
  if [[ "$config" == "-" ]]; then cat; elif [[ -n "$config" ]]; then cat "$config"; fi \
    | grep -q '^header = "Authorization: Bearer ' \
    || { echo "curl stub: $url needs its Authorization header through --config" >&2; exit 22; }
}

case "$url" in
  */app/installations/*/access_tokens)
    need_auth
    printf '{"token":"ghs_stubtoken%s","expires_at":"2099-01-01T00:00:00Z"}' "$$"
    ;;
  */app/installations*)
    need_auth
    printf '[{"id":%s,"account":{"login":"%s"}}]' "${FAKE_INSTALL_ID:?}" "${FAKE_OWNER:?}"
    ;;
  */app)
    need_auth
    printf '{"id":%s,"slug":"%s"}' "${FAKE_APP_ID:?}" "${FAKE_SLUG:?}"
    ;;
  */user/repos*)
    need_auth
    # FAKE_SSO names a SAML org the token isn't authorized for: "partial" drops
    # its repos from the list and says so in a header, "required" is the 403 a
    # resource inside that org answers with.
    status=200 sso=""
    case "${FAKE_SSO:-}" in
      partial)  sso='partial-results; organizations=21955855' ;;
      required) sso='required; url=https://github.com/orgs/octo/sso?authorization_request=stub' status=403 ;;
    esac
    if [[ -n "$hdr" ]]; then
      printf 'HTTP/2 %s\r\n' "$status" > "$hdr"
      [[ -z "$sso" ]] || printf 'x-github-sso: %s\r\n' "$sso" >> "$hdr"
      printf '\r\n' >> "$hdr"
    fi
    if [[ "$status" == 403 ]]; then
      printf '{"message":"Resource protected by organization SAML enforcement."}'
      exit 22
    fi
    if [[ "${FAKE_REPO_COUNT:-1}" == "0" ]]; then printf '[]'; else printf '[{"id":9001}]'; fi
    ;;
  */installation/repositories*)
    need_auth
    printf '{"total_count":%s,"repositories":[]}' "${FAKE_REPO_COUNT:-1}"
    ;;
  */user)
    need_auth
    if [[ -n "$hdr" ]]; then
      printf 'HTTP/2 200\r\ngithub-authentication-token-expiration: %s\r\n\r\n' \
        "${FAKE_TOKEN_EXPIRES:-2099-01-01 00:00:00 UTC}" > "$hdr"
    fi
    printf '{"id":%s,"login":"%s"}' "${FAKE_USER_ID:?}" "${FAKE_LOGIN:?}"
    ;;
  */users/*/ssh_signing_keys)
    # The account's signing keys page, as anyone can read it. Tests append to
    # $SIGNING_KEYS_FILE to stand in for a human pasting a key into the form.
    if [[ -s "${SIGNING_KEYS_FILE:-/dev/null}" ]]; then
      jq -R -s 'split("\n") | map(select(length > 0)) | to_entries
                | map({id: .key, key: .value})' "$SIGNING_KEYS_FILE"
    else
      printf '[]'
    fi
    ;;
  */users/*)
    printf '{"id":%s}' "${FAKE_BOT_ID:?}"
    ;;
  *)
    echo "curl stub: unmatched url: $url" >&2
    exit 22
    ;;
esac
